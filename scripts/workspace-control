#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "${repo_root}/.venv/bin/python" ]]; then
  exec "${repo_root}/.venv/bin/python" -B "${repo_root}/scripts/workspace_control.py" "$@"
fi
exec python3 -B "${repo_root}/scripts/workspace_control.py" "$@"
