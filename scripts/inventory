#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="${repo_root}/.venv/bin/ansible-inventory"

if [[ ! -x "${binary}" ]]; then
  printf 'Missing %s. Run ./scripts/bootstrap-control-node first.\n' "${binary}" >&2
  exit 1
fi

cd "${repo_root}"
export ANSIBLE_HOME="${repo_root}/.ansible"
repository_only=0
if (( $# == 1 )) && [[ "$1" == "--repository-only" ]]; then
  repository_only=1
elif (( $# > 0 )); then
  printf 'Usage: ./scripts/inventory [--repository-only]\n' >&2
  exit 2
fi
if (( repository_only )); then
  "${repo_root}/.venv/bin/python" -B scripts/check_local_operations.py --inventory-structure-only
else
  "${repo_root}/.venv/bin/python" -B scripts/check_local_operations.py --inventory-only
fi
exec "${binary}" --graph
