#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
template_dir="${repo_root}/models/_template"

if [[ $# -ne 1 ]]; then
  printf 'Usage: %s <model-name>\n' "$0" >&2
  exit 2
fi

model_name="$1"
if [[ ! "${model_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  printf 'Model name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
  exit 2
fi

target_dir="${repo_root}/models/${model_name}"
if [[ -e "${target_dir}" ]]; then
  printf 'Refusing to overwrite existing model directory: %s\n' "${target_dir}" >&2
  exit 1
fi

cp -R "${template_dir}" "${target_dir}"
printf 'Created model workspace: %s\n' "${target_dir}"
printf 'Next: fill model.yml, then prepare a selected workflow stage with:\n'
printf '  ./scripts/adapt-model %s --steps architecture\n' "${model_name}"
printf '  ./scripts/new-framework %s <platform> <framework-id>\n' "${model_name}"
