#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -x "${repo_root}/.venv/bin/python" ]]; then
  python_bin="${repo_root}/.venv/bin/python"
else
  python_bin="$(command -v python3)"
fi

cd "${repo_root}"
"${repo_root}/scripts/inventory" >/dev/null

"${python_bin}" -B -m unittest discover -s test/workflow_test -p 'test_*.py'
"${python_bin}" -B -m unittest discover -s test/operations_test -p 'test_*.py'

"${python_bin}" -B scripts/check_local_operations.py

"${repo_root}/scripts/audit-workspace"

printf 'Inventory, workflow/acceptance tests, playbooks and structural audit passed; review audit warnings separately.\n'
