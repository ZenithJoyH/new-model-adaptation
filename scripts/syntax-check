#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "${repo_root}"
"${repo_root}/scripts/inventory" >/dev/null

for playbook in playbooks/*.yml; do
  "${repo_root}/scripts/playbook" "${playbook}" --syntax-check
done

printf 'Inventory and playbook syntax checks passed.\n'
