#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ansible_args=()
while (( $# > 0 )); do
  case "$1" in
    --limit|-l)
      if (( $# < 2 )); then
        printf '%s requires a host or group pattern.\n' "$1" >&2
        exit 2
      fi
      limit_value="$2"
      shift 2
      ;;
    --limit=*)
      limit_value="${1#--limit=}"
      shift
      ;;
    *)
      printf 'Unsupported argument for read-only health check: %s\n' "$1" >&2
      exit 2
      ;;
  esac

  if [[ -z "${limit_value}" || "${limit_value}" == -* \
    || "${limit_value}" == @* || "${limit_value}" == */* \
    || "${limit_value}" =~ [[:space:]] ]]; then
    printf 'Invalid --limit value: %s\n' "${limit_value}" >&2
    exit 2
  fi
  if (( ${#ansible_args[@]} > 0 )); then
    printf 'Specify --limit at most once.\n' >&2
    exit 2
  fi
  ansible_args+=(--limit "${limit_value}")
done

exec "${repo_root}/scripts/playbook" playbooks/health-check.yml "${ansible_args[@]}"
