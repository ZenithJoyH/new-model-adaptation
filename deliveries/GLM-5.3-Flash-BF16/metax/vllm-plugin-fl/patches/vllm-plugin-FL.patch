+@pytest.mark.parametrize("kind", ["prefill", "decode"])
+@torch.no_grad()
+def test_glm_pool_topk_canonical_repeated_graph(kind):
+    rows, columns, count = 8, 864, 512
+    values = torch.full(
+        (rows, columns), -200.0, dtype=torch.float32, device="cpu"
+    )
+    ties = [50, 100, 200, 300, 400, 500, 700, 800]
+    high = [i for i in range(columns) if i not in ties][: count - 2]
+    values[:, high] = -140
+    values[:, ties] = -141.28079223632812
+    starts_cpu = (
+        torch.tensor([0, 5, 0, 0, 0, 1, 7, 0], dtype=torch.int32)
+        if kind == "prefill"
+        else torch.zeros(rows, dtype=torch.int32)
+    )
+    ends_cpu = torch.tensor(
+        [864, 863, 100, 0, 864, 862, 800, 864], dtype=torch.int32
+    )
+    logits, starts, ends = values.cuda(), starts_cpu.cuda(), ends_cpu.cuda()
+    output = torch.empty((rows, count), dtype=torch.int32, device="cuda")
+    operation = CachedOp("top_k_per_row_" + kind)
+
+    def run():
+        if kind == "prefill":
+            operation(logits, starts, ends, output, canonical_output=True)
+        else:
+            operation(
+                logits,
+                ends.view(rows, 1),
+                output,
+                next_n=1,
+                canonical_output=True,
+            )
+
+    def check(cpu):
+        expected = torch.full((rows, count), -1, dtype=torch.int32)
+        for row in range(rows):
+            begin, end = int(starts_cpu[row]), int(ends_cpu[row])
+            order = torch.argsort(
+                cpu[row, begin:end], descending=True, stable=True
+            )
+            keep = min(count, end - begin)
+            expected[row, :keep] = order[:keep].to(torch.int32)
+        torch.testing.assert_close(
+            output.cpu().sort(-1).values,
+            expected.sort(-1).values,
+            rtol=0,
+            atol=0,
+        )
+
+    first = None
+    for _ in range(8):
+        run()
+        check(values)
+        host = output.cpu()
+        if first is None:
+            first = host
+        else:
+            torch.testing.assert_close(host, first, rtol=0, atol=0)
+    for _ in range(3):
+        run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        run()
+    for changed in (values.flip(-1), -values):
+        logits.copy_(changed)
+        graph.replay()
+        torch.cuda.synchronize()
+        check(changed)
