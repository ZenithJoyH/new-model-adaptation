+# SPDX-License-Identifier: Apache-2.0
+"""GLM cache protocol adapters using installed public FlagGems-vllm ops."""
+
+from functools import partial
+
+import torch
+
+from vllm_fl.dispatch.capabilities import get_flaggems_vllm_operator
+
+# No numerical kernels or Torch reference computations belong in this adapter.
+_DIRECT = {
+    name: name
+    for name in (
+        "causal_conv1d_fn",
+        "causal_conv1d_update",
+        "fused_recurrent_kda",
+        "chunk_kda_with_safe_gate",
+        "fused_safe_kda_gate",
+        "mhc_pre_with_norm",
+        "mhc_post",
+        "mhc_fused_post_pre_with_norm",
+        "concat_and_cache_mla",
+        "concat_mla_q",
+        "flash_mla_sparse_fwd",
+        "flash_attn_varlen_func",
+    )
+}
+_DIRECT.update(
+    {
+        "fused_safe_kda_gate": "safe_kda_gate",
+        "sparse_indexer_rotate_indexer_query": "hadamard128",
+        "sparse_indexer_mqa_logits": "fp8_fp4_mqa_logits",
+        "sparse_indexer_paged_mqa_logits": "paged_mqa_logits",
+        "sparse_indexer_indexer_k_quant_and_cache": "indexer_k_quant_and_cache",
+        "sparse_indexer_pack_seq": "pack_seq_triton",
+        "sparse_indexer_unpack_seq": "unpack_seq_triton",
+        "sparse_indexer_kpool_compress_and_write_cache": "kpool_compress_and_write_cache",
+        "sparse_indexer_kpool_decode_update_and_maybe_write_cache_batched": "kpool_decode_update_and_maybe_write_cache_batched",
+        "sparse_indexer_expand_pools_and_append_tail": "expand_pools_and_append_tail",
+    }
+)
+
+
+def pad_heads(q, heads):
+    import flag_gems
+
+    return flag_gems.constant_pad_nd(q, [0, 0, 0, heads - q.shape[1]], 0)
+
+
+def capabilities():
+    return {
+        "compressed_page_size": 32,
+        "cache_dtype": torch.uint8,
+        "query_dtype": torch.float8_e4m3fn,
+    }
+
+
+def prepare_query(
+    q, group_size, *, output_dtype, column_major_scales=False, use_ue8m0=False
+):
+    return get_flaggems_vllm_operator("per_token_group_quant_fp8")(
+        q,
+        group_size,
+        dtype=output_dtype,
+        column_major_scales=column_major_scales,
+        scale_ue8m0=use_ue8m0,
+    )
+
+
+def persist_prefill_tail(key, gate_score, slots, tail_cache, *, pool_size):
+    return get_flaggems_vllm_operator("kpool_seed_tail_cache")(
+        tail_cache,
+        key,
+        gate_score,
+        slots,
+        pool_size,
+    )
+
+
+def topk_prefill(logits, row_starts, row_ends, indices, *, canonical_output=False):
+    if logits.stride(1) != 1:
+        raise ValueError("GLM prefill topk requires unit column stride")
+    return get_flaggems_vllm_operator("top_k_per_row_prefill")(
+        logits,
+        row_starts,
+        row_ends,
+        indices,
+        logits.shape[0],
+        logits.stride(0),
+        logits.stride(1),
+        indices.shape[1],
+        canonical_output=canonical_output,
+    )
+
+
+def topk_decode(logits, seq_lens, indices, *, next_n, canonical_output=False):
+    return get_flaggems_vllm_operator("top_k_per_row_decode")(
+        logits,
+        next_n,
+        seq_lens,
+        indices,
+        logits.shape[0],
+        logits.stride(0),
+        logits.stride(1),
+        indices.shape[1],
+        canonical_output=canonical_output,
+    )
+
+
+def gather_cache(k_cache, k_values, k_scales, block_table, cu_seq_lens):
+    # The public gather ABI measures the scale row width in bytes, then writes
+    # FP32 through the same storage. The model workspace exposes FP32 [N, 1].
+    return get_flaggems_vllm_operator("cp_gather_indexer_k_quant_cache")(
+        k_cache, k_values, k_scales.view(torch.uint8), block_table, cu_seq_lens
+    )
+
+
+def validate_environment():
+    missing = [
+        name
+        for name in set(_DIRECT.values())
+        | {
+            "per_token_group_quant_fp8",
+            "kpool_seed_tail_cache",
+            "cp_gather_indexer_k_quant_cache",
+            "top_k_per_row_prefill",
+            "top_k_per_row_decode",
+        }
+        if not callable(get_flaggems_vllm_operator(name))
+    ]
+    if missing:
+        raise RuntimeError(f"GLM-5.3 requires installed FlagGems-vllm ops: {missing}")
+
+
+_ADAPTERS = {
+    "sparse_indexer_gather_cache": gather_cache,
+    "top_k_per_row_prefill": topk_prefill,
+    "top_k_per_row_decode": topk_decode,
+    "glm5next_pad_heads": pad_heads,
+    "sparse_indexer_capabilities": capabilities,
+    "sparse_indexer_prepare_query": prepare_query,
+    "sparse_indexer_persist_prefill_tail": persist_prefill_tail,
+    "sparse_indexer_validate_environment": validate_environment,
+}
+
+
+def _implementation(name):
+    return _ADAPTERS.get(name) or get_flaggems_vllm_operator(_DIRECT[name])
+
+
+def _available(name):
+    import vllm_fl.envs as envs
+    from vllm.platforms import current_platform
+
+    if (
+        getattr(current_platform, "vendor_name", None) != "metax"
+        or not envs.VLLM_FL_USE_FLAGGEMS_VLLM
+    ):
+        return False
+    fn = _implementation(name)
+    check = getattr(fn, "_is_available", None)
+    return callable(fn) and (check is None or check())
+
+
+def register_glm5next_operators(registry, *, allow):
+    from vllm_fl.dispatch.types import BackendImplKind, BackendPriority, OpImpl
+
+    def bind(name):
+        def call(*args, **kwargs):
+            return _implementation(name)(*args, **kwargs)
+
+        call.__name__ = name
+        call._is_available = partial(_available, name)
+        return call
+
+    registry.register_many(
+        [
+            OpImpl(
+                name,
+                "default.flagos.glm5next",
+                BackendImplKind.DEFAULT,
+                bind(name),
+                priority=BackendPriority.DEFAULT,
+            )
+            for name in (*_DIRECT, *_ADAPTERS)
+            if allow(name)
+        ]
+    )
