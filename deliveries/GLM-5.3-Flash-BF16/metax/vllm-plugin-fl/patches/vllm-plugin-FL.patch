+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("column_major", [False, True])
+@pytest.mark.parametrize("ue8m0", [False, True])
+@torch.no_grad()
+def test_indexer_query_quantization_compile_and_changed_replay(
+    dtype, column_major, ue8m0
+):
+    def operation(x):
+        return model.INDEXER_OPS.prepare_query(
+            x,
+            128,
+            output_dtype=torch.float8_e4m3fn,
+            column_major_scales=column_major,
+            use_ue8m0=ue8m0,
+        )
+
+    compiled = torch.compile(
+        operation, backend="inductor", fullgraph=True, dynamic=True
+    )
+
+    def compare(result, x):
+        raw = model._prepare_indexer_dispatch(
+            x,
+            128,
+            output_dtype=torch.float8_e4m3fn,
+            column_major_scales=column_major,
+            use_ue8m0=ue8m0,
+        )
+        quantized, scales = result
+        assert quantized.shape == x.shape and scales.shape == (x.shape[0], 1)
+        assert (
+            quantized.dtype == torch.float8_e4m3fn
+            and scales.dtype == torch.float32
+        )
+        assert quantized.device == scales.device == x.device
+        assert (
+            quantized.stride() == raw[0].stride()
+            and scales.stride() == raw[1].stride()
+        )
+        torch.testing.assert_close(
+            quantized.view(torch.uint8),
+            raw[0].view(torch.uint8),
+            rtol=0,
+            atol=0,
+        )
+        torch.testing.assert_close(scales, raw[1], rtol=0, atol=0)
+        host = x.cpu().float()
+        expected_scale = (
+            host.abs().amax(-1, keepdim=True).clamp_min(1e-10) / 448
+        )
+        if ue8m0:
+            expected_scale = (
+                expected_scale.abs().clamp_min(1e-10).log2().ceil().exp2()
+            )
+        torch.testing.assert_close(
+            scales.cpu(), expected_scale, rtol=1e-6, atol=1e-12
+        )
+        restored = quantized.cpu().float() * scales.cpu()
+        # E4M3 round-to-nearest has at most 1/16 relative error plus subnormal error.
+        torch.testing.assert_close(restored, host, rtol=0.0625, atol=0.001)
+
+    for tokens in (1, 3):
+        x = _indexer_input((tokens * 32, 128), dtype, tokens + 97).cuda()
+        compare(operation(x), x)
+        compare(compiled(x), x)
+    kwargs = dict(
+        output_dtype=torch.float8_e4m3fn,
+        column_major_scales=column_major,
+        use_ue8m0=ue8m0,
+    )
+    torch.library.opcheck(
+        torch.ops.vllm.glm5next_prepare_indexer_query.default,
+        (x, 128),
+        kwargs,
+        test_utils=("test_schema", "test_faketensor"),
+    )
+    compiled(x)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = compiled(x)
+    for seed in (109, 127):
+        x.copy_(_indexer_input(tuple(x.shape), dtype, seed))
+        graph.replay()
+        torch.cuda.synchronize()
+        compare(output, x)
