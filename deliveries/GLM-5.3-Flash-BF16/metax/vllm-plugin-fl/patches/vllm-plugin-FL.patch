+    hidden, key = torch.empty((count, 1), device="cuda"), torch.empty(
+        (count, 128), device="cuda"
+    )
+    output = torch.empty((count, 2051), dtype=torch.int32, device="cuda")
+    assert not workspace.is_workspace_manager_initialized()
+    workspace.init_workspace_manager(torch.device("cuda"))
+
+    def run():
+        with override_forward_context(context):
+            sparse_attn_indexer_kpool(
+                hidden,
+                "index",
+                cache,
+                query,
+                None,
+                key,
+                weights,
+                128,
+                None,
+                2048,
+                128,
+                end_positions[-1] + 2,
+                total_pools,
+                output,
+                True,
+                index_kpool=4,
+                positions=positions,
+            )
+
+    def check(current_query):
+        actual = output.cpu()
+        for row, position in enumerate(positions_cpu.tolist()):
+            request = row // tokens_per_request
+            length = (position + 1) // 4
+            keys = keys_cpu.float()[table_cpu[request].long()].reshape(-1, 128)[:length]
+            scale = scales_cpu[table_cpu[request].long()].reshape(-1)[:length]
+            scores = (
+                (current_query[row].float() @ keys.t() * scale).relu()
+                * weights_cpu[row, :, None]
+            ).sum(0)
+            selected = scores.topk(512).indices.int()
+            pools = (
+                selected[:, None] * 4 + torch.arange(4, dtype=torch.int32)
+            ).reshape(-1)
+            tail = torch.arange(length * 4, position + 1, dtype=torch.int32)
+            expected = torch.full((2051,), -1, dtype=torch.int32)
+            expected[:2048] = pools
+            expected[2048 : 2048 + len(tail)] = tail
+            torch.testing.assert_close(
+                actual[row].sort().values, expected.sort().values, rtol=0, atol=0
+            )
+
+    try:
+        run()
+        check(query_cpu)
+        workspace.lock_workspace()
+        for factor in (0.5, -1.0):
+            changed = (query_cpu.float() * factor).to(query_cpu.dtype)
+            query.copy_(changed)
+            run()
+            check(changed)
+    finally:
+        workspace.reset_workspace_manager()
+
