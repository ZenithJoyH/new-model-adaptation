+def test_glm_prefix_lookup_ignores_storage_only_tail():
+    import hashlib
+    from types import SimpleNamespace
+    from vllm.v1.core.kv_cache_manager import KVCacheManager
+
+    _, cache = _scheduler_cache_fixture()
+    manager = KVCacheManager(
+        cache,
+        max_model_len=3072,
+        scheduler_block_size=384,
+        hash_block_size=4,
+        max_num_batched_tokens=768,
+        enable_caching=True,
+    )
+    coordinator = manager.coordinator
+    hashes = [hashlib.sha256(str(i).encode()).digest() for i in range(192)]
+    request = SimpleNamespace(block_hashes=hashes)
+    seeded = {}
+    for gid in (0, 2):
+        blocks = coordinator.block_pool.get_new_blocks(2)
+        coordinator.block_pool.cache_full_blocks(request, blocks, 0, 2, 384, gid)
+        seeded[gid] = blocks
+    for _ in range(2):
+        found, hit = coordinator.find_longest_cache_hit(hashes, 768)
+        assert hit == 768
+        assert found[0] == seeded[0]
+        assert found[1] == []
+        assert found[2][-1] == seeded[2][-1]
+    changed = [hashlib.sha256(b"changed" + h).digest() for h in hashes]
+    _, hit = coordinator.find_longest_cache_hit(changed, 768)
+    assert hit == 0
+    tail = coordinator.single_type_managers[1]
+    assert len(tail.allocate_new_blocks("new-request", 768, 768)) == 1
+    assert tail.req_to_blocks["new-request"][0].block_hash is None
