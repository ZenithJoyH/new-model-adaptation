+# SPDX-License-Identifier: Apache-2.0
+"""Preserve the complete mHC residual across pipeline partitions."""
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+from vllm_fl.models import glm5next as model
+
+
+class _Transform(nn.Module):
+    def forward(self, x, *args):
+        return x * 0.7
+
+
+def _layers(width):
+    gen = torch.Generator().manual_seed(53)
+    result = []
+
+    def sample(shape):
+        return (torch.randn(shape, generator=gen) * 0.01).cuda()
+
+    for index in range(4):
+        layer = object.__new__(model.Glm5NextDecoderLayer)
+        nn.Module.__init__(layer)
+        layer.layer_idx = index
+        layer.num_hidden_layers = 4
+        layer.mhc = True
+        layer.n = 4
+        layer.rms_norm_eps = 1e-5
+        layer.hc_eps = 1e-6
+        layer.mhc_sinkhorn_iterations = 20
+        layer.mhc_post_mult_value = 2.0
+        for name in ["attn", "ffn"]:
+            setattr(layer, "hc_" + name + "_fn", nn.Parameter(sample((24, 4 * width))))
+            setattr(layer, "hc_" + name + "_base", nn.Parameter(sample((24,))))
+            setattr(
+                layer,
+                "hc_" + name + "_scale",
+                nn.Parameter(torch.ones(3, device="cuda")),
+            )
+        norm = SimpleNamespace(
+            weight=torch.ones(width, device="cuda"), variance_epsilon=1e-5
+        )
+        layer.input_layernorm = norm
+        layer.post_attention_layernorm = norm
+        layer.self_attn = _Transform()
+        layer.mlp = _Transform()
+        layer.mhc_pre_op = model.MHCPreOp()
+        layer.mhc_post_op = model.MHCPostOp()
+        layer.mhc_fused_post_pre_op = model.MHCFusedPostPreOp()
+        result.append(layer)
+    return result
+
+
+@pytest.mark.parametrize("split", [1, 2, 3])
+@torch.no_grad()
+def test_mhc_pipeline_matches_full_and_changed_input_graph(split, monkeypatch):
+    width = 128
+    layers = _layers(width)
+    config = SimpleNamespace(
+        mhc=True, hc_mult=4, mhc_num_residual_streams=4, hidden_size=width
+    )
+    positions = torch.arange(3, device="cuda")
+    x = torch.randn((3, width), dtype=torch.bfloat16, device="cuda")
+
+    def stage(start, end, first, last, intermediate=None):
+        monkeypatch.setattr(
+            model,
+            "get_pp_group",
+            lambda: SimpleNamespace(is_first_rank=first, is_last_rank=last),
+        )
+        owner = SimpleNamespace(
+            config=config,
+            start_layer=start,
+            end_layer=end,
+            layers=layers,
+            norm=nn.Identity(),
+        )
+        return model.Glm5NextModel.forward(
+            owner, None, positions, intermediate, inputs_embeds=x if first else None
+        )
+
+    def partitioned():
+        intermediate = stage(0, split, True, False)
+        return stage(split, 4, False, True, intermediate)
+
+    expected = stage(0, 4, True, True)
+    torch.testing.assert_close(partitioned(), expected, rtol=0.02, atol=0.002)
+    for _ in range(3):
+        partitioned()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = partitioned()
+    seed = x.clone()
+    for scale in (0.5, 1.5):
+        x.copy_(seed * scale)
+        expected = stage(0, 4, True, True)
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(actual, expected, rtol=0.02, atol=0.002)
