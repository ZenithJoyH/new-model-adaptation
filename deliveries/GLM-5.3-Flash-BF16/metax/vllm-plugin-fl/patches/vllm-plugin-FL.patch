+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the installed MetaX standalone compiler's native artifact contract."""
+import importlib
+import json
+
+import pytest
+import torch
+
+
+class _Graph(torch.nn.Module):
+    def forward(self, x):
+        # standalone_compile consumes an approved graph with flat tensor outputs.
+        return torch.sin(x) + x, torch.sum(x, dim=-1)
+
+
+@pytest.mark.parametrize("device", ["cpu", "cuda"])
+@pytest.mark.parametrize("artifact_format", ["binary", "unpacked"])
+@torch.no_grad()
+def test_standalone_artifact_native_roundtrip(
+    device, artifact_format, tmp_path
+):
+    shim = importlib.import_module(
+        "vllm_fl.dispatch.backends.vendor.metax.patches.fix_standalone_compile"
+    )
+    native = importlib.import_module("torch._inductor.standalone_compile")
+    graph = torch.fx.symbolic_trace(_Graph())
+    cache_api = importlib.import_module(
+        "torch._functorch._aot_autograd.autograd_cache"
+    )
+    cache_api.check_cacheable(graph)
+    x = (torch.arange(96, dtype=torch.float32).reshape(3, 32) / 100).to(device)
+    with torch._inductor.config.patch(
+        {"triton.cudagraphs": False, "compile_threads": 1}
+    ):
+        artifact = shim.standalone_compile(
+            graph, [x], dynamic_shapes="from_example_inputs"
+        )
+    torch.testing.assert_close(artifact(x), graph(x), rtol=1e-5, atol=1e-6)
+    destination = tmp_path / "artifact"
+    assert not destination.exists()
+    artifact.save(path=str(destination), format=artifact_format)
+    loaded = native.CompiledArtifact.load(
+        path=str(destination), format=artifact_format
+    )
+    for scale in (0.5, 1.5):
+        value = x * scale
+        torch.testing.assert_close(
+            loaded(value), graph(value), rtol=1e-5, atol=1e-6
+        )
+    if device == "cuda":
+        torch.cuda.synchronize()
+    metadata = tmp_path / "case.json"
+    assert not metadata.exists()
+    metadata.write_text(
+        json.dumps(
+            {
+                "device": device,
+                "format": artifact_format,
+                "path": str(destination),
+            }
+        )
+    )
