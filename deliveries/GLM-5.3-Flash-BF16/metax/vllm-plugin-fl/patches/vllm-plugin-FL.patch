+# SPDX-License-Identifier: Apache-2.0
+"""MetaX BF16 sparse MLA: vLLM metadata, installed FlagGems operators."""
+
+import torch
+
+from vllm.v1.attention.backends.mla.flashmla_sparse import (
+    FlashMLASparseBackend,
+    FlashMLASparseImpl,
+)
+from vllm_fl.attention.mla_prefill import FlagGemsMLAPrefillBackend
+from vllm_fl.dispatch import CachedOp
+
+_cache_write = CachedOp("concat_and_cache_mla")
+_query_concat = CachedOp("concat_mla_q")
+_sparse_attention = CachedOp("flash_mla_sparse_fwd")
+_pad_heads = CachedOp("glm5next_pad_heads")
+
+
+class MetaXGlm5NextMLABackend(FlashMLASparseBackend):
+    supported_kv_cache_dtypes = ["auto", "bfloat16"]
+
+    @staticmethod
+    def get_name():
+        return "METAX_GLM5NEXT_BF16_SPARSE"
+
+    @staticmethod
+    def get_impl_cls():
+        return MetaXGlm5NextMLAImpl
+
+    @classmethod
+    def get_supported_head_sizes(cls):
+        return [512]
+
+    @classmethod
+    def supports_compute_capability(cls, capability):
+        # Platform identity, rather than pretending that C550 is NVIDIA SM90.
+        from vllm.platforms import current_platform
+
+        return getattr(current_platform, "vendor_name", None) == "metax"
+
+
+class MetaXGlm5NextMLAImpl(FlashMLASparseImpl):
+    def __init__(self, *args, **kwargs):
+        if kwargs.get("kv_cache_dtype", "auto") not in ("auto", "bfloat16"):
+            raise ValueError("GLM MetaX sparse MLA requires BF16 main KV cache")
+        super().__init__(*args, **kwargs)
+
+    def do_kv_cache_update(
+        self, kv_c_normed, k_pe, kv_cache, slot_mapping, kv_cache_dtype, k_scale
+    ):
+        if kv_cache.numel() == 0:
+            return
+        slots = slot_mapping.flatten()
+        _cache_write(
+            kv_c_normed[: slots.shape[0]],
+            k_pe.squeeze(1)[: slots.shape[0]],
+            kv_cache,
+            slots,
+            kv_cache_dtype,
+            k_scale,
+        )
+
+    def forward_mqa(self, q, kv_cache, attn_metadata, layer):
+        if isinstance(q, tuple):
+            q_nope, q_pe = q
+            q = self.q_concat_buffer[: q_nope.shape[0]]
+            _query_concat(q_nope, q_pe, q)
+        return super().forward_mqa(q, kv_cache, attn_metadata, layer)
+
+    def _bf16_flash_mla_kernel(self, q, kv_cache, topk_indices, topk_length=None):
+        heads = q.shape[1]
+        if heads < 64:
+            q = _pad_heads(q, 64)
+        output, _, _ = _sparse_attention(
+            q,
+            kv_cache.view(-1, 1, kv_cache.shape[-1]),
+            topk_indices.view(q.shape[0], 1, -1),
+            self.softmax_scale,
+            topk_length=topk_length,
+        )
+        return output[:, :heads]
+
+
+class MetaXGlm5NextPrefillBackend(FlagGemsMLAPrefillBackend):
+    @classmethod
+    def is_available(cls):
+        from vllm.platforms import current_platform
+        from vllm_fl.dispatch.capabilities import get_flaggems_vllm_operator
+        import vllm_fl.envs as envs
+
+        return (
+            getattr(current_platform, "vendor_name", None) == "metax"
+            and envs.VLLM_FL_USE_FLAGGEMS_VLLM
+            and callable(get_flaggems_vllm_operator("flash_attn_varlen_func"))
+        )
+
+    @staticmethod
+    def get_name():
+        return "METAX_GLM5NEXT_FLAGGEMS_PREFILL"
