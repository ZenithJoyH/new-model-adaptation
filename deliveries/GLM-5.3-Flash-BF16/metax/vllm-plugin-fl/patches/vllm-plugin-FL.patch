+        actual = operation(x)
+        tolerance = 0.008 if dtype == torch.bfloat16 else 2e-6
+        torch.testing.assert_close(
+            actual.cpu(), expected, rtol=0, atol=tolerance
+        )
+        assert actual.is_contiguous() and actual.shape == x.shape
+        assert actual.dtype == dtype and actual.device == x.device
+        torch.testing.assert_close(compiled(x), actual, rtol=0, atol=0)
+    x = _indexer_input((3, 32, 128), dtype, 61).cuda()
+    torch.library.opcheck(
+        torch.ops.vllm.glm5next_rotate_indexer_query.default,
+        (x,),
+        test_utils=("test_schema", "test_faketensor"),
+    )
+    compiled(x)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = compiled(x)
+    for seed in (71, 83):
+        host = _indexer_input(tuple(x.shape), dtype, seed)
+        x.copy_(host)
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(output, operation(x), rtol=0, atol=0)
+        torch.testing.assert_close(
+            output.cpu(), _hadamard_reference(host), rtol=0, atol=tolerance
+        )
+    with pytest.raises(ValueError, match="last dimension 128"):
+        model._glm5next_rotate_indexer_query_fake(
+            torch.empty((1, 64), device="meta", dtype=dtype)
+        )
+
