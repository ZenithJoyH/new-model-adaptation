+# SPDX-License-Identifier: Apache-2.0
+"""Cumulative-gate base contract of the installed MetaX state kernel."""
+
+import math
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.gpu
+
+
+@pytest.fixture(scope="module")
+def state_kernel():
+    from triton.runtime.jit import JITFunction
+    from vllm.platforms import current_platform
+
+    if getattr(current_platform, "vendor_name", None) != "metax":
+        pytest.skip("MetaX state-kernel regression")
+    current_platform.import_kernels()
+    from vllm.model_executor.layers.fla.ops import chunk_delta_h
+
+    kernel = chunk_delta_h.chunk_gated_delta_rule_fwd_kernel_h_blockdim64
+    while not isinstance(kernel, JITFunction):
+        kernel = kernel.fn
+    assert kernel.__module__.startswith("vllm_fl.dispatch.backends.vendor.metax")
+    return kernel
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("key_dim", [64, 128, 256])
+@pytest.mark.parametrize("gate_kind", ["g", "gk"])
+@pytest.mark.parametrize("use_exp2", [False, True])
+def test_gate_base_eager_and_changed_input_graph(
+    state_kernel, dtype, key_dim, gate_kind, use_exp2
+):
+    # Zero K/W isolates gate decay from GEMM roundoff. A one-token chunk
+    # leaves v_new unchanged and stores the initial state in history.
+    k = torch.zeros((1, 1, 2, key_dim), dtype=dtype, device="cuda")
+    w = torch.zeros_like(k)
+    v = torch.full((1, 1, 2, 32), 0.5, dtype=dtype, device="cuda")
+    gate_shape = (1, 1, 2) if gate_kind == "g" else k.shape
+    gate = torch.full(gate_shape, -1.0, dtype=torch.float32, device="cuda")
+    initial = torch.full((1, 2, 32, key_dim), 0.25, device="cuda")
+    history = torch.empty((1, 1, 2, 32, key_dim), dtype=dtype, device="cuda")
+    final = torch.empty_like(initial)
+    v_new = torch.empty_like(v)
+
+    def run():
+        state_kernel[(1, 2)](
+            k=k,
+            v=v,
+            w=w,
+            v_new=v_new,
+            g=gate if gate_kind == "g" else None,
+            gk=gate if gate_kind == "gk" else None,
+            h=history,
+            h0=initial,
+            ht=final,
+            cu_seqlens=None,
+            chunk_offsets=None,
+            T=1,
+            H=2,
+            Hg=2,
+            K=key_dim,
+            V=32,
+            BT=64,
+            BV=32,
+            USE_G=gate_kind == "g",
+            USE_GK=gate_kind == "gk",
+            USE_INITIAL_STATE=True,
+            STORE_FINAL_STATE=True,
+            SAVE_NEW_VALUE=True,
+            IS_VARLEN=False,
+            USE_EXP2=use_exp2,
+            num_warps=4,
+            num_stages=1,
+        )
+
+    def check(initial_value, gate_value):
+        decay = 2.0 ** gate_value if use_exp2 else math.exp(gate_value)
+        torch.testing.assert_close(
+            final.cpu(), torch.full(initial.shape, initial_value * decay)
+        )
+        torch.testing.assert_close(
+            history.cpu(),
+            torch.full(history.shape, initial_value, dtype=dtype),
+            rtol=0,
+            atol=0,
+        )
+        torch.testing.assert_close(
+            v_new.cpu(), torch.full(v.shape, 0.5, dtype=dtype), rtol=0, atol=0
+        )
+
+    run()
+    torch.cuda.synchronize()
+    check(0.25, -1.0)
+    for _ in range(3):
+        run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        run()
+    for initial_value, gate_value in [(0.125, -2.0), (0.5, -0.5)]:
+        initial.fill_(initial_value)
+        gate.fill_(gate_value)
+        graph.replay()
+        torch.cuda.synchronize()
+        check(initial_value, gate_value)
