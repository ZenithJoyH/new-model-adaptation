+@pytest.mark.parametrize("enable_prefix", [True, False])
+def test_glm_align_scheduler_uses_state_block(enable_prefix):
+    from types import SimpleNamespace
+    from vllm.v1.core import kv_cache_utils
+    from vllm.v1.core.sched.scheduler import Scheduler
+
+    cfg, cache = _scheduler_cache_fixture(enable_prefix=enable_prefix)
+    assert cfg.cache_config.block_size == 4
+    assert kv_cache_utils.resolve_kv_cache_block_sizes(cache, cfg) == (384, 4)
+    assert cfg.cache_config.block_size == 384
+    scheduler = SimpleNamespace(cache_config=cfg.cache_config, use_eagle=False)
+    request = SimpleNamespace(
+        num_prompt_tokens=3532, num_tokens=3532, num_computed_tokens=0
+    )
+    chunks = []
+    while request.num_computed_tokens < request.num_prompt_tokens:
+        budget = min(2048, 3532 - request.num_computed_tokens)
+        count = Scheduler._mamba_block_aligned_split(scheduler, request, budget)
+        assert count > 0
+        request.num_computed_tokens += count
+        chunks.append(count)
+        if request.num_computed_tokens < 3532:
+            assert request.num_computed_tokens % 384 == 0
+    assert chunks == [1920, 1536, 76]
+
+    # A resumed request can use an exactly aligned state checkpoint.
+    request.num_computed_tokens = 0
+    assert (
+        Scheduler._mamba_block_aligned_split(
+            scheduler, request, 76, num_new_local_computed_tokens=3456
+        )
+        == 76
+    )
+    request.num_computed_tokens = 1920
+    assert (
+        Scheduler._mamba_block_aligned_split(
+            scheduler, request, 1612, num_uncached_common_prefix_tokens=768
+        )
+        == 768
+    )
+    # Decode tokens do not need to be multiples of the state block.
+    request.num_computed_tokens = 3532
+    request.num_tokens = 3533
+    assert Scheduler._mamba_block_aligned_split(scheduler, request, 1) == 1
+    # The resolver is also used through EngineCore's already-imported alias.
+    from vllm.v1.engine import core
+
+    assert core.resolve_kv_cache_block_sizes(cache, cfg) == (384, 4)
+    assert cfg.cache_config.block_size == 384
