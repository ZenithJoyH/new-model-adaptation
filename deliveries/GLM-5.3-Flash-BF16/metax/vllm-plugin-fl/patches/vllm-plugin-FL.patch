+# SPDX-License-Identifier: Apache-2.0
+"""Numerical adapter contracts for compressed indexer and main BF16 cache."""
+import pytest
+import torch
+
+from vllm_fl.dispatch import CachedOp
+
+
+def _pool_oracle(ids, lens, pool_size):
+    result = torch.full(
+        (ids.shape[0], ids.shape[1] * pool_size + pool_size - 1), -1, dtype=torch.int32
+    )
+    for row in range(ids.shape[0]):
+        for col, pool in enumerate(ids[row].tolist()):
+            if pool >= 0:
+                result[row, col * pool_size : (col + 1) * pool_size] = torch.arange(
+                    pool * pool_size, (pool + 1) * pool_size
+                )
+        start = int(lens[row]) // pool_size * pool_size
+        tail = torch.arange(start, int(lens[row]), dtype=torch.int32)
+        result[row, ids.shape[1] * pool_size : ids.shape[1] * pool_size + len(tail)] = (
+            tail
+        )
+    return result
+
+
+def test_pool_selection_exact_and_changed_graph():
+    operation = CachedOp("sparse_indexer_expand_pools_and_append_tail")
+    ids_cpu = torch.tensor([[-1, -1, -1], [0, -1, -1], [1, 0, -1]], dtype=torch.int32)
+    lens_cpu = torch.tensor([1, 6, 11], dtype=torch.int32)
+    ids, lens = ids_cpu.cuda(), lens_cpu.cuda()
+    torch.testing.assert_close(
+        operation(ids, lens, 4).cpu(),
+        _pool_oracle(ids_cpu, lens_cpu, 4),
+        rtol=0,
+        atol=0,
+    )
+    for _ in range(3):
+        operation(ids, lens, 4)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = operation(ids, lens, 4)
+    for increment in (1, 2):
+        changed = lens_cpu + increment
+        ids.copy_(ids_cpu.flip(1))
+        lens.copy_(changed)
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(
+            output.cpu(), _pool_oracle(ids_cpu.flip(1), changed, 4), rtol=0, atol=0
+        )
+
+
+@torch.no_grad()
+def test_main_cache_zero_rope_and_small_head_sparse_graph():
+    from vllm_fl.dispatch.backends.vendor.metax.impl.attention.mla.glm5next import (
+        MetaXGlm5NextMLAImpl,
+    )
+
+    impl = object.__new__(MetaXGlm5NextMLAImpl)
+    impl.num_heads = 8
+    impl.softmax_scale = 512**-0.5
+    gen = torch.Generator().manual_seed(53)
+    q_cpu = (torch.randn((3, 8, 512), generator=gen) * 0.1).bfloat16()
+    kv_cpu = (torch.randn((3, 512), generator=gen) * 0.1).bfloat16()
+    q, kv = q_cpu.cuda(), kv_cpu.cuda()
+    k_pe = torch.empty((3, 1, 0), dtype=torch.bfloat16, device="cuda")
+    cache = torch.zeros((2, 64, 512), dtype=torch.bfloat16, device="cuda")
+    slots = torch.tensor([0, 65, -1], dtype=torch.int64, device="cuda")
+    indices = torch.full((3, 80), -1, dtype=torch.int32, device="cuda")
+    indices[:, :2] = torch.tensor([0, 65], dtype=torch.int32, device="cuda")
+    scale = torch.tensor(1.0, device="cuda")
+
+    def run():
+        impl.do_kv_cache_update(kv, k_pe, cache, slots, "auto", scale)
+        return impl._bf16_flash_mla_kernel(q, cache, indices)
+
+    def oracle(qq, kk):
+        score = torch.einsum("mhd,nd->mhn", qq.float(), kk[:2].float()) * 512**-0.5
+        return torch.einsum("mhn,nd->mhd", score.softmax(-1), kk[:2].float()).bfloat16()
+
+    torch.testing.assert_close(
+        run().cpu(), oracle(q_cpu, kv_cpu), rtol=0.02, atol=0.002
+    )
+    torch.testing.assert_close(cache[0, 0].cpu(), kv_cpu[0], rtol=0, atol=0)
+    torch.testing.assert_close(cache[1, 1].cpu(), kv_cpu[1], rtol=0, atol=0)
+    for _ in range(3):
+        run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = run()
+    for multiplier in (0.5, 1.5):
+        changed_q = q_cpu * multiplier
+        changed_k = kv_cpu.flip(0) * multiplier
+        q.copy_(changed_q)
+        kv.copy_(changed_k)
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(
+            output.cpu(), oracle(changed_q, changed_k), rtol=0.02, atol=0.002
+        )
+
+
