+class SiluAndMulWithClamp(nn.Module):
+    def __init__(self, swiglu_limit, alpha=1.0, beta=0.0, **kwargs):
+        super().__init__()
+        self.swiglu_limit, self.alpha, self.beta = swiglu_limit, alpha, beta
+        if (alpha, beta) != (1.0, 0.0):
+            raise ValueError("GLM SwiGLU requires alpha=1 and beta=0")
+
+    def forward(self, x):
+        return torch.ops.vllm.glm5next_silu_and_mul_with_clamp(
+            x, self.swiglu_limit
+        )
