+@pytest.mark.parametrize("width", [256, 1536])
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+@torch.no_grad()
+def test_glm_silu_clamp_fullgraph_oracle_schema_and_changed_replay(
+    width, dtype
+):
+    module = model.SiluAndMulWithClamp(10.0)
+    model.prewarm_cached_ops()
+    compiled = torch.compile(module, fullgraph=True, dynamic=True)
+    tolerance = (0.01, 0.002) if dtype == torch.bfloat16 else (1e-5, 1e-6)
+
+    def oracle(value):
+        cpu = value.cpu().float()
+        gate, up = cpu.chunk(2, dim=-1)
+        gate, up = gate.clamp(max=10.0), up.clamp(min=-10.0, max=10.0)
+        return (gate * torch.sigmoid(gate) * up).to(dtype)
+
+    for tokens in (0, 1, 3):
+        host = (torch.arange(tokens * 2 * width).float() * 0.17).sin() * 30
+        if host.numel():
+            host[:4] = torch.tensor([-10.0, 10.0, -10.0625, 10.0625])
+        x = host.reshape(tokens, 2 * width).to(dtype).cuda()
+        expected = module(x)
+        actual = compiled(x)
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+        torch.testing.assert_close(
+            actual.cpu(), oracle(x), rtol=tolerance[0], atol=tolerance[1]
+        )
+    operation = torch.ops.vllm.glm5next_silu_and_mul_with_clamp.default
+    torch.library.opcheck(
+        operation, (x, 10.0), test_utils=("test_schema", "test_faketensor")
+    )
+    for _ in range(3):
+        compiled(x)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = compiled(x)
+    first = x.clone()
+    for scale in (0.5, 1.5):
+        x.copy_(first * scale)
+        expected = module(x)
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(captured, expected, rtol=0, atol=0)
+        torch.testing.assert_close(
+            captured.cpu(), oracle(x), rtol=tolerance[0], atol=tolerance[1]
+        )
+
+def _indexer_input(shape, dtype, seed):
+    generator = torch.Generator().manual_seed(seed)
+    return (
+        torch.randint(-50, 51, shape, generator=generator).float() / 53
+    ).to(dtype)
+
+
+def _hadamard_reference(x):
+    matrix = torch.ones(1, 1)
+    for _ in range(7):
+        matrix = torch.cat(
+            (torch.cat((matrix, matrix), 1), torch.cat((matrix, -matrix), 1)),
+            0,
+        )
+    return (x.float() @ matrix * (128**-0.5)).to(x.dtype)
+
+
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+@torch.no_grad()
+def test_indexer_rotation_strict_compile_and_changed_replay(dtype):
