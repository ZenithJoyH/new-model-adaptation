+# SPDX-License-Identifier: Apache-2.0
+"""Check a GLM-5.3-Flash text endpoint; see README's MetaX instructions."""
+
+import argparse
+import json
+import logging
+import urllib.request
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--endpoint", required=True, help="OpenAI chat-completions URL")
+    parser.add_argument("--model", default="glm5.3-flash")
+    args = parser.parse_args()
+    payload = {
+        "model": args.model,
+        "messages": [
+            {"role": "user", "content": "What is 2 + 2? Give the final answer briefly."}
+        ],
+        "temperature": 0,
+        "max_tokens": 512,
+        "top_p": 1,
+        "seed": 0,
+        "stream": False,
+    }
+    request = urllib.request.Request(
+        args.endpoint,
+        data=json.dumps(payload).encode(),
+        headers={"Content-Type": "application/json"},
+        method="POST",
+    )
+    with urllib.request.urlopen(request, timeout=600) as response:
+        result = json.load(response)
+    answer = result["choices"][0]["message"]["content"]
+    if answer.strip() != "**4**":
+        raise RuntimeError(f"Unexpected arithmetic answer: {answer!r}")
+    logging.getLogger(__name__).info("Verified final answer: %s", answer)
+
+
+if __name__ == "__main__":
+    logging.basicConfig(level=logging.INFO)
+    main()
