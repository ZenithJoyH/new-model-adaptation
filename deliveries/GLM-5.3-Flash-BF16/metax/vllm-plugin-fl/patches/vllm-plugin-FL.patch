+)
+@torch.no_grad()
+def test_mhc_fullgraph_schema_dynamic_and_changed_replay(
+    kind, with_norm, width
+):
+    model.prewarm_cached_ops()
+    module = {
+        "pre": model.MHCPreOp,
+        "post": model.MHCPostOp,
+        "fused": model.MHCFusedPostPreOp,
+    }[kind]()
+    compiled = torch.compile(module, fullgraph=True, dynamic=True)
+    generator = torch.Generator().manual_seed(53)
+
+    def sample(shape, dtype=torch.float32):
+        return (
+            (torch.randn(shape, generator=generator) * 0.01).to(dtype).cuda()
+        )
+
+    fn, scale, base = (
+        sample((24, 4 * width)),
+        torch.ones(3, device="cuda"),
+        sample((24,)),
+    )
+    fn.requires_grad_(with_norm)
+    norm = (
+        torch.ones(width, dtype=torch.bfloat16, device="cuda")
+        if with_norm
+        else None
+    )
+
+    def inputs(tokens):
+        residual = sample((tokens, 4, width), torch.bfloat16)
+        x = sample((tokens, width), torch.bfloat16)
+        post, comb = sample((tokens, 4, 1)), sample((tokens, 4, 4)).transpose(
+            -1, -2
+        )
+        pre_args = (fn, scale, base, 1e-5, 1e-6, 1e-6, 2.0, 20)
+        if kind == "pre":
+            return (residual, *pre_args, 1, norm, 1e-5)
+        if kind == "post":
+            return (x, residual, post, comb)
+        return (x, residual, post, comb, *pre_args, 1, 1, norm, 1e-5)
+
+    for tokens in (1, 3):
