+    # cache_config.block_size. Native Mamba mismatch fallback then picks the
+    # scheduling LCM for hashing, which cannot divide the storage-only tail.
+    original_resolve = kv_cache_utils.resolve_kv_cache_block_sizes
+    if not getattr(original_resolve, "_glm5_kpool", False):
+
+        @wraps(original_resolve)
+        def resolve_block_sizes(kv_cache_config, vllm_config):
+            import math
+
