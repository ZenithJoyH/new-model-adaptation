+# SPDX-License-Identifier: Apache-2.0
+"""Packed model state routing must match independent sequence execution."""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+from vllm_fl.models import glm5next as model
+
+
+def _metadata(lengths, slots, initial):
+    prefills = [n for n in lengths if n > 1]
+    nd = sum(n == 1 for n in lengths)
+    starts = torch.tensor(
+        [0] + list(torch.tensor(lengths).cumsum(0).tolist()),
+        dtype=torch.int32,
+        device="cuda",
+    )
+    offsets = [0]
+    indices = []
+    for row, length in enumerate(prefills):
+        chunks = (length + 63) // 64
+        indices.extend((row, c) for c in range(chunks))
+        offsets.append(offsets[-1] + chunks)
+    return GDNAttentionMetadata(
+        num_prefills=len(prefills),
+        num_prefill_tokens=sum(prefills),
+        num_decodes=nd,
+        num_decode_tokens=nd,
+        num_spec_decodes=0,
+        num_spec_decode_tokens=0,
+        num_actual_tokens=sum(lengths),
+        has_initial_state=torch.tensor(initial, device="cuda"),
+        non_spec_query_start_loc=starts,
+        non_spec_state_indices_tensor=torch.tensor(
+            slots, dtype=torch.int32, device="cuda"
+        ),
+        chunk_indices=torch.tensor(indices, dtype=torch.int32, device="cuda").reshape(
+            -1, 2
+        ),
+        chunk_offsets=torch.tensor(offsets, dtype=torch.int32, device="cuda"),
+        prefill_query_start_loc=starts[nd:] - nd,
+        prefill_state_indices=torch.tensor(
+            slots[nd:], dtype=torch.int32, device="cuda"
+        ),
+        prefill_has_initial_state=torch.tensor(initial[nd:], device="cuda"),
+    )
+
+
+@pytest.mark.parametrize("lengths", [(4, 3), (1, 1), (1, 1, 4), (1, 65, 3)])
+def test_packed_kda_model_matches_independent_sequences(lengths, monkeypatch):
+    gen = torch.Generator().manual_seed(53)
+    heads, dim = 2, 128
+    tokens = sum(lengths)
+    width = heads * dim
+
+    def sample(shape, dtype=torch.bfloat16):
+        return (torch.randn(shape, generator=gen) * 0.1).to(dtype).cuda()
+
+    conv = sample((5, 3 * width, 3))
+    if not model.is_conv_state_dim_first():
+        conv = conv.transpose(-1, -2).contiguous()
+    state = sample((5, heads, dim, dim), torch.float32).contiguous()
+    layers = [
+        SimpleNamespace(weight=sample((width, 1, 4)), bias=None) for _ in range(3)
+    ]
+    owner = SimpleNamespace(
+        prefix="test",
+        head_dim=dim,
+        kda_lower_bound=-5.0,
+        q_conv1d=layers[0],
+        k_conv1d=layers[1],
+        v_conv1d=layers[2],
+        A_log=torch.zeros((1, 1, heads, 1), device="cuda"),
+        dt_bias=torch.zeros((heads * dim,), device="cuda"),
+    )
+    q, k, v = [sample((tokens, width)) for _ in range(3)]
+    g = sample((1, tokens, heads, dim))
+    beta = torch.sigmoid(sample((1, tokens, heads)))
+    slots = [3, 1, 4][: len(lengths)]
+    initial = [i != len(lengths) - 1 for i in range(len(lengths))]
+
+    def run(lengths, ids, has, q, k, v, g, beta, conv, state):
+        metadata = _metadata(lengths, ids, has)
+        monkeypatch.setattr(
+            model,
+            "get_forward_context",
+            lambda: SimpleNamespace(attn_metadata={"test": metadata}),
+        )
+        owner.kv_cache = (conv, state)
+        out = torch.empty((1, q.shape[0], heads, dim), dtype=q.dtype, device="cuda")
+        model.Glm5NextLinearAttention._forward_reference_safe_gate(
+            owner, q, k, v, g, beta, out
+        )
+        return out
+
+    actual_conv, actual_state = conv.clone(), state.clone()
+    actual = run(lengths, slots, initial, q, k, v, g, beta, actual_conv, actual_state)
+    expected_conv, expected_state = conv.clone(), state.clone()
+    outs = []
+    start = 0
+    for length, slot, has in zip(lengths, slots, initial):
+        sl = slice(start, start + length)
+        outs.append(
+            run(
+                [length],
+                [slot],
+                [has],
+                q[sl],
+                k[sl],
+                v[sl],
+                g[:, sl],
+                beta[:, sl],
+                expected_conv,
+                expected_state,
+            )
+        )
+        start += length
+    torch.testing.assert_close(actual, torch.cat(outs, dim=1), rtol=0.02, atol=0.002)
+    torch.testing.assert_close(actual_conv, expected_conv, rtol=0, atol=0)
+    torch.testing.assert_close(actual_state, expected_state, rtol=0.02, atol=0.002)
+
+    if lengths != (1, 1):
+        return
+    metadata = _metadata(lengths, slots, initial)
+    monkeypatch.setattr(
+        model,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={"test": metadata}),
+    )
+    owner.kv_cache = (actual_conv, actual_state)
+    captured = torch.empty((1, tokens, heads, dim), dtype=q.dtype, device="cuda")
+
+    def decode():
+        model.Glm5NextLinearAttention._forward_reference_safe_gate(
+            owner, q, k, v, g, beta, captured
+        )
+
+    for _ in range(3):
+        decode()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        decode()
+    actual_conv.copy_(conv)
+    actual_state.copy_(state)
+    expected_conv, expected_state = conv.clone(), state.clone()
+    seed_q = q.clone()
+    for scale in (0.5, 1.5):
+        q.copy_(seed_q * scale)
+        expected = run(
+            lengths, slots, initial, q, k, v, g, beta, expected_conv, expected_state
+        )
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(captured, expected, rtol=0.02, atol=0.002)
+        torch.testing.assert_close(actual_conv, expected_conv, rtol=0, atol=0)
+        torch.testing.assert_close(actual_state, expected_state, rtol=0.02, atol=0.002)
