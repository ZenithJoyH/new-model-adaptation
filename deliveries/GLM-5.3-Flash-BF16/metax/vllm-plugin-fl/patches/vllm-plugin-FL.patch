+@pytest.mark.parametrize("pool_size,topk_tokens", [(1, 8), (4, 8), (4, 2048)])
+@torch.no_grad()
+def test_decode_paged_mqa_uses_pool_length_and_changed_graph(pool_size, topk_tokens):
+    from types import SimpleNamespace
+    from vllm.forward_context import ForwardContext, override_forward_context
+    from vllm.v1.attention.backends.mla.indexer import DeepseekV32IndexerMetadata
+    from vllm_fl.models.glm5next import sparse_attn_indexer_kpool
+
+    gen = torch.Generator().manual_seed(530)
+    large = topk_tokens == 2048
+    pages = 80 if large else 8
+    page, heads, dim, max_tokens = 32, 32, 128, 8193 if large else 135
+    max_pools = (max_tokens + pool_size - 1) // pool_size
+    table_width = (max_pools + page - 1) // page
+    keys_cpu = torch.randn((pages, page, dim), generator=gen).to(torch.float8_e4m3fn)
+    scales_cpu = torch.rand((pages, page), generator=gen) * 0.05 + 0.01
+    raw_cpu = torch.zeros((pages, page * (dim + 4)), dtype=torch.uint8)
+    raw_cpu[:, : page * dim] = keys_cpu.view(torch.uint8).reshape(pages, -1)
+    raw_cpu[:, page * dim :] = scales_cpu.view(torch.uint8)
+    cache = raw_cpu.cuda().view(pages, page, dim + 4)
+    query_cpu = torch.randn((2, heads, dim), generator=gen).to(torch.float8_e4m3fn)
+    weights_cpu = torch.rand((2, heads), generator=gen)
+    table_cpu = torch.stack(
+        [torch.randperm(pages, generator=gen)[:table_width] for _ in range(2)]
+    ).int()
+    lens_cpu = torch.tensor(
+        [513, 515] if large else [33 if pool_size > 1 else 35, 17], dtype=torch.int32
+    )
+    positions_cpu = lens_cpu * pool_size + (pool_size - 1 if pool_size > 1 else 0) - 1
+    query, weights, table, lens, positions = [
+        t.cuda()
+        for t in (query_cpu, weights_cpu, table_cpu, lens_cpu[:, None], positions_cpu)
+    ]
+    slots = torch.zeros(2, dtype=torch.int64, device="cuda")
+    decode = SimpleNamespace(
+        decode_lens=torch.ones(2, dtype=torch.int32, device="cuda"),
+        requires_padding=False,
+        seq_lens=lens,
+        block_table=table,
+        schedule_metadata=None,
+    )
+    metadata = DeepseekV32IndexerMetadata(
+        seq_lens=lens[:, 0],
+        max_seq_len=max_tokens,
+        slot_mapping=slots,
+        num_decodes=2,
+        num_prefills=0,
+        num_decode_tokens=2,
+        num_prefill_tokens=0,
+        prefill=None,
+        decode=decode,
+    )
+    context = ForwardContext(
+        no_compile_layers={},
+        attn_metadata={"index": metadata},
+        slot_mapping={"index": slots},
+    )
+    hidden = torch.empty((2, 1), device="cuda")
+    key = torch.empty((2, dim), device="cuda")
+    output = torch.empty(
+        (2, topk_tokens + pool_size - 1), dtype=torch.int32, device="cuda"
+    )
+
+    def run():
+        with override_forward_context(context):
+            return sparse_attn_indexer_kpool(
+                hidden,
+                "index",
+                cache,
+                query,
+                None,
+                key,
+                weights,
+                128,
+                None,
+                topk_tokens,
+                dim,
+                max_tokens,
+                2,
+                output,
+                True,
+                index_kpool=pool_size,
+                positions=positions,
+            )
+
+    def check(current_query):
+        actual = output.cpu()
+        for row, length in enumerate(lens_cpu.tolist()):
+            k = keys_cpu.float()[table_cpu[row].long()].reshape(-1, dim)[:length]
+            scale = scales_cpu[table_cpu[row].long()].reshape(-1)[:length]
+            scores = (
+                (current_query[row].float() @ k.t() * scale).relu()
+                * weights_cpu[row, :, None]
+            ).sum(0)
+            selected = scores.topk(topk_tokens // pool_size).indices.int()
+            if pool_size > 1:
+                expanded = (
+                    selected[:, None] * pool_size
+                    + torch.arange(pool_size, dtype=torch.int32)
+                ).reshape(-1)
+                tail = torch.arange(
+                    length * pool_size, int(positions_cpu[row]) + 1, dtype=torch.int32
+                )
+                expected = torch.cat([expanded, tail])
+            else:
+                expected = selected
+            torch.testing.assert_close(
+                actual[row].sort().values, expected.sort().values, rtol=0, atol=0
+            )
+
+    run()
+    check(query_cpu)
+    for _ in range(3):
+        run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = run()
+    assert captured.data_ptr() == output.data_ptr()
+    for factor in (0.5, -1.0):
+        changed = (query_cpu.float() * factor).to(query_cpu.dtype)
+        query.copy_(changed)
+        graph.replay()
+        torch.cuda.synchronize()
+        check(changed)
+
