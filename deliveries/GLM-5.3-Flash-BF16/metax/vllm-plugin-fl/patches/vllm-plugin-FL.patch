+        operation, args, test_utils=("test_schema", "test_faketensor")
+    )
+    for _ in range(3):
+        compiled(*args)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = compiled(*args)
+    first = args[0].clone()
+    for factor in (0.5, 1.5):
+        args[0].copy_(first * factor)
+        expected = module(*args)
+        graph.replay()
