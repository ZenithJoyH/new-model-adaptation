+    for factor in (-1.0, 0.5):
+        changed = values * factor
+        logits.copy_(changed)
+        changed_lengths = lengths_cpu.clone()
+        changed_lengths[-1] -= 1
+        lengths.copy_(changed_lengths)
+        changed_starts = starts_cpu
+        changed_ends = torch.tensor(
