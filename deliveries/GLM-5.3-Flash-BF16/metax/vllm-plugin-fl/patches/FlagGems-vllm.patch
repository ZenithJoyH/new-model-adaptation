@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Resource-safe sparse MLA candidates and actual BF16 math on MetaX."""
+import importlib
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+
+@pytest.mark.parametrize(
+    "vendor,tiles", [("metax", [(16, 16, 1)]), ("nvidia", [(64, 64, 2), (64, 64, 4)])]
+)
+def test_shared_memory_candidates(vendor, tiles, monkeypatch):
+    module = importlib.import_module("flaggems_vllm.ops.flashmla_sparse")
+    monkeypatch.setattr(module.runtime, "device", SimpleNamespace(vendor_name=vendor))
+    configs = module._sparse_mla_configs()
+    assert [(c.kwargs["BK"], c.kwargs["BH"], c.num_stages) for c in configs] == tiles
+
+
+@pytest.mark.parametrize("topk", [80, 128, 2048])
+@pytest.mark.skipif(gems.vendor_name != "metax", reason="MetaX regression")
+@pytest.mark.parametrize("heads", [64, 128])
+@pytest.mark.parametrize("width", [512, 576])
+@pytest.mark.parametrize("bounded", [False, True])
+def test_sparse_mla_cpu_oracle_and_changed_graph(heads, width, bounded, topk):
+    gen = torch.Generator().manual_seed(53)
+    q_cpu = torch.randn((3, heads, width), generator=gen, dtype=torch.bfloat16) * 0.1
+    kv_cpu = torch.randn((65, 1, width), generator=gen, dtype=torch.bfloat16) * 0.1
+    indices_cpu = torch.arange(topk, dtype=torch.int32).repeat(3, 1).unsqueeze(1)
+    indices_cpu[1, 0, 17:] = -1
+    indices_cpu[2, 0, :] = -1
+    lengths_cpu = torch.tensor([63, 11, 0], dtype=torch.int32) if bounded else None
+    q, kv, indices = [t.to(gems.device) for t in (q_cpu, kv_cpu, indices_cpu)]
+    lengths = lengths_cpu.to(gems.device) if bounded else None
+
+    def run():
+        return gems.flash_mla_sparse_fwd(
+            q, kv, indices, sm_scale=width**-0.5, topk_length=lengths
+        )
+
+    def oracle(qq, kk):
+        out = torch.zeros((3, heads, 512), dtype=torch.bfloat16)
+        maximum = torch.full((3, heads), float("-inf"))
+        lse = torch.full((3, heads), float("inf"))
+        for row in range(2):
+            ids = indices_cpu[row, 0]
+            if bounded:
+                ids = ids[: lengths_cpu[row]]
+            keys = kk[ids[(ids >= 0) & (ids < 65)].long(), 0].float()
+            scores = qq[row].float() @ keys.t() * width**-0.5
+            out[row] = (scores.softmax(-1) @ keys[:, :512]).to(out.dtype)
+            maximum[row] = scores.amax(-1)
+            lse[row] = scores.logsumexp(-1)
+        return out, maximum, lse
+
+    for a, b in zip(run(), oracle(q_cpu, kv_cpu)):
