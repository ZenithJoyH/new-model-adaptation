+# SPDX-License-Identifier: Apache-2.0
+"""MetaX causal-conv compilation and stateful graph regression."""
+
+import importlib
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from .test_causal_conv1d import _close, _reference
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="GPU required")
+
+
+@pytest.mark.parametrize("vendor,expected", [("metax", True), ("nvidia", False)])
+def test_static_history_selection(vendor, expected, monkeypatch):
+    module = importlib.import_module("flaggems_vllm.ops.causal_conv1d")
+    selected = []
+
+    class InspectLaunch:
+        def __getitem__(self, grid):
+            def inspect(*args, **kwargs):
+                selected.append(kwargs["STATIC_HISTORY"])
+
+            return inspect
+
+    monkeypatch.setattr(module, "_conv_kernel", InspectLaunch())
+    monkeypatch.setattr(module.runtime, "device", SimpleNamespace(vendor_name=vendor))
+    module.causal_conv1d_update(
+        torch.empty((1, 2), device=gems.device),
+        torch.empty((1, 2, 3), device=gems.device),
+        torch.empty((2, 4), device=gems.device),
+    )
+    assert selected == [expected]
+
+
+@pytest.mark.skipif(gems.vendor_name != "metax", reason="MetaX regression")
+@pytest.mark.parametrize("dtype", [torch.float32, torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("dim,width", [(2, 3), (23, 8), (512, 4)])
+@pytest.mark.parametrize("mode", ["prefill", "decode"])
+def test_static_history_cpu_oracle_and_changed_input_graph(dtype, dim, width, mode):
+    generator = torch.Generator(device="cpu").manual_seed(952)
+    tokens = 5 if mode == "prefill" else 1
+    x_cpu = torch.randn(dim, tokens, dtype=dtype, generator=generator)
+    weight_cpu = torch.randn(dim, width, dtype=dtype, generator=generator)
+    bias_cpu = torch.randn(dim, dtype=dtype, generator=generator) * 0.1
+    seed_cpu = torch.randn(2, dim, width + 1, dtype=dtype, generator=generator)
+    x = x_cpu.to(gems.device)
+    weight = weight_cpu.to(gems.device)
+    bias = bias_cpu.to(gems.device)
+    state = seed_cpu.to(gems.device)
+    slots = torch.tensor([1], dtype=torch.int32, device=gems.device)
+    starts = torch.tensor([0, tokens], dtype=torch.int32, device=gems.device)
+    initial = torch.tensor([True], device=gems.device)
+
+    def run():
+        if mode == "prefill":
+            return gems.causal_conv1d_fn(
+                x,
+                weight,
+                bias,
+                state,
+                starts,
+                cache_indices=slots,
+                has_initial_state=initial,
+                activation="silu",
+            )
+        return gems.causal_conv1d_update(
+            x.t(),
+            state,
+            weight,
+            bias,
+            conv_state_indices=slots,
+            activation="silu",
+        ).t()
+
+    expected, final = _reference(
+        [x_cpu],
+        seed_cpu,
+        weight_cpu,
+        bias_cpu,
+        [1],
+        [True],
+        True,
+    )
+    actual = run()
+    _close(actual.cpu(), expected[0])
+    torch.testing.assert_close(state.cpu(), final, rtol=0, atol=0)
+
+    for _ in range(3):
+        run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = run()
+
+    state.copy_(seed_cpu)
+    expected_state = seed_cpu
+    for scale in (2, 3):
+        changed = x_cpu * scale
+        x.copy_(changed)
+        expected, expected_state = _reference(
+            [changed],
+            expected_state,
+            weight_cpu,
+            bias_cpu,
+            [1],
+            [True],
+            True,
+        )
+        graph.replay()
+        torch.cuda.synchronize()
+        _close(captured.cpu(), expected[0])
+        torch.testing.assert_close(state.cpu(), expected_state, rtol=0, atol=0)
