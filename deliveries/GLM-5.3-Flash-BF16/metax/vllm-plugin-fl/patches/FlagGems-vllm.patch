+# SPDX-License-Identifier: Apache-2.0
+"""FP8 prefill MQA without an optional CUDA DeepGEMM reference dependency."""
+import importlib
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="GPU required")
+
+
+def _oracle(q, k, scales, weights, starts, ends, clean):
+    dots = torch.einsum("mhd,nd->mhn", q.float(), k.float())
+    logits = (torch.relu(dots * scales) * weights.unsqueeze(-1)).sum(1)
+    if clean:
+        for row, (start, end) in enumerate(zip(starts.tolist(), ends.tolist())):
+            logits[row, :start] = float("-inf")
+            logits[row, end:] = float("-inf")
+    return logits
+
+
+@pytest.mark.parametrize("vendor,software", [("metax", True), ("nvidia", False)])
+def test_software_fp8_selection_preserves_native_inputs(vendor, software, monkeypatch):
+    module = importlib.import_module("flaggems_vllm.ops.fp8_fp4_mqa_logits")
+    calls = []
+
+    class InspectLaunch:
+        def __getitem__(self, grid):
+            def inspect(*args, **kwargs):
+                calls.append((args[0], args[1], kwargs["SOFTWARE_FP8"]))
+
+            return inspect
+
+    monkeypatch.setattr(module, "_fp8_fp4_mqa_logits_kernel", InspectLaunch())
+    monkeypatch.setattr(module, "_can_use_tle", lambda *args: False)
+    monkeypatch.setattr(module.runtime, "device", SimpleNamespace(vendor_name=vendor))
+    q = torch.empty((1, 32, 128), dtype=torch.float8_e4m3fn, device=gems.device)
+    k = torch.empty((2, 128), dtype=torch.float8_e4m3fn, device=gems.device)
+    module.fp8_fp4_mqa_logits(
+        (q, None),
+        (k, torch.empty(2, device=gems.device)),
+        torch.empty((1, 32), device=gems.device),
+        None,
+        None,
+        clean_logits=False,
+    )
+    q_arg, k_arg, selected = calls[0]
+    assert selected == software
+    assert q_arg.dtype == (torch.uint8 if software else q.dtype)
+    assert k_arg.dtype == (torch.uint8 if software else k.dtype)
+    assert q_arg.data_ptr() == q.data_ptr() and k_arg.data_ptr() == k.data_ptr()
+
+
+@pytest.mark.parametrize("rows,keys", [(0, 70), (1, 0), (1, 70), (2, 70), (17, 129)])
+@pytest.mark.parametrize("clean", [False, True])
+@pytest.mark.parametrize("strided", [False, True])
+def test_fp8_mqa_cpu_oracle_and_changed_input_graph(rows, keys, clean, strided):
+    generator = torch.Generator(device="cpu").manual_seed(53)
+    q_cpu = (
+        torch.randint(-16, 17, (rows, 32, 128), generator=generator).float() / 8
+    ).to(torch.float8_e4m3fn)
+    k_cpu = (torch.randint(-16, 17, (keys, 128), generator=generator).float() / 8).to(
+        torch.float8_e4m3fn
+    )
+    weights_cpu = torch.randn((rows, 32), generator=generator)
+    scales_cpu = torch.linspace(0.01, 0.05, keys)
+    starts_cpu = torch.arange(rows, dtype=torch.int32).remainder(5).clamp_max(keys)
+    ends_cpu = torch.full((rows,), keys, dtype=torch.int32)
+    if rows:
+        ends_cpu[-1] = starts_cpu[-1]
+    if strided:
+        q = torch.empty((rows * 2, 32, 128), dtype=q_cpu.dtype, device=gems.device)[::2]
+        k = torch.empty((keys * 2, 128), dtype=k_cpu.dtype, device=gems.device)[::2]
+        weights = torch.empty((rows, 64), device=gems.device)[:, ::2]
+        q.copy_(q_cpu)
+        k.copy_(k_cpu)
+        weights.copy_(weights_cpu)
+    else:
+        q, k, weights = (x.to(gems.device) for x in (q_cpu, k_cpu, weights_cpu))
+    scales = scales_cpu.to(gems.device)
+    starts, ends = starts_cpu.to(gems.device), ends_cpu.to(gems.device)
+
+    def run():
+        return gems.fp8_fp4_mqa_logits(
+            (q, None), (k, scales), weights, starts, ends, clean_logits=clean
+        )
+
+    expected = _oracle(
+        q_cpu, k_cpu, scales_cpu, weights_cpu, starts_cpu, ends_cpu, clean
+    )
+    actual = run()
+    torch.testing.assert_close(actual.cpu(), expected, rtol=1e-4, atol=1e-4)
+    if not rows or not keys:
+        return
+    for _ in range(3):
+        run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = run()
+    for scale in (0.5, 1.5):
+        changed_q = (q_cpu.float().flip(-1) * scale).to(q_cpu.dtype)
+        changed_weights = weights_cpu * scale
+        q.copy_(changed_q)
+        weights.copy_(changed_weights)
+        expected = _oracle(
+            changed_q, k_cpu, scales_cpu, changed_weights, starts_cpu, ends_cpu, clean
+        )
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(captured.cpu(), expected, rtol=1e-4, atol=1e-4)
