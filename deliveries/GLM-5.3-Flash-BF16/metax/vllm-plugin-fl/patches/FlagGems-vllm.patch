+# SPDX-License-Identifier: Apache-2.0
+"""Model-sized mHC normalization against a CPU oracle and graph replay."""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="GPU required")
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_model_norm_cpu_oracle_and_changed_graph_inputs(dtype):
+    generator = torch.Generator(device="cpu").manual_seed(538)
+    source = torch.randn((3, 4096), generator=generator, dtype=dtype)
+    source_weight = torch.randn((4096,), generator=generator, dtype=dtype)
+    x = source.to(gems.device)
+    weight = source_weight.to(gems.device)
+
+    def reference(value, scale):
+        value_f = value.float()
+        return (
+            value_f
+            * torch.rsqrt(value_f.square().mean(-1, keepdim=True) + 1e-6)
+            * scale.float()
+        ).to(dtype)
+
+    actual = gems.mhc_rms_norm(x, weight, 1e-6)
+    torch.testing.assert_close(actual.cpu(), reference(source, source_weight))
+    for _ in range(3):
+        gems.mhc_rms_norm(x, weight, 1e-6)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = gems.mhc_rms_norm(x, weight, 1e-6)
+    for scale in (0.5, 1.5):
+        changed = (source.flip(-1) * scale + 0.1).to(dtype)
+        changed_weight = (source_weight * scale).to(dtype)
+        x.copy_(changed)
+        weight.copy_(changed_weight)
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(captured.cpu(), reference(changed, changed_weight))
