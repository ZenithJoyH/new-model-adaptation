         else:
             torch.testing.assert_close(out, first, rtol=0, atol=0)
     torch.testing.assert_close(logits, inputs_before, rtol=0, atol=0)
+
+
+@pytest.mark.top_k_per_row_decode
+@pytest.mark.parametrize("rows,vocab,k", [(4, 37, 8), (8, 864, 512), (1536, 864, 512)])
+@pytest.mark.parametrize("row_padding", [0, 7])
+@pytest.mark.parametrize("score_kind", ["continuous", "ties"])
+@pytest.mark.parametrize("next_n", [1, 2])
+@torch.inference_mode()
+def test_canonical_output_small_pools(rows, vocab, k, row_padding, score_kind, next_n):
+    generator = torch.Generator().manual_seed(53)
+    values = torch.randn((rows, vocab), generator=generator)
+    if score_kind == "ties":
+        values.fill_(-2)
+        ties = torch.linspace(0, vocab - 1, 8).long().tolist()
+        high = [i for i in range(vocab) if i not in ties][: k - 2]
+        values[:, high] = -1
+        values[:, ties] = -1.25
+    storage = torch.empty((rows, vocab + row_padding), device=device)
+    logits = storage[:, :vocab]
+    logits.copy_(values)
+    batch = rows // next_n
+    lengths_cpu = torch.full((batch,), vocab, dtype=torch.int32)
+    lengths_cpu[0] = next_n
+    if next_n == 1:
+        lengths_cpu[0] = 0
+    lengths = lengths_cpu.to(device)
+    starts_cpu = torch.zeros(rows, dtype=torch.int32)
+    ends_cpu = torch.tensor(
+        [int(lengths_cpu[i // next_n]) - next_n + i % next_n + 1 for i in range(rows)],
+        dtype=torch.int32,
+    )
+    backing = torch.full((rows * k + 64,), -17, dtype=torch.int32, device=device)
+    output = backing[32:-32].view(rows, k)
+
+    def reference(cpu, lo, hi):
+        expected = torch.full((rows, k), -1, dtype=torch.int32)
+        for row in range(rows):
+            start, end = int(lo[row]), int(hi[row])
+            count = min(k, max(end - start, 0))
+            order = torch.argsort(cpu[row, start:end], descending=True, stable=True)
+            expected[row, :count] = order[:count].to(torch.int32)
+        return expected.sort(-1).values
+
+    def run():
+        flaggems_vllm.top_k_per_row_decode(
+            logits,
+            next_n,
+            lengths,
+            output,
+            rows,
+            logits.stride(0),
+            logits.stride(1),
+            k,
+            canonical_output=True,
+        )
+
+    expected = reference(values, starts_cpu, ends_cpu)
+    first = None
+    for _ in range(8):
+        run()
+        host = output.cpu()
+        torch.testing.assert_close(host.sort(-1).values, expected, rtol=0, atol=0)
+        if first is None:
+            first = host
+        else:
+            torch.testing.assert_close(host, first, rtol=0, atol=0)
+    torch.testing.assert_close(logits.cpu(), values, rtol=0, atol=0)
+    assert bool((backing[:32] == -17).all())
+    assert bool((backing[-32:] == -17).all())
+
+    for _ in range(3):
+        run()
+    flaggems_vllm.runtime.torch_device_fn.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
