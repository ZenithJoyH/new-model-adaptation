+@pytest.mark.clone
+@pytest.mark.skipif(
+    flag_gems.device != "cuda",
+    reason="This regression exercises the torch.cuda graph API.",
+)
+def test_clone_registration_graph_replays_new_inputs():
+    inp = torch.arange(257, device=flag_gems.device, dtype=torch.float32)
+    with flag_gems.use_gems(include=["clone"]):
+        for _ in range(3):
+            torch.clone(inp)
+        torch_device_fn.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            result = torch.clone(inp)
+        for shift in [3, -7]:
+            inp.add_(shift)
+            expected = inp.cpu()
+            result.fill_(float("nan"))
+            graph.replay()
+            torch_device_fn.synchronize()
+            torch.testing.assert_close(result.cpu(), expected, rtol=0, atol=0)
