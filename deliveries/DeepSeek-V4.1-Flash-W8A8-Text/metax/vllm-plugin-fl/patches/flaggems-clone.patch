+@pytest.mark.clone
+@pytest.mark.parametrize("requires_grad", [False, True])
+def test_clone_registration_preserves_cpu_autograd(requires_grad, monkeypatch):
+    inp = torch.arange(24, dtype=torch.float32).reshape(4, 6).t()
+    inp.requires_grad_(requires_grad)
+    expected = torch.clone(inp)
+    clone_module = importlib.import_module("flag_gems.ops.clone")
+
+    def unexpected_device_copy(*args, **kwargs):
+        pytest.fail("CPU clone must not enter the accelerator implementation")
+
+    monkeypatch.setattr(clone_module, "_launch_copy", unexpected_device_copy)
+    with flag_gems.use_gems(include=["clone"]):
+        result = torch.clone(inp)
+        rng_state = torch.random.get_rng_state()
+        rng_copy = torch.clone(rng_state)
+        if requires_grad:
+            (grad,) = torch.autograd.grad(result.sum(), [inp])
+            torch.testing.assert_close(grad, torch.ones_like(inp), rtol=0, atol=0)
+
+    torch.testing.assert_close(result, expected, rtol=0, atol=0)
+    assert result.stride() == expected.stride()
+    assert result.data_ptr() != inp.data_ptr()
+    torch.testing.assert_close(rng_copy, rng_state, rtol=0, atol=0)
+
+
+@pytest.mark.clone
+@pytest.mark.parametrize("requires_grad", [False, True])
+def test_clone_registration_launches_device_kernel(requires_grad, monkeypatch):
+    inp = torch.arange(257, device=flag_gems.device, dtype=torch.float32)
+    inp.requires_grad_(requires_grad)
+    expected = inp.detach().cpu()
+    clone_module = importlib.import_module("flag_gems.ops.clone")
+    kernel = clone_module._clone_kernel
+    launches = []
+
+    class RecordingKernel:
+        def __getitem__(self, grid):
+            launch = kernel[grid]
+
+            def run(*args, **kwargs):
+                result = launch(*args, **kwargs)
+                launches.append(args[0].device.type)
+                return result
+
+            return run
+
+    monkeypatch.setattr(clone_module, "_clone_kernel", RecordingKernel())
+    with flag_gems.use_gems(include=["clone"]):
+        result = torch.clone(inp)
+        if requires_grad:
+            (grad,) = torch.autograd.grad(result.sum(), [inp])
+            torch.testing.assert_close(grad.cpu(), torch.ones(257), rtol=0, atol=0)
+    torch_device_fn.synchronize()
+
+    assert launches == [torch.device(flag_gems.device).type]
+    torch.testing.assert_close(result.cpu(), expected, rtol=0, atol=0)
+    assert result.data_ptr() != inp.data_ptr()
+
+
+@pytest.mark.clone
+@pytest.mark.skipif(
+    flag_gems.device != "cuda",
+    reason="This regression exercises Inductor on CUDA-compatible accelerators.",
+)
+def test_clone_registration_allows_inductor_rng_preservation():
+    inp = torch.arange(257, device=flag_gems.device, dtype=torch.float32)
+    expected = inp.cpu() + 1
+    compiled = torch.compile(lambda x: x + 1, fullgraph=True)
+    with flag_gems.use_gems(include=["clone"]):
+        result = compiled(inp)
+    torch.testing.assert_close(result.cpu(), expected, rtol=0, atol=0)
+
