+def _lookup_reference(weight, scale, ids, first, count, start):
+    weight, scale, ids = [x.cpu() for x in (weight, scale, ids)]
+    result = torch.zeros((ids.shape[0], count, weight.shape[1]), dtype=torch.bfloat16)
+    for token in range(ids.shape[0]):
+        for head in range(count):
+            index = int(ids[token, first + head]) - start
+            if 0 <= index < weight.shape[0]:
+                result[token, head] = (weight[index].float() * scale[index]).bfloat16()
+    return result
