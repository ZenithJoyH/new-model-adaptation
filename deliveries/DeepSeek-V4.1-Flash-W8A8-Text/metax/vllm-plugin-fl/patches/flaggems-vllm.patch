@@ -0,0 +1,103 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""V4.1 index K production composed from existing public numerical APIs.
+
+The framework supplies group-first positions and closed-group slots. Active
+slots must be unique valid physical slots; positions must address the RoPE
+cache. Negative slots skip cache writes. The input K projection is unchanged.
+"""
+import math
+
+import torch
+
+from flaggems_vllm import runtime
+
+
+def deepseek_v41_indexer_k_store(
+    k_pre, group_positions, cos_sin_cache, rms_norm_weight, rms_norm_eps, k_cache, slots
+):
+    """BF16 RMSNorm, tail-64 interleaved RoPE, then one UE8M0 FP8 block."""
+    import flaggems_vllm as gems
+
+    buffers = (k_pre, group_positions, cos_sin_cache, rms_norm_weight, k_cache, slots)
+    if not all(isinstance(t, torch.Tensor) for t in buffers):
+        raise TypeError("all buffers must be tensors")
+    if (
+        k_pre.ndim != 2
+        or k_pre.shape[1] != 128
+        or k_pre.dtype != torch.bfloat16
+        or not k_pre.is_contiguous()
+    ):
+        raise ValueError("k_pre must be contiguous BF16 [rows,128]")
+    rows = k_pre.shape[0]
+    if any(
+        t.shape != (rows,)
+        or t.dtype not in (torch.int32, torch.int64)
+        or not t.is_contiguous()
+        for t in (group_positions, slots)
+    ):
+        raise ValueError("group positions and slots must be contiguous INT32/64 [rows]")
+    if (
+        cos_sin_cache.ndim != 2
+        or cos_sin_cache.shape[1] != 64
+        or cos_sin_cache.dtype not in (torch.float32, torch.bfloat16)
+        or cos_sin_cache.stride(1) != 1
+    ):
+        raise ValueError(
+            "RoPE cache must be FP32/BF16 [positions,64] with contiguous columns"
+        )
+    if (
+        rms_norm_weight.shape != (128,)
+        or rms_norm_weight.dtype != torch.bfloat16
+        or not rms_norm_weight.is_contiguous()
+    ):
+        raise ValueError("norm weight must be contiguous BF16 [128]")
+    if (
+        not isinstance(rms_norm_eps, (int, float))
+        or isinstance(rms_norm_eps, bool)
+        or not math.isfinite(rms_norm_eps)
+        or rms_norm_eps <= 0
+    ):
+        raise ValueError("RMSNorm epsilon must be positive and finite")
+    if (
+        k_cache.ndim != 3
+        or k_cache.dtype != torch.uint8
+        or k_cache.shape[1] not in (32, 64)
+        or k_cache.shape[2] != 132
+        or k_cache.stride(2) != 1
+        or k_cache.stride(1) != 132
+        or k_cache.stride(0) < k_cache.shape[1] * 132
+        or k_cache.stride(0) % 4
+        or k_cache.storage_offset() % 4
+    ):
+        raise ValueError(
+            "index cache must be UINT8 [pages,32/64,132] with aligned nonoverlapping page pitch"
+        )
+    if k_pre.device.type != "cuda" or any(t.device != k_pre.device for t in buffers):
+        raise ValueError("all buffers must share one CUDA-compatible device")
+    if k_cache.numel() and any(
+        t.numel()
+        and t.untyped_storage().data_ptr() == k_cache.untyped_storage().data_ptr()
+        for t in buffers
+        if t is not k_cache
+    ):
+        raise ValueError("cache must not share storage with inputs")
+    if not rows:
+        return None
+    with runtime.torch_device_fn.device(k_pre.device):
+        normalized = gems.mhc_rms_norm(k_pre, rms_norm_weight, rms_norm_eps)
+        tail = normalized[:, None, 64:]
+        # The public rotary API requires a nonempty K head dimension. The
+        # independent temporary K result is unused; Q rotates the real tail.
+        dummy = torch.empty((rows, 1, 64), device=k_pre.device, dtype=torch.bfloat16)
+        gems.apply_rotary_pos_emb(
+            tail,
+            dummy,
+            cos_sin_cache[:, :32],
+            cos_sin_cache[:, 32:],
+            group_positions,
+            rotary_interleaved=True,
+            inplace=True,
+        )
+        gems.indexer_k_quant_and_cache(normalized, k_cache, slots, 128, "ue8m0")
+    return None
