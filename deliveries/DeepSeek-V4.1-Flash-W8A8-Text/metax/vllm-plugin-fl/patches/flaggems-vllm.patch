+@pytest.mark.scaled_int8_quant
+@pytest.mark.parametrize("symmetric", [False, True])
+def test_public_dynamic_empty_batch(symmetric):
+    x = torch.empty((0, 64), device=gems.device, dtype=torch.bfloat16)
+    quantized, scale, azp = gems.scaled_int8_quant(
+        x, scale=None, azp=None, symmetric=symmetric
+    )
+    assert quantized.shape == x.shape and quantized.dtype == torch.int8
+    assert scale.shape == (0, 1) and scale.dtype == torch.float32
+    if symmetric:
