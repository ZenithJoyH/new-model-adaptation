+def test_v41_graph_replay_new_inputs_and_cache(n, heads):
+    original = _v41_inputs(n, heads, 64)
+    q, kv, backing, cache, slots, positions, cs = _v41_device(original, 64)
+    op = flaggems_vllm.fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert
+    op(q, kv, cache, slots, positions, cs, 1e-6, 64, apply_q_norm=False)
+    q.copy_(original[0])
+    kv.copy_(original[1])
+    backing.fill_(173)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        op(q, kv, cache, slots, positions, cs, 1e-6, 64, apply_q_norm=False)
+    previous = None
+    for factor in (0.5, -1.5):
+        changed = list(original)
