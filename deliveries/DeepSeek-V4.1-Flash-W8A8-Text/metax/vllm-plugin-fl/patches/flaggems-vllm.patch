+@pytest.mark.triton_scaled_mm
+@pytest.mark.parametrize(
+    "vendor", ["metax", "nvidia", "ascend", "hygon", "mthreads", "thead"]
+)
+@pytest.mark.parametrize(
+    "m,n,k",
+    [
+        (3, 35, 70),
+        (1, 8191, 64),
+        (1, 8192, 64),
+        (32, 25600, 6144),
+        (33, 25600, 6144),
+        (65, 25600, 64),
+    ],
+)
+def test_mm_resource_tiles_are_metax_only(monkeypatch, vendor, m, n, k):
+    import importlib
+    from types import SimpleNamespace
+
+    module = importlib.import_module("flaggems_vllm.ops.triton_scaled_mm")
+    selected = []
+
+    class LaunchMetadata:
+        def __getitem__(self, grid):
+            def launch(*args, **kwargs):
+                selected.append(
+                    (
+                        kwargs["BLOCK_SIZE_M"],
+                        kwargs["BLOCK_SIZE_N"],
+                        kwargs["BLOCK_SIZE_K"],
+                    )
+                )
+
+            return launch
+
+    monkeypatch.setattr(
+        module, "runtime", SimpleNamespace(device=SimpleNamespace(vendor_name=vendor))
+    )
+    monkeypatch.setattr(module, "scaled_mm_kernel", LaunchMetadata())
+    # CPU tensors and a launch spy check selection only; no numerical claim.
+    module.triton_scaled_mm(
+        torch.empty((m, k), dtype=torch.int8),
+        torch.empty((k, n), dtype=torch.int8),
+        torch.ones((m, 1)),
+        torch.ones(n),
+        out_dtype=torch.float32,
+    )
+    if m <= 32:
+        expected = (64, 64, 256) if n < 8192 else (64, 128, 256)
+    elif m <= 64:
+        expected = (64, 64, 256)
+    else:
+        expected = (64, 128, 128)
+    if vendor == "metax":
+        if k % 32:
+            expected = (32, 32, 32)
+        elif m <= 32 and n >= 8192:
+            expected = (64, 64, 256)
+    assert selected == [expected]
+
