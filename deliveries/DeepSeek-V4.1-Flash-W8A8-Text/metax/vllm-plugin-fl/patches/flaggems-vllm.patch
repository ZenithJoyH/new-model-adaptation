+@libentry()
+@triton.jit
+def _merge_model1_splits(
+    partial,
+    partial_lse,
+    sink,
+    out,
+    lse,
+    SQ,
+    HQ: tl.constexpr,
+    partial_split_stride,
+    lse_split_stride,
+    stride_ob,
+    stride_osq,
+    stride_oh,
+    stride_lseb,
+    stride_lseh,
+    SPLITS: tl.constexpr,
+    HAVE_SINK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    head = row % HQ
+    token = (row // HQ) % SQ
+    batch = row // (HQ * SQ)
+    split = tl.arange(0, SPLITS)
+    dim = tl.arange(0, 512)
+    logs = tl.load(
+        partial_lse + split * lse_split_stride + batch * HQ * SQ + head * SQ + token
+    )
+    maximum = tl.max(logs, 0)
+    safe = tl.where(maximum == float("-inf"), 0.0, maximum)
+    base_weights = tl.exp(logs - safe)
+    sum_base = tl.sum(base_weights, 0)
+    natural_lse = tl.where(sum_base > 0.0, maximum + tl.log(sum_base), float("inf"))
+    tl.store(lse + batch * stride_lseb + head * stride_lseh + token, natural_lse)
+    if HAVE_SINK:
