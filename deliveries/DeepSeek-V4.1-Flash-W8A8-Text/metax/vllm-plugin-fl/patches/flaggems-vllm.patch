+@pytest.mark.parametrize("special", ["random", "ties", "nonfinite"])
+def test_large_k_packed_backend_and_full_score_order(monkeypatch, special):
+    import importlib
+
+    module = importlib.import_module("flaggems_vllm.ops.deepseek_v41_candidates")
+    original, calls = module._packed_candidate_topk_kernel, []
+
+    class Observed:
+        def __getitem__(self, grid):
+            launch = original[grid]
+
+            def run(*args, **kwargs):
+                calls.append(True)
+                return launch(*args, **kwargs)
+
+            return run
+
+    monkeypatch.setattr(module, "_packed_candidate_topk_kernel", Observed())
+    gen = torch.Generator().manual_seed(9819)
+    raw = torch.stack([torch.randperm(50000, generator=gen).float() for _ in range(2)])
+    if special == "ties":
+        raw.fill_(1)
+    elif special == "nonfinite":
+        raw[0, :16] = float("nan")
+        raw[0, 24:32] = float("inf")
+        raw[1].fill_(-float("inf"))
+    ends = torch.tensor([50000, 49877], dtype=torch.int32)
+    out = torch.empty((2, 2048), device="cuda", dtype=torch.int32)
+    gems.deepseek_v41_select_candidate_blocks(
+        raw.cuda(), None, ends.cuda(), 2048, 8, out
+    )
+    expected = _reference(raw, None, ends, 2048, 1)
+    got = out.cpu()
+    assert calls == [True]
+    if special == "random":
+        torch.testing.assert_close(got, expected, rtol=0, atol=0)
+    else:
+        assert (got == -1).sum().item() == (expected == -1).sum().item()
+        for row in range(2):
+            valid = got[row][got[row] >= 0].long()
+            assert len(valid.unique()) == len(valid)
+            # Use the independent reference's selected score multiset; ties may
+            # choose different block IDs and retain the same required scores.
+            a = []
+            b = []
+            for ids, target in [
+                (valid, a),
+                (expected[row][expected[row] >= 0].long(), b),
+            ]:
+                for index in ids.tolist():
+                    lo, hi = index * 8, min((index + 1) * 8, int(ends[row]))
+                    target.append(
+                        float("inf")
+                        if index == (int(ends[row]) - 1) // 8
+                        else raw[row, lo:hi].max().item()
+                    )
+            assert sorted(a) == sorted(b)
+
