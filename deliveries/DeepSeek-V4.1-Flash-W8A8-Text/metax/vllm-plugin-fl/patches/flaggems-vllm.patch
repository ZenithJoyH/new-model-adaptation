@@ -248,3 +248,79 @@ class FusedDeepseekV4QnormRopeKVRopeQuantInsertBenchmark(base.Benchmark):
 def test_fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert():
     bench = FusedDeepseekV4QnormRopeKVRopeQuantInsertBenchmark()
     bench.run()
+
+
+# Native vLLM's bundled MetaX kernel cannot run on C550. Compare the vendor
+# schedule with the independent, CPU-validated generic FGV schedule instead.
+# Both measurements include the same Q input reset and write the same cache.
+def _v41_generic(q, kv, cache, slots, positions, cs, eps, block, output):
+    from flaggems_vllm.ops.fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert import (
+        fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert,
+    )
+
+    output.copy_(q)
+    return fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert(
+        output, kv, cache, slots, positions, cs, eps, block, apply_q_norm=False
+    )
+
+
+def _v41_vendor(q, kv, cache, slots, positions, cs, eps, block, output):
+    output.copy_(q)
+    return flaggems_vllm.fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert(
+        output, kv, cache, slots, positions, cs, eps, block, apply_q_norm=False
+    )
+
+
+class V41ProjectedQBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "tokens, heads, physical block size; Q reset included"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [
+            (n, h, b)
+            for n, h in [
+                (1, 8),
+                (69, 8),
+                (512, 8),
+                (1024, 8),
+                (1, 0),
+                (69, 0),
+                (512, 0),
+                (1024, 0),
+            ]
+            for b in [32, 64]
+        ]
+
+    def get_input_iter(self, dtype):
+        generator = torch.Generator().manual_seed(20261105)
+        for n, heads, block in self.shapes:
+            q = (torch.randn(n, heads, 512, generator=generator) * 3).to(
+                device=self.device, dtype=dtype
+            )
+            kv = torch.randn(n, 512, generator=generator).to(
+                device=self.device, dtype=dtype
+            )
+            slots = torch.arange(n, dtype=torch.int64, device=self.device)
+            positions = slots + 7
+            angles = torch.outer(
+                torch.arange(n + 8, dtype=torch.float32),
+                torch.arange(1, 33, dtype=torch.float32) / 257,
+            )
+            cs = torch.cat((angles.cos(), angles.sin()), -1).to(self.device)
+            cache = torch.empty(
+                ((n + block - 1) // block + 1, block * 584),
+                dtype=torch.uint8,
+                device=self.device,
+            )
+            output = torch.empty_like(q)
+            yield q, kv, cache, slots, positions, cs, 1e-6, block, output
+
+
+@pytest.mark.fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert
+@pytest.mark.skipif(not is_support_fp8e4nv(), reason="Device does not support fp8e4nv")
+def test_v41_projected_q_without_head_norm():
+    V41ProjectedQBenchmark(
+        op_name="fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert",
+        torch_op=_v41_generic,
+        gems_op=_v41_vendor,
+        dtypes=[torch.bfloat16],
+    ).run()
