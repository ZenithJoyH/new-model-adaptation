+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Independent sequential CPU reference for final delayed-mHC collapse."""
+import importlib
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="GPU required")
+
+
+def _inputs(n, h, mixed):
+    generator = torch.Generator().manual_seed(24)
+    r = torch.randn((n + 1, 4, h), generator=generator).bfloat16().to(gems.device)[1:]
+    p = (
+        torch.randn((n + 1, 4), generator=generator).to(gems.device)[1:]
+        if mixed
+        else None
+    )
+    return r, p
+
+
+def _reference(r, p):
+    r = r.cpu().float()
+    if p is None:
+        p = torch.zeros((len(r), 4))
+        p[:, 0] = 1
+    else:
+        p = p.cpu()
+    value = r[:, 0] * p[:, 0, None] + r[:, 1] * p[:, 1, None]
+    value = value + r[:, 2] * p[:, 2, None]
+    value = value + r[:, 3] * p[:, 3, None]
+    return value.bfloat16()
+
+
+@pytest.mark.mhc_collapse
+@pytest.mark.parametrize("n", [0, 1, 7, 128])
+@pytest.mark.parametrize("h", [7, 127, 5120])
+@pytest.mark.parametrize("mixed", [False, True])
+def test_public_collapse_offset_empty_and_bf16_boundary(n, h, mixed):
+    r, p = _inputs(n, h, mixed)
+    before = r.clone()
+    before_p = None if p is None else p.clone()
+    actual = gems.mhc_collapse(r, p)
+    assert actual.shape == (n, h) and actual.dtype == torch.bfloat16
+    torch.testing.assert_close(actual.cpu(), _reference(r, p), rtol=0, atol=0)
+    torch.testing.assert_close(r, before, rtol=0, atol=0)
+    if p is not None:
+        torch.testing.assert_close(p, before_p, rtol=0, atol=0)
+
+
+@pytest.mark.mhc_collapse
+@pytest.mark.parametrize("mixed", [False, True])
+def test_ieee_zero_nan_inf_and_negative_coefficients(mixed):
+    r, p = _inputs(1, 7, mixed)
+    r[0, 0, 0] = float("nan")
+    r[0, 2, 1] = float("inf")
+    r[0, 0, 2] = -0.0
+    if p is not None:
+        p[0] = torch.tensor([-2.0, 0.0, 3.0, -1.0], device=gems.device)
+    torch.testing.assert_close(
+        gems.mhc_collapse(r, p).cpu(), _reference(r, p), rtol=0, atol=0, equal_nan=True
+    )
+
+
+@pytest.mark.mhc_collapse
+@pytest.mark.parametrize("h", [127, 5120])
+@pytest.mark.parametrize("mixed", [False, True])
+def test_real_graph_replay_updates_residual_mix_and_output(h, mixed):
+    r, p = _inputs(7, h, mixed)
+    for _ in range(3):
+        gems.mhc_collapse(r, p)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = gems.mhc_collapse(r, p)
+    for factor in (-0.7, 1.3):
+        r.mul_(factor)
+        if p is not None:
+            p.add_(0.1)
+        out.fill_(float("nan"))
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(out.cpu(), _reference(r, p), rtol=0, atol=0)
+
+
+@pytest.mark.mhc_collapse
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "dtype",
+        "shape",
+        "hidden",
+        "stride",
+        "mix_dtype",
+        "mix_shape",
+        "mix_device",
+        "mix_stride",
+    ],
+)
+def test_bad_metadata_never_launches(monkeypatch, bad):
+    r, p = _inputs(7, 127, True)
+    if bad == "dtype":
+        r = r.float()
+    elif bad == "shape":
+        r = r[:, :3].contiguous()
+    elif bad == "hidden":
+        r = r[:, :, :0]
+    elif bad == "stride":
+        r = r.transpose(1, 2)
+    elif bad == "mix_dtype":
+        p = p.bfloat16()
+    elif bad == "mix_shape":
+        p = p[:, :3]
+    elif bad == "mix_device":
+        p = p.cpu()
+    else:
+        p = torch.empty((7, 8), device=gems.device)[:, ::2]
+
+    class Forbidden:
+        def __getitem__(self, grid):
+            pytest.fail("Invalid metadata reached collapse kernel")
+
+    monkeypatch.setattr(
+        importlib.import_module("flaggems_vllm.ops.mhc_pre_delayed"),
+        "_collapse_kernel",
+        Forbidden(),
+    )
+    with pytest.raises(ValueError):
+        gems.mhc_collapse(r, p)
+
+
+@pytest.mark.mhc_collapse
+@pytest.mark.parametrize(
+    "vendor", ["metax", "nvidia", "ascend", "hygon", "mthreads", "thead"]
+)
+def test_rn_compatibility_is_metax_only(monkeypatch, vendor):
+    from types import SimpleNamespace
+
+    module = importlib.import_module("flaggems_vllm.ops.mhc_pre_delayed")
+    original = module.runtime
+    monkeypatch.setattr(
+        module,
+        "runtime",
+        SimpleNamespace(
+            device=SimpleNamespace(vendor_name=vendor),
+            torch_device_fn=original.torch_device_fn,
+        ),
+    )
+    calls = []
+
+    class Metadata:
+        def __getitem__(self, grid):
+            def launch(*args, **kwargs):
+                calls.append(kwargs["METAX_RN"])
+
+            return launch
+
+    monkeypatch.setattr(module, "_collapse_kernel", Metadata())
+    r, p = _inputs(1, 7, True)
+    module.mhc_collapse(r, p)
+    assert calls == [vendor == "metax"]
