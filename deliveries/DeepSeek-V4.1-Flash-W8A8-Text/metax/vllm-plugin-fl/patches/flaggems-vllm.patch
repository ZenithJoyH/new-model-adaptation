+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Measured MetaX INT8 tiles using the unchanged public generic scaled GEMM."""
+
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def triton_scaled_mm(
+    input: torch.Tensor,
+    weight: torch.Tensor,
+    scale_a: torch.Tensor,
+    scale_b: torch.Tensor,
+    out_dtype: type[torch.dtype],
+    bias: torch.Tensor | None = None,
+    block_size_m: int = 32,
+    block_size_n: int = 32,
+    block_size_k: int = 32,
+    use_heuristic=True,
+) -> torch.Tensor:
+    """Preserve the generic API and numerical boundaries; select aligned INT8 tiles.
+
+    Explicit tiles, irregular/storage-offset inputs, floating point types and
+    shapes outside the measured region retain generic selection. No kernel is
+    copied and no execution error is caught or retried.
+    """
+    logger.debug("GEMS_METAX TRITON_SCALED_MM")
+    from flaggems_vllm.ops.triton_scaled_mm import triton_scaled_mm as generic
+
+    m, k = input.shape
+    n = weight.shape[1]
+    aligned_int8 = (
+        input.dtype == weight.dtype == torch.int8
+        and k % 32 == 0
+        and n % 32 == 0
+        and k >= 1024
+        and n >= 1024
+        and input.storage_offset() % 16 == 0
+        and weight.storage_offset() % 16 == 0
+    )
+    if use_heuristic and aligned_int8 and 0 < m <= 128:
+        if n < 8192:
+            block_size_m, block_size_n, block_size_k = (
+                (16, 32, 256) if m <= 8 else (32, 64, 128)
+            )
+            use_heuristic = False
+        elif m <= 8:
+            block_size_m, block_size_n, block_size_k = (32, 64, 128)
+            use_heuristic = False
+    return generic(
+        input,
+        weight,
+        scale_a,
+        scale_b,
+        out_dtype,
+        bias,
+        block_size_m,
+        block_size_n,
+        block_size_k,
+        use_heuristic,
+    )
