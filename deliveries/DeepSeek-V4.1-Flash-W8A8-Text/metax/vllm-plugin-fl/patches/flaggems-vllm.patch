@@ -0,0 +1,79 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Fused checkpoint INT8 row-scale materialization with one BF16 rounding."""
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+from flaggems_vllm import runtime
+from flaggems_vllm.utils import libentry, libtuner
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("dequantize_int8_weight"), key=["WIDTH", "ROWS"]
+)
+@triton.jit
+def _dequantize_weight_kernel(
+    weight,
+    scales,
+    output,
+    stride_weight,
+    stride_scale,
+    ROWS: tl.constexpr,
+    WIDTH: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    # Every trial overwrites the fresh output and never reads it or mutates inputs.
+    ids = (tl.program_id(0) * TILE + tl.arange(0, TILE)).to(tl.int64)
+    row = ids // WIDTH
+    col = ids % WIDTH
+    valid = ids < ROWS * WIDTH
+    value = tl.load(weight + row * stride_weight + col, valid, other=0).to(tl.float32)
+    scale = tl.load(scales + row * stride_scale, valid, other=0)
+    # Explicit RN multiply preserves IEEE signed zero on the MetaX compiler.
+    tl.store(output + ids, libdevice.mul_rn(value, scale), valid)
+
+
+def dequantize_int8_weight(weight, weight_scale):
+    """Return fresh BF16 [out,in]; inputs retain their bytes and storage.
+
+    FP32 multiplication precedes the single BF16 materialization. Row scales
+    are FP32 [out,1]; inner-contiguous weight rows may have padding/offsets.
+    """
+    if not isinstance(weight, torch.Tensor) or not isinstance(
+        weight_scale, torch.Tensor
+    ):
+        raise TypeError("weight and scale must be tensors")
+    if (
+        weight.ndim != 2
+        or weight.dtype != torch.int8
+        or weight.stride(1) != 1
+        or weight.stride(0) < weight.shape[1]
+    ):
+        raise ValueError(
+            "weight must be INT8 [out,in] with nonoverlapping contiguous rows"
+        )
+    if (
+        weight_scale.shape != (weight.shape[0], 1)
+        or weight_scale.dtype != torch.float32
+    ):
+        raise ValueError("weight scale must be FP32 [out,1]")
+    if weight.device.type != "cuda" or weight.device != weight_scale.device:
+        raise ValueError("weight and scale must share a CUDA-compatible device")
+    with runtime.torch_device_fn.device(weight.device):
+        output = torch.empty(weight.shape, device=weight.device, dtype=torch.bfloat16)
+        if output.numel():
+            _dequantize_weight_kernel[
+                lambda meta: (triton.cdiv(output.numel(), meta["TILE"]),)
+            ](
+                weight,
+                weight_scale,
+                output,
+                weight.stride(0),
+                weight_scale.stride(0),
+                weight.shape[0],
+                weight.shape[1],
+            )
+    return output
