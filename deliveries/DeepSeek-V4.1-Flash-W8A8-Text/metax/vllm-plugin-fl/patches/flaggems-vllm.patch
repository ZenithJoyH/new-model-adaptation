+        assert (out == -1).all()
+    gems.deepseek_v41_apply_candidate_mask(x, None, e, out, 8)
+    if width and rows and not k:
+        assert torch.isneginf(x).all()
+
+
+@pytest.mark.parametrize("start", [0, 5, 17])
+def test_mask_negative_duplicate_and_positive_packed_edge_clamp(start):
+    raw = torch.arange(17, dtype=torch.float32).repeat(2, 1)
+    raw[0, 7] = float("nan")
+    starts = torch.tensor([start, 0], dtype=torch.int64)
+    ends = torch.tensor([17, 15], dtype=torch.int64)
+    candidates = torch.tensor(
+        [[0, 0, -1, 999999], [1, -1, -7, 999999]], dtype=torch.int32
+    )
+    x, selected = raw.cuda(), candidates.cuda()
+    gems.deepseek_v41_apply_candidate_mask(x, starts.cuda(), ends.cuda(), selected, 8)
+    torch.testing.assert_close(
+        x.cpu(), _mask(raw, starts, ends, candidates, 1), rtol=0, atol=0, equal_nan=True
+    )
+    torch.testing.assert_close(selected.cpu(), candidates, rtol=0, atol=0)
+
+
+def test_real_graph_new_logits_bounds_and_candidate_sentinels():
+    raw = torch.arange(50000, dtype=torch.float32).repeat(4, 1)
+    x = raw.cuda()
+    s = torch.tensor([0, 7], device="cuda", dtype=torch.int32)
+    e = torch.tensor([50000, 49877], device="cuda", dtype=torch.int32)
+    out = torch.full((4, 2048), -777, device="cuda", dtype=torch.int32)
+    for _ in range(3):
+        x.copy_(raw)
+        gems.deepseek_v41_select_candidate_blocks(x, s, e, 2048, 8, out, 2)
+        gems.deepseek_v41_apply_candidate_mask(x, s, e, out, 8, 2)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        gems.deepseek_v41_select_candidate_blocks(x, s, e, 2048, 8, out, 2)
+        gems.deepseek_v41_apply_candidate_mask(x, s, e, out, 8, 2)
+    raw = raw.flip(-1).clone()
+    starts, ends = torch.tensor([8, 3], dtype=torch.int32), torch.tensor(
+        [189, 257], dtype=torch.int32
+    )
+    x.copy_(raw)
+    s.copy_(starts)
+    e.copy_(ends)
+    out.fill_(-777)
+    graph.replay()
+    expected = _reference(raw, starts, ends, 2048, 2)
+    torch.testing.assert_close(out.cpu(), expected, rtol=0, atol=0)
+    torch.testing.assert_close(
+        x.cpu(), _mask(raw, starts, ends, expected, 2), rtol=0, atol=0
+    )
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["dtype", "out_dtype", "bounds", "block", "repeat", "count", "alias", "stride"],
+)
+def test_invalid_contract_rejects_before_mutation(bad):
+    x = torch.randn((2, 32), device="cuda")
+    end = torch.tensor([32, 32], device="cuda", dtype=torch.int32)
+    out = torch.full((2, 4), -777, device="cuda", dtype=torch.int32)
+    args = dict(
+        logits=x,
+        row_ks=None,
+        row_ke=end,
+        topk_blocks=4,
+        block_size=8,
+        out=out,
+        row_repeat=1,
+    )
+    changes = {
+        "dtype": ("logits", x.half()),
+        "out_dtype": ("out", out.long()),
+        "bounds": ("row_ke", end[:1]),
+        "block": ("block_size", 16),
+        "repeat": ("row_repeat", 0),
+        "count": ("topk_blocks", -1),
+        "alias": ("out", x.view(torch.int32)[:, :4]),
+        "stride": ("logits", x[:, ::2]),
+    }
+    key, value = changes[bad]
+    args[key] = value
+    old_x, old_out = x.clone(), out.clone()
+    with pytest.raises((TypeError, ValueError, NotImplementedError)):
+        gems.deepseek_v41_select_candidate_blocks(**args)
+    torch.testing.assert_close(x, old_x, rtol=0, atol=0)
+    torch.testing.assert_close(out, old_out, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("bad", ["matrix", "rows", "dtype", "alias", "stride"])
+def test_mask_specific_errors_precede_mutation(bad):
+    x = torch.randn((2, 32), device="cuda")
+    end = torch.tensor([32, 32], device="cuda", dtype=torch.int32)
+    selected = torch.zeros((2, 4), device="cuda", dtype=torch.int32)
