+    indices=None,
+    attn_sink=None,
+    extra_k_cache=None,
+    extra_indices_in_kvcache=None,
+    topk_length=None,
+    extra_topk_length=None,
+    out=None,
+):
+    logger.debug("GEMS_METAX FLASH_MLA_WITH_KVCACHE")
+    if (
+        num_splits is None
+        and q.ndim == 4
+        and q.shape[0] * q.shape[1] <= 8
+        and q.shape[-1] == head_dim_v == 512
+        and is_fp8_kvcache
+        and indices is not None
