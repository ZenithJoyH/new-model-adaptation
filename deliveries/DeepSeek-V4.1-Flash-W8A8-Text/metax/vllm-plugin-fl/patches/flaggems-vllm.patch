+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Independent delayed-mHC oracle, with FP32 projection and BF16 collapse."""
+
+import importlib
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = [
+    pytest.mark.mhc_pre_delayed,
+    pytest.mark.skipif(not torch.cuda.is_available(), reason="GPU required"),
+]
+
+
+def _reference(
+    residual,
+    fn,
+    scale,
+    base,
+    rms_eps,
+    pre_eps,
+    sink_eps,
+    post_mult,
+    repeats,
+    pre_mix=None,
+    x=None,
+    norm_weight=None,
+    norm_eps=1e-6,
+):
+    output_device = residual.device
+    residual, fn, scale, base = [v.cpu() for v in (residual, fn, scale, base)]
+    pre_mix = pre_mix.cpu() if pre_mix is not None else None
+    x = x.cpu() if x is not None else None
+    norm_weight = norm_weight.cpu() if norm_weight is not None else None
+    n, hc, h = residual.shape
+    if x is None:
+        x = residual.reshape(n, hc * h)
+    # FP64 accumulation is independent of FlagGems's FP32 GEMM implementation.
+    projection = (x.double() @ fn.double().t()).float()
+    inv = torch.rsqrt(x.float().square().mean(-1, keepdim=True) + rms_eps)
+    normalized = projection * inv
+    pre = torch.sigmoid(normalized[:, :hc] * scale[0] + base[:hc]) + pre_eps
+    post = (
+        torch.sigmoid(normalized[:, hc : 2 * hc] * scale[1] + base[hc : 2 * hc])
+        * post_mult
+    )
+    comb = (normalized[:, 2 * hc :] * scale[2] + base[2 * hc :]).reshape(n, hc, hc)
+    comb = torch.softmax(comb, -1) + sink_eps
+    comb = comb / (comb.sum(-2, keepdim=True) + sink_eps)
+    for _ in range(repeats - 1):
+        comb = comb / (comb.sum(-1, keepdim=True) + sink_eps)
+        comb = comb / (comb.sum(-2, keepdim=True) + sink_eps)
+    if pre_mix is None:
+        pre_mix = torch.zeros((n, hc), dtype=torch.float32, device=residual.device)
+        pre_mix[:, 0] = 1
+    value = (residual.float() * pre_mix.unsqueeze(-1)).sum(-2).bfloat16()
+    if norm_weight is not None:
+        f = value.float()
+        value = (
+            f
+            * torch.rsqrt(f.square().mean(-1, keepdim=True) + norm_eps)
+            * norm_weight.float()
+        ).bfloat16()
+    return tuple(v.to(output_device) for v in (post.unsqueeze(-1), comb, value, pre))
+
+
+@pytest.fixture(autouse=True)
+def restore_rng():
+    with torch.random.fork_rng(devices=[torch.cuda.current_device()]):
+        torch.manual_seed(4181)
+        yield
+
+
+def _inputs(n, h, carried=True, first=False, norm=True):
+    r = torch.randn((n, 4, h), device="cuda", dtype=torch.bfloat16)
+    k = h if first else h * 4
+    fn = torch.randn((24, k), device="cuda", dtype=torch.float32) * 0.003
+    scale = torch.tensor([0.7, 0.3, 0.2], device="cuda")
+    base = torch.randn(24, device="cuda") * 0.1
+    pre = torch.randn((n, 4), device="cuda") * 0.3 if carried else None
+    x = torch.randn((n, k), device="cuda", dtype=torch.bfloat16) if first else None
+    w = torch.randn(h, device="cuda", dtype=torch.bfloat16) * 0.1 + 1 if norm else None
+    return [r, fn, scale, base, 1e-20, 2e-5, 3e-6, 2.0, 20, pre, x, w, 1e-20]
+
+
+def _compare(actual, expected):
+    assert [x.dtype for x in actual] == [
+        torch.float32,
+        torch.float32,
+        torch.bfloat16,
+        torch.float32,
+    ]
+    for i, (a, b) in enumerate(zip(actual, expected)):
+        tolerance = 2 * torch.finfo(torch.bfloat16).eps if i == 2 else 5e-6
+        torch.testing.assert_close(a, b, atol=tolerance, rtol=tolerance, equal_nan=True)
+
+
+@pytest.mark.parametrize("n,h", [(0, 127), (1, 127), (7, 128), (17, 257), (3, 5120)])
+@pytest.mark.parametrize(
+    "carried,first,norm",
+    [(True, False, True), (False, True, True), (True, False, False)],
+)
+def test_numerical_contract(n, h, carried, first, norm):
+    args = _inputs(n, h, carried, first, norm)
+    before = [x.clone() if isinstance(x, torch.Tensor) else x for x in args]
+    actual = gems.mhc_pre_delayed(*args)
+    expected = _reference(*args)
+    _compare(actual, expected)
+    for x, old in zip(args, before):
+        if isinstance(x, torch.Tensor):
+            torch.testing.assert_close(x, old, atol=0, rtol=0)
+
+
+def test_strided_projection_metadata_and_nonzero_offset():
+    args = _inputs(3, 129)
+    fn = args[1]
+    backing = torch.empty((24, fn.shape[1] * 2), device="cuda")
+    backing[:, ::2].copy_(fn)
+    args[1] = backing[:, ::2]
+    r = torch.empty((4, 4, 129), device="cuda", dtype=torch.bfloat16)
+    r[1:].copy_(args[0])
+    args[0] = r[1:]
+    scale = torch.empty(6, device="cuda")
+    scale[::2].copy_(args[2])
+    args[2] = scale[::2]
+    _compare(gems.mhc_pre_delayed(*args), _reference(*args))
+
+
+def test_fp32_projection_and_actual_public_path(monkeypatch):
+    module = importlib.import_module("flaggems_vllm.ops.mhc_pre_delayed")
+    args = _inputs(3, 5120)
+    calls = []
+    original = module.flag_gems.mm
+
+    def observe(a, b):
+        assert a.dtype == b.dtype == torch.float32
+        out = original(a, b)
+        calls.append(out.clone())
+        torch.testing.assert_close(
+            out.cpu().double(),
+            a.cpu().double() @ b.cpu().double(),
+            rtol=1e-5,
+            atol=1e-5,
+        )
+        return out
+
+    monkeypatch.setattr(module.flag_gems, "mm", observe)
+    _compare(gems.mhc_pre_delayed(*args), _reference(*args))
+    assert len(calls) == 1
+    assert gems.mhc_pre_delayed.__module__ == module.__name__
+
+
+@pytest.mark.parametrize(
+    "kind", ["dtype", "hc", "shape", "device", "layout", "repeats"]
+)
+def test_invalid_before_compute(kind, monkeypatch):
+    module = importlib.import_module("flaggems_vllm.ops.mhc_pre_delayed")
+    args = _inputs(3, 128)
+    if kind == "dtype":
+        args[1] = args[1].bfloat16()
+    elif kind == "hc":
+        args[0] = args[0][:, :2].contiguous()
+    elif kind == "shape":
+        args[11] = args[11][:-1]
+    elif kind == "device":
+        args[2] = args[2].cpu()
+    elif kind == "layout":
+        args[0] = args[0].transpose(0, 1).contiguous().transpose(0, 1)
+    else:
+        args[8] = 0
+    calls = []
+    monkeypatch.setattr(module.flag_gems, "mm", lambda *a: calls.append(a))
