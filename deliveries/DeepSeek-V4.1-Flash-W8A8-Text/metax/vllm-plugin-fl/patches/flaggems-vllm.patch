+++ b/src/flaggems_vllm/ops/deepseek_v41_compress_norm.py
@@ -0,0 +1,275 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Copyright 2026 FlagOS Contributors
+"""V4.1 FP32 ratio-1/2 compression, ring tail saving and BF16 RMSNorm.
+
+Math/state ordering follows vLLM e77daef89e18. Request/slot construction and
+ring lifetime belong to the caller. No RoPE, quantization or cache insertion.
+"""
+
+import logging
+import math
+from numbers import Real
+
+import torch
+import triton
+import triton.language as tl
+
+from flaggems_vllm import runtime
+from flaggems_vllm.utils import libentry, libtuner
+
+logger = logging.getLogger(__name__)
+
+
+@triton.jit
+def _normalize_store(values, weight, output, token, EPS: tl.constexpr):
+    d = tl.arange(0, 512)
+    variance = tl.sum(values * values, 0) * (1.0 / 512)
+    normalized = values * tl.rsqrt(variance + EPS) * tl.load(weight + d).to(tl.float32)
+    tl.store(output + token.to(tl.int64) * 512 + d, normalized.to(tl.bfloat16))
+
+
+@triton.jit
+def _pool_two(k0, s0, k1, s1):
+    peak = tl.maximum(s0, s1, propagate_nan=tl.PropagateNan.ALL)
+    a = tl.exp(s0 - peak)
+    b = tl.exp(s1 - peak)
+    return (k0 * a + k1 * b) / (a + b)
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("deepseek_v41_compress_norm"),
+    key=["RATIO", "CAPACITY"],
+    restore_value=["STATE", "OUT"],
+)
+@triton.jit
+def _compress_kernel(
+    RAW,
+    POS,
+    STATE,
+    SLOTS,
+    QUERY,
+    REQS,
+    WEIGHT,
+    OUT,
+    N,
+    NREQS,
+    NBLOCKS,
+    RAW_STRIDE: tl.constexpr,
+    STATE_STRIDE: tl.constexpr,
+    STATE_ROW_STRIDE: tl.constexpr,
+    CAPACITY: tl.constexpr,
+    RATIO: tl.constexpr,
+    EPS: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    d = tl.arange(0, 512)
+    if RATIO == 2:
+        if pid < NREQS:
+            start = tl.load(QUERY + pid).to(tl.int64)
+            end = tl.load(QUERY + pid + 1).to(tl.int64)
+            if start < 0 or end > N or start >= end:
+                return
+            first = tl.load(SLOTS + start).to(tl.int64)
+            if first < 0 or first >= NBLOCKS * CAPACITY:
+                return
+            position = tl.load(POS + start).to(tl.int64)
+            # Read the old open group before this request writes any ring row.
+            if position > 0 and position % 2 == 1:
+                prev = STATE + (first // CAPACITY) * STATE_STRIDE
+                prev += ((position - 1) % CAPACITY) * STATE_ROW_STRIDE
+                current = RAW + start * RAW_STRIDE
+                k0 = tl.load(prev + d)
+                s0 = tl.load(prev + 512 + d)
+                k1 = tl.load(current + d)
+                s1 = tl.load(current + 512 + d)
+                tl.debug_barrier()
+                _normalize_store(_pool_two(k0, s0, k1, s1), WEIGHT, OUT, start, EPS)
+            count = tl.minimum(end - start, CAPACITY)
+            for k in tl.range(0, count):
+                token = end - count + k
+                slot = tl.load(SLOTS + token).to(tl.int64)
+                if slot >= 0 and slot < NBLOCKS * CAPACITY:
+                    target = STATE + (slot // CAPACITY) * STATE_STRIDE
+                    target += (slot % CAPACITY) * STATE_ROW_STRIDE
+                    source = RAW + token * RAW_STRIDE
+                    tl.store(target + d, tl.load(source + d))
+                    tl.store(target + 512 + d, tl.load(source + 512 + d))
+            return
+    token = (pid - NREQS).to(tl.int64)
+    if token >= N:
+        return
+    slot = tl.load(SLOTS + token).to(tl.int64)
+    position = tl.load(POS + token).to(tl.int64)
+    if slot < 0 or position < 0:
+        return
+    if RATIO == 1:
+        value = tl.load(RAW + token * RAW_STRIDE + d)
+    else:
+        if slot >= NBLOCKS * CAPACITY or position % 2 != 1:
+            return
+        request = tl.load(REQS + token).to(tl.int64)
+        if request < 0 or request >= NREQS:
+            return
+        start = tl.load(QUERY + request).to(tl.int64)
+        end = tl.load(QUERY + request + 1).to(tl.int64)
+        if token <= start or token >= end:
+            return  # The request program owns a chunk's first closed group.
+        previous_pos = tl.load(POS + token - 1).to(tl.int64)
+        previous_slot = tl.load(SLOTS + token - 1).to(tl.int64)
+        if (
+            previous_pos != position - 1
+            or previous_slot < 0
+            or previous_slot >= NBLOCKS * CAPACITY
+        ):
+            return
+        previous = RAW + (token - 1) * RAW_STRIDE
+        current = RAW + token * RAW_STRIDE
+        value = _pool_two(
+            tl.load(previous + d),
+            tl.load(previous + 512 + d),
+            tl.load(current + d),
+            tl.load(current + 512 + d),
+        )
+    _normalize_store(value, WEIGHT, OUT, token, EPS)
+
+
+def deepseek_v41_compress_norm(
+    kv_score,
+    positions,
+    state_cache,
+    slot_mapping,
+    query_start_loc,
+    token_to_req_indices,
+    rms_norm_weight,
+    rms_norm_eps,
+    compress_ratio,
+    latent_out,
+):
+    """Pool closed groups, normalize into caller BF16 output, and save FP32 tails.
+
+    raw is FP32 [N,512*ratio], output BF16 [N,512], norm BF16 [512]. Ratio 2
+    needs FP32 [blocks,capacity,1024] ring states, query boundaries and token
+    request indices; capacity is a positive even integer. Request chunks have
+    consecutive positions and exclusive ring blocks. slots encode
+    block*capacity+position%capacity. Negative slots mark padding. Invalid ring
+    slots are ignored. Request metadata construction/validation and ring reset
+    on reuse belong to the caller. Ratio 1 requires no ring/query/request map.
+    Only valid closed-group output rows and each chunk's final capacity state
+    rows change. Returns latent_out; no hidden state is retained. All tensors
+    share one accelerator; inner dimensions are contiguous. OUT/STATE cannot
+    alias any other input. Autotune restores both caller-owned mutated tensors.
+    """
+    logger.debug("GEMS DEEPSEEK_V41_COMPRESS_NORM")
+    if isinstance(compress_ratio, bool) or compress_ratio not in (1, 2):
+        raise NotImplementedError("V4.1 compression supports integer ratio 1 or 2")
+    if not isinstance(compress_ratio, int):
+        raise TypeError("compress_ratio must be an integer")
+    if (
+        isinstance(rms_norm_eps, bool)
+        or not isinstance(rms_norm_eps, Real)
+        or not math.isfinite(rms_norm_eps)
+        or rms_norm_eps <= 0
+    ):
+        raise ValueError("rms_norm_eps must be finite and positive")
+    if (
+        kv_score.ndim != 2
+        or kv_score.shape[1] != 512 * compress_ratio
+        or kv_score.stride(1) != 1
+    ):
+        raise ValueError("kv_score must be inner-contiguous [N,512*ratio]")
+    if kv_score.dtype != torch.float32:
+        raise TypeError("kv_score must be FP32")
+    n = kv_score.shape[0]
+    device = kv_score.device
+    if device.type != "cuda":
+        raise NotImplementedError("V4.1 compression requires accelerator Triton")
+
+    def check(tensor, shape, dtypes, name, contiguous=True):
+        if not isinstance(tensor, torch.Tensor) or tensor.shape != shape:
+            raise ValueError(f"{name} must have shape {shape}")
+        if tensor.dtype not in dtypes:
+            raise TypeError(f"{name} has an unsupported dtype")
+        if tensor.device != device or (contiguous and not tensor.is_contiguous()):
+            raise ValueError(f"{name} must be contiguous on the input device")
+
+    ints = (torch.int32, torch.int64)
+    check(positions, (n,), ints, "positions")
+    check(slot_mapping, (n,), ints, "slot_mapping")
+    check(rms_norm_weight, (512,), (torch.bfloat16,), "rms_norm_weight")
+    check(latent_out, (n, 512), (torch.bfloat16,), "latent_out")
+    nreqs, capacity, nblocks = 0, 1, 0
+    inputs = [kv_score, positions, slot_mapping, rms_norm_weight]
+    if compress_ratio == 2:
+        if (
+            not isinstance(state_cache, torch.Tensor)
+            or state_cache.ndim != 3
+            or state_cache.shape[2] != 1024
+        ):
+            raise ValueError("state_cache must be [blocks,capacity,1024]")
+        nblocks, capacity, _ = state_cache.shape
+        if (
+            nblocks <= 0
+            or capacity <= 0
+            or capacity % 2
+            or state_cache.stride(2) != 1
+            or state_cache.stride(1) < 1024
+            or state_cache.stride(0) < capacity * state_cache.stride(1)
+        ):
+            raise ValueError("state_cache requires positive blocks and even capacity")
+        check(state_cache, state_cache.shape, (torch.float32,), "state_cache", False)
+        if (
+            not isinstance(query_start_loc, torch.Tensor)
+            or query_start_loc.ndim != 1
+            or query_start_loc.numel() < 1
+        ):
+            raise ValueError("query_start_loc must be nonempty")
+        check(query_start_loc, query_start_loc.shape, ints, "query_start_loc")
+        check(token_to_req_indices, (n,), ints, "token_to_req_indices")
+        nreqs = query_start_loc.numel() - 1
+        if n and not nreqs:
+            raise ValueError("nonempty ratio-2 input requires requests")
+        inputs.extend([query_start_loc, token_to_req_indices])
+    elif any(
+        tensor is not None
+        for tensor in (state_cache, query_start_loc, token_to_req_indices)
+    ):
+        raise ValueError("ratio 1 requires no ring/request tensors")
+    mutated = [latent_out] + ([state_cache] if compress_ratio == 2 else [])
+    all_tensors = inputs + mutated
+    for value in mutated:
+        if value.numel() and any(
+            other is not value
+            and other.numel()
+            and value.untyped_storage().data_ptr() == other.untyped_storage().data_ptr()
+            for other in all_tensors
+        ):
+            raise ValueError("output/state must not alias inputs or each other")
+    if not n:
+        return latent_out
+    # Unused pointer arguments reuse caller output in ratio 1; no dummy buffer.
+    state = state_cache if compress_ratio == 2 else latent_out
+    query = query_start_loc if compress_ratio == 2 else slot_mapping
+    reqs = token_to_req_indices if compress_ratio == 2 else slot_mapping
+    with runtime.torch_device_fn.device(device):
+        _compress_kernel[(nreqs + n,)](
+            kv_score,
+            positions,
+            state,
+            slot_mapping,
+            query,
+            reqs,
+            rms_norm_weight,
+            latent_out,
+            n,
+            nreqs,
+            nblocks,
+            kv_score.stride(0),
+            state_cache.stride(0) if compress_ratio == 2 else 1,
+            state_cache.stride(1) if compress_ratio == 2 else 1,
+            capacity,
+            compress_ratio,
+            float(rms_norm_eps),
+        )
+    return latent_out
