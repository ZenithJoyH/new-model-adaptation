+    args = [x.to(gems.device) if isinstance(x, torch.Tensor) else x for x in host]
+    before = [x.clone() for x in args[:-1]]
+    actual = gems.engram_ngram_hash(*args)
+    expected = _hash_reference(*host)
+    torch.testing.assert_close(actual.cpu(), expected, rtol=0, atol=0)
+    assert actual.dtype == torch.int32 and actual.shape == (n, layers, 24)
+    for tensor, original in zip(args[:-1], before):
