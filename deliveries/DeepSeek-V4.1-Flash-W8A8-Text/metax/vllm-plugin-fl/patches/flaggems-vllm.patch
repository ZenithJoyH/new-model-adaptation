@@ -0,0 +1,123 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Independent FP32 multiply/BF16 reference and public operator reuse."""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = pytest.mark.dequantize_int8_weight
+
+
+@pytest.mark.parametrize(
+    "rows,cols", [(0, 512), (1, 0), (1, 17), (7, 512), (1024, 4096)]
+)
+@pytest.mark.parametrize("special", [False, True])
+def test_exact_reference_padded_offset_and_strided_scales(rows, cols, special):
+    gen = torch.Generator().manual_seed(6101)
+    raw = torch.randint(-128, 128, (rows, cols), generator=gen, dtype=torch.int8)
+    scale = torch.randn((rows, 1), generator=gen) * 0.02
+    if special and rows:
+        scale[0] = float("inf")
+        if rows > 1:
+            scale[1] = float("nan")
+        if rows > 2:
+            scale[2] = -0.0
+    storage = torch.full((rows + 1, cols + 7), 31, device="cuda", dtype=torch.int8)
+    x = storage[1:, 2 : cols + 2]
+    x.copy_(raw)
+    scales = torch.empty((rows, 3), device="cuda")
+    scales[:, :1].copy_(scale)
+    s = scales[:, :1]
+    old = storage.clone()
+    actual = gems.dequantize_int8_weight(x, s)
+    expected = (raw.float() * scale).bfloat16()
+    assert actual.dtype == torch.bfloat16 and actual.shape == raw.shape
+    assert (
+        not actual.numel()
+        or actual.untyped_storage().data_ptr() != x.untyped_storage().data_ptr()
+    )
+    torch.testing.assert_close(actual.cpu(), expected, rtol=0, atol=0, equal_nan=True)
+    zero = expected == 0
+    assert torch.equal(torch.signbit(actual.cpu())[zero], torch.signbit(expected)[zero])
+    torch.testing.assert_close(storage, old, rtol=0, atol=0)
+    torch.testing.assert_close(s.cpu(), scale, rtol=0, atol=0, equal_nan=True)
+
+
+def test_graph_new_weight_and_scale():
+    raw = torch.randint(-128, 128, (7, 512), dtype=torch.int8)
+    scale = torch.randn(7, 1) * 0.02
+    x, s = raw.cuda(), scale.cuda()
+    gems.dequantize_int8_weight(x, s)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = gems.dequantize_int8_weight(x, s)
+    raw2 = torch.randint(-128, 128, (7, 512), dtype=torch.int8)
+    scale2 = -scale * 2
+    x.copy_(raw2)
+    s.copy_(scale2)
+    actual.fill_(float("nan"))
+    graph.replay()
+    torch.testing.assert_close(
+        actual.cpu(), (raw2.float() * scale2).bfloat16(), rtol=0, atol=0
+    )
+
+
+def test_public_entry_reaches_fused_kernel(monkeypatch):
+    import importlib
+
+    module = importlib.import_module("flaggems_vllm.ops.dequantize_int8_weight")
+    original, calls = module._dequantize_weight_kernel, []
+
+    class Observed:
+        def __getitem__(self, grid):
+            launch = original[grid]
+
+            def run(*args, **kwargs):
+                calls.append(True)
+                return launch(*args, **kwargs)
+
+            return run
+
+    monkeypatch.setattr(module, "_dequantize_weight_kernel", Observed())
+    x = torch.ones((7, 512), device="cuda", dtype=torch.int8)
+    s = torch.full((7, 1), 0.25, device="cuda")
+    actual = gems.dequantize_int8_weight(x, s)
+    assert calls == [True]
+    assert (actual == 0.25).all()
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "dtype",
+        "weight_shape",
+        "stride",
+        "overlap",
+        "scale_shape",
+        "scale_dtype",
+        "device",
+    ],
+)
+def test_invalid_precedes_input_mutation(bad):
+    x = torch.ones((7, 512), device="cuda", dtype=torch.int8)
