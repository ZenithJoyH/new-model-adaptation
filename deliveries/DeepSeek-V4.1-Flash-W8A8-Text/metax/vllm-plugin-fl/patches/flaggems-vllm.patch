+def _gate_reference(hidden, kv, q, k, eps=1e-20, clamp=1e-6, mask=None):
+    h, kv, q, k = [x.cpu().double() for x in (hidden, kv, q, k)]
+    n, hc, dim = h.shape
+    key = kv[:, : hc * dim].reshape(n, hc, dim)
+    value = kv[:, hc * dim :]
+    rstd = torch.rsqrt(h.square().mean(-1) + eps) * torch.rsqrt(
+        key.square().mean(-1) + eps
+    )
+    dot = (h * (q * k) * key).sum(-1) * rstd * dim**-0.5
+    gate = torch.sigmoid(torch.copysign(dot.abs().clamp_min(clamp).sqrt(), dot))
+    if mask is not None:
+        gate = gate.masked_fill(~mask.cpu().unsqueeze(-1), 0)
+    return (h + gate.unsqueeze(-1) * value.unsqueeze(-2)).bfloat16()
+
+
+def _gate_inputs(n, dim, masked):
+    generator = torch.Generator().manual_seed(32)
+    values = [
+        torch.randn(shape, generator=generator).bfloat16().to(gems.device)
+        for shape in [(n, 4, dim), (n, 5 * dim), (4, dim), (4, dim)]
+    ]
+    mask = (torch.arange(n, device=gems.device) % 2 == 0) if masked else None
+    return (*values, mask)
