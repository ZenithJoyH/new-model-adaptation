@@ -0,0 +1,127 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Engram microbenchmarks; lookup uses a disclosed 65536-row working set.
+
+The lookup is a cache-resident microbenchmark, not a full model table bandwidth
+claim. Its baseline gathers INT8 rows before dequantizing; it never converts
+an entire table to FP32. Both paths use the repository's timing/graph settings.
+"""
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from . import base
+
+
+def _hash(history, mapping, multipliers, primes, offsets, pad):
+    n, layers = history.shape[0], multipliers.shape[0]
+    blocked = torch.zeros(n, device=history.device, dtype=torch.bool)
+    rolling = torch.zeros((n, layers), device=history.device, dtype=torch.int64)
+    result = []
+    for shift in range(4):
+        raw = history[:, shift]
+        known = (raw >= 0) & (raw < len(mapping))
+        blocked = blocked | ~known
+        value = torch.where(
+            blocked, pad, mapping[raw.clamp(0, len(mapping) - 1)]
+        ).long()
+        rolling = rolling ^ (value[:, None] * multipliers[None, :, shift])
+        if shift:
+            result.append(
+                rolling[:, :, None] % primes[None, :, shift - 1]
+                + offsets.reshape(layers, 3, 8)[None, :, shift - 1]
+            )
+    return torch.cat(result, -1).int()
+
+
+def _lookup(weight, scale, ids, first, count, start):
+    index = ids[:, first : first + count].long() - start
+    valid = (index >= 0) & (index < len(weight))
+    safe = index.clamp(0, len(weight) - 1)
+    rows = weight[safe].float() * scale[safe]
+    return torch.where(valid[:, :, None], rows, 0).bfloat16()
+
+
+def _gate(hidden, kv, q, k):
+    h = hidden.float()
+    n, hc, dim = h.shape
+    key = kv[:, : hc * dim].float().reshape(n, hc, dim)
+    value = kv[:, hc * dim :].float()
+    rstd = torch.rsqrt(h.square().mean(-1) + 1e-20) * torch.rsqrt(
+        key.square().mean(-1) + 1e-20
+    )
+    dot = (h * (q.float() * k.float()) * key).sum(-1) * rstd * dim**-0.5
+    gate = torch.sigmoid(torch.copysign(dot.abs().clamp_min(1e-6).sqrt(), dot))
+    return (h + gate[:, :, None] * value[:, None, :]).bfloat16()
+
+
+class EngramBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = (
+        "tokens; lookup_rows=65536, local_heads=3, head_dim=256; gate_hidden=5120"
+    )
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [(1,), (8,), (128,), (2048,)]
+
+    def get_input_iter(self, dtype):
+        for (n,) in self.shapes:
+            if self.op_name == "engram_ngram_hash":
+                history = torch.randint(-1, 129280, (n, 4), device=self.device)
+                mapping = (
+                    torch.arange(129280, device=self.device, dtype=torch.int32) % 99092
+                )
+                multipliers = torch.tensor(
+                    [[2**32 + 1, 2**32 + 3, 2**32 + 5, 2**32 + 7]] * 2,
+                    device=self.device,
+                )
+                primes = torch.full(
+                    (2, 3, 8), 16000057, device=self.device, dtype=torch.int64
+                )
+                offsets = torch.arange(24, device=self.device).repeat(2, 1) * 16000057
+                yield history, mapping, multipliers, primes, offsets, 2
+            elif self.op_name == "engram_embedding_int8":
+                weight = torch.randint(
+                    -127, 128, (65536, 256), device=self.device, dtype=torch.int8
+                )
+                scale = torch.rand((65536, 1), device=self.device) / 128
+                ids = torch.randint(
+                    100, 65636, (n, 24), device=self.device, dtype=torch.int32
+                )
+                yield weight, scale, ids, 0, 3, 100
+            else:
+                yield tuple(
+                    torch.randn(shape, device=self.device, dtype=dtype)
+                    for shape in [(n, 4, 5120), (n, 25600), (4, 5120), (4, 5120)]
+                )
+
+
+@pytest.mark.engram_ngram_hash
+def test_hash():
+    EngramBenchmark(
+        op_name="engram_ngram_hash",
+        torch_op=_hash,
+        gems_op=gems.engram_ngram_hash,
+        dtypes=[torch.bfloat16],
+    ).run()
+
+
+@pytest.mark.engram_embedding_int8
+def test_lookup():
+    EngramBenchmark(
+        op_name="engram_embedding_int8",
+        torch_op=_lookup,
+        gems_op=gems.engram_embedding_int8,
+        dtypes=[torch.bfloat16],
+    ).run()
+
+
+@pytest.mark.engram_gated_add
+def test_gate():
+    EngramBenchmark(
+        op_name="engram_gated_add",
+        torch_op=_gate,
+        gems_op=gems.engram_gated_add,
+        dtypes=[torch.bfloat16],
+    ).run()
diff --git a/benchmark/test_flash_mla_with_kvcache_independent.py b/benchmark/test_flash_mla_with_kvcache_independent.py
new file mode 100644
index 0000000..d0db111
--- /dev/null
+++ b/benchmark/test_flash_mla_with_kvcache_independent.py
@@ -0,0 +1,162 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Portable MODEL1 versus explicit GPU FP8 gather/dequant/attention composition.
+
+The baseline decodes selected FP8/UE8M0 bytes on every call, includes the sink,
+materializes probabilities and uses FP32 matmul with TF32 disabled. It is an
+unfused same-device baseline, not the unavailable native FlashMLA CUDA kernel.
+"""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+from flaggems_vllm.ops.flash_mla_with_kvcache import get_mla_metadata
+
+from . import base
+
+
+def _cache(pages, block_size, device):
+    values = torch.randn((pages, block_size, 512)).bfloat16()
+    groups = values[:, :, :448].float().reshape(pages, block_size, 7, 64)
+    exponent = (groups.abs().amax(-1).clamp(min=1e-4) / 448).log2().ceil()
+    codes = (
+        (groups / torch.exp2(exponent)[:, :, :, None])
+        .clamp(-448, 448)
+        .to(torch.float8_e4m3fn)
+        .view(torch.uint8)
+    )
+    data = torch.cat(
+        [
+            codes.reshape(pages, block_size, 448),
+            values[:, :, 448:].contiguous().view(torch.uint8),
+        ],
+        -1,
+    )
+    scales = torch.zeros((pages, block_size, 8), dtype=torch.uint8)
+    scales[:, :, :7] = (exponent + 127).clamp(0, 255).byte()
+    return (
+        torch.cat([data.flatten(1), scales.flatten(1)], -1)
+        .to(device=device)
+        .view(pages, block_size, 1, 584)
+    )
+
+
+def _decode_selected(cache, indices):
+    block_size = cache.shape[1]
+    flat = cache.view(cache.shape[0], -1)
+    safe = indices[:, 0].clamp(min=0).long()
+    pages = safe // block_size
+    rows = safe % block_size
+    positions = torch.arange(576, device=cache.device)
+    data = flat[pages[:, :, None], rows[:, :, None] * 576 + positions]
+    offsets = torch.arange(7, device=cache.device)
+    encoded = flat[pages[:, :, None], block_size * 576 + rows[:, :, None] * 8 + offsets]
+    codes = (
+        data[:, :, :448]
+        .contiguous()
+        .view(torch.float8_e4m3fn)
+        .float()
+        .reshape(*safe.shape, 7, 64)
+    )
+    nope = (codes * torch.exp2(encoded.float() - 127)[:, :, :, None]).flatten(-2)
+    rope = data[:, :, 448:].contiguous().view(torch.bfloat16).float()
+    return torch.cat([nope, rope], -1)
+
+
+def _reference(q, cache, indices, lengths, sink, other, other_indices, other_lengths):
+    values = _decode_selected(cache, indices)
+    valid = (
+        torch.arange(indices.shape[-1], device=q.device)[None, :] < lengths[:, None]
+    ) & (indices[:, 0] >= 0)
+    if other is not None:
+        values = torch.cat([values, _decode_selected(other, other_indices)], 1)
+        other_valid = (
+            torch.arange(other_indices.shape[-1], device=q.device)[None, :]
+            < other_lengths[:, None]
+        ) & (other_indices[:, 0] >= 0)
+        valid = torch.cat([valid, other_valid], 1)
+    scores = torch.bmm(q[:, 0].float(), values.transpose(1, 2)) * (512**-0.5)
+    scores = scores.masked_fill(~valid[:, None, :], -float("inf"))
+    sink_row = sink[None, :, None].expand(q.shape[0], -1, 1)
+    probabilities = torch.softmax(torch.cat([scores, sink_row], -1), -1)[:, :, :-1]
+    return torch.bmm(probabilities, values).bfloat16()[:, None]
+
+
+def _public(q, cache, indices, lengths, sink, other, other_indices, other_lengths):
+    metadata, _ = get_mla_metadata()
+    return gems.flash_mla_with_kvcache(
+        q,
+        cache,
+        None,
+        None,
+        512,
+        metadata,
+        softmax_scale=512**-0.5,
+        is_fp8_kvcache=True,
+        indices=indices,
+        attn_sink=sink,
+        topk_length=lengths,
+        extra_k_cache=other,
+        extra_indices_in_kvcache=other_indices,
+        extra_topk_length=other_lengths,
+    )[0]
+
+
+class PortableModel1Benchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "tokens, padded heads, SWA positions, compressed positions"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [
+            (1, 64, 128, 0),
+            (1, 64, 128, 512),
+            (8, 64, 128, 512),
+            (128, 64, 128, 512),
+            (2048, 64, 128, 512),
+        ]
+
+    def get_input_iter(self, dtype):
+        for tokens, heads, topk, extra in self.shapes:
+            cache = _cache(16, 64, self.device)
+            other = _cache(64, 16, self.device) if extra else None
+            indices = (
+                torch.arange(topk, device=self.device)[None, None, :]
+                + 17 * torch.arange(tokens, device=self.device)[:, None, None]
+            ) % 1024
+            other_indices = (
+                (
+                    torch.arange(extra, device=self.device)[None, None, :]
+                    + 23 * torch.arange(tokens, device=self.device)[:, None, None]
+                )
+                % 1024
+                if extra
+                else None
+            )
+            yield (
+                torch.randn((tokens, 1, heads, 512), device=self.device, dtype=dtype),
+                cache,
+                indices.int(),
+                torch.full((tokens,), topk, device=self.device, dtype=torch.int32),
+                torch.randn(heads, device=self.device, dtype=torch.float32),
+                other,
+                other_indices.int() if extra else None,
+                (
+                    torch.full((tokens,), extra, device=self.device, dtype=torch.int32)
+                    if extra
+                    else None
+                ),
+            )
+
+
+@pytest.mark.flash_mla_with_kvcache
+def test_flash_mla_with_kvcache_independent():
+    old = torch.backends.cuda.matmul.allow_tf32
+    torch.backends.cuda.matmul.allow_tf32 = False
+    try:
+        PortableModel1Benchmark(
+            op_name="flash_mla_with_kvcache",
+            torch_op=_reference,
+            gems_op=_public,
+            dtypes=[torch.bfloat16],
+        ).run()
+    finally:
+        torch.backends.cuda.matmul.allow_tf32 = old
diff --git a/benchmark/test_metax_w8a8_moe.py b/benchmark/test_metax_w8a8_moe.py
new file mode 100644
index 0000000..b9ccb1d
--- /dev/null
+++ b/benchmark/test_metax_w8a8_moe.py
@@ -0,0 +1,117 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""TP8-local V4.1 INT8/clamp cases against an unfused GPU composition.
+
+Baseline gathers routed experts before FP32 conversion; it never dequantizes
+all 384 tables. It intentionally materializes both quantization boundaries
+and routed GEMM results. CPU INT64 tests provide independent correctness;
+this same-device composition provides the disclosed timing baseline.
+"""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+from flaggems_vllm import runtime
+
+from . import base
+
+
+def _quant(x):
+    values = x.float()
+    maximum = values.abs().amax(-1, keepdim=True)
+    inverse = torch.where(
+        maximum == 0, torch.zeros_like(maximum), torch.div(127.0, maximum)
+    )
+    return (values * inverse).round().clamp(-128, 127).to(torch.int8), maximum / 127
+
+
+def _reference(x, w1, w2, routes, ids, s1, s2):
+    t, h = x.shape
+    k = ids.shape[1]
+    flat = ids.reshape(-1).long()
+    q, scale = _quant(x)
+    inputs = q[:, None, :].expand(t, k, h).reshape(t * k, h).float()
+    up = torch.bmm(w1[flat].float(), inputs[:, :, None]).squeeze(-1)
+    up = (
+        up * scale[:, None, :].expand(t, k, 1).reshape(t * k, 1) * s1[flat, :, 0]
+    ).bfloat16()
+    gate, value = up.float().chunk(2, -1)
+    gate = gate.clamp(max=10.0)
+    value = value.clamp(-10.0, 10.0)
+    intermediate = (gate * torch.sigmoid(gate) * value).bfloat16()
+    aq, as_ = _quant(intermediate)
+    down = torch.bmm(w2[flat].float(), aq.float()[:, :, None]).squeeze(-1)
+    down = down * as_ * s2[flat, :, 0]
+    return (
+        (down * routes.reshape(-1, 1))
+        .bfloat16()
+        .float()
+        .reshape(t, k, h)
+        .sum(1)
+        .bfloat16()
+    )
+
+
+def _public(x, w1, w2, routes, ids, s1, s2):
+    return gems.fused_experts_impl(
+        x,
+        w1,
+        w2,
+        routes,
+        ids,
+        use_int8_w8a8=True,
+        per_channel_quant=True,
+        w1_scale=s1,
+        w2_scale=s2,
+        activation="swigluoai_uninterleave",
+        gemm1_alpha=1.0,
+        gemm1_beta=0.0,
+        gemm1_clamp_limit=10.0,
+    )
+
+
+class MetaXW8A8ClampBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "tokens, hidden, TP-local intermediate, experts, topk"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [
+            (1, 64, 64, 4, 2),
+            (1, 5120, 288, 384, 6),
+            (8, 5120, 288, 384, 6),
+            (128, 5120, 288, 384, 6),
+        ]
+
+    def get_input_iter(self, dtype):
+        for t, h, i, e, k in self.shapes:
+            ids = (torch.arange(t * k, device=self.device).reshape(t, k) % e).int()
+            routes = torch.rand((t, k), device=self.device)
+            routes /= routes.sum(-1, keepdim=True)
+            yield (
+                torch.randn((t, h), device=self.device, dtype=dtype),
+                torch.randint(
+                    -32, 33, (e, 2 * i, h), device=self.device, dtype=torch.int8
+                ),
+                torch.randint(-16, 17, (e, h, i), device=self.device, dtype=torch.int8),
+                routes,
+                ids,
+                torch.rand((e, 2 * i, 1), device=self.device) / 128 + 1 / 64,
+                torch.rand((e, h, 1), device=self.device) / 256 + 1 / 256,
+            )
+
+
+@pytest.mark.fused_experts_impl
+@pytest.mark.skipif(
+    runtime.device.vendor_name != "metax", reason="MetaX W8A8 clamp benchmark"
+)
+def test_metax_w8a8_clamp():
+    previous = torch.backends.cuda.matmul.allow_tf32
+    torch.backends.cuda.matmul.allow_tf32 = False
+    try:
+        MetaXW8A8ClampBenchmark(
+            op_name="fused_experts_impl",
+            torch_op=_reference,
+            gems_op=_public,
+            dtypes=[torch.bfloat16],
+        ).run()
+    finally:
+        torch.backends.cuda.matmul.allow_tf32 = previous
