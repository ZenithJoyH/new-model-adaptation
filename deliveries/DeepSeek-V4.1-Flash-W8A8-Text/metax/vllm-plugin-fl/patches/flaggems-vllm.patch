@@ -0,0 +1,93 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Native Benchmark: explicit FP32 pool/norm and ring-tail copy baseline.
+
+Cases are repeatable without resets: pair interiors read raw rows; the N=1
+case closes position 1 and reads ring row 0, which neither path overwrites.
+No CPU inspection of GPU metadata occurs in either timed implementation.
+"""
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from . import base
+
+
+def _baseline(
+    raw, positions, state, slots, query, requests, weight, eps, ratio, output
+):
+    n = raw.shape[0]
+    if ratio == 1:
+        value = raw
+        output.copy_(
+            (
+                value
+                * torch.rsqrt(value.square().mean(-1, keepdim=True) + eps)
+                * weight.float()
+            ).bfloat16()
+        )
+    else:
+        pairs = (
+            torch.stack([state[0, 0], raw[0]])[None]
+            if n == 1
+            else raw.reshape(n // 2, 2, 1024)
+        )
+        value = (pairs[:, :, :512] * torch.softmax(pairs[:, :, 512:], dim=1)).sum(1)
+        normalized = (
+            value
+            * torch.rsqrt(value.square().mean(-1, keepdim=True) + eps)
+            * weight.float()
+        ).bfloat16()
+        if n == 1:
+            output.copy_(normalized)
+            state[0, 1].copy_(raw[0])
+        else:
+            output[1::2].copy_(normalized)
+            rows = min(n, state.shape[1])
+            state[0, :rows].copy_(raw[-rows:])
+    return output
+
+
+class CompressorBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "tokens, compression ratio"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [(n, ratio) for ratio in (1, 2) for n in (1, 8, 128, 2048)]
+
+    def get_input_iter(self, dtype):
+        for n, ratio in self.shapes:
+            raw = torch.randn((n, 512 * ratio), device=self.device, dtype=torch.float32)
+            positions = torch.arange(n, device=self.device, dtype=torch.int64)
+            if ratio == 2 and n == 1:
+                positions += 1
+            state = (
+                torch.randn((1, 8, 1024), device=self.device) if ratio == 2 else None
+            )
+            slots = positions % 8 if ratio == 2 else positions.clone()
+            query = (
+                torch.tensor([0, n], device=self.device, dtype=torch.int32)
+                if ratio == 2
+                else None
+            )
+            requests = (
+                torch.zeros(n, device=self.device, dtype=torch.int32)
+                if ratio == 2
+                else None
+            )
+            weight = torch.randn((512,), device=self.device, dtype=torch.bfloat16)
+            output = torch.full(
+                (n, 512), -123.0, device=self.device, dtype=torch.bfloat16
+            )
+            yield raw, positions, state, slots, query, requests, weight, 1e-20, ratio, output
+
+
+@pytest.mark.deepseek_v41_compress_norm
+def test_deepseek_v41_compress_norm():
+    CompressorBenchmark(
+        op_name="deepseek_v41_compress_norm",
+        torch_op=_baseline,
+        gems_op=gems.deepseek_v41_compress_norm,
+        dtypes=[torch.bfloat16],
+    ).run()
