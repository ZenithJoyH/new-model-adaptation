+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Native Benchmark against explicit same-device FP32 block/topk/mask.
+
+Mask timing is idempotent for fixed candidates/bounds in both paths. Select
+reads unchanged logits. No CPU metadata copies or global registration occur.
+"""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from . import base
+
+
+def _select(x, starts, ends, k, block, out, repeat):
+    rows, width = x.shape
+    nblocks = (width + 7) // 8
+    ids = torch.arange(nblocks * 8, device=x.device).reshape(1, nblocks, 8)
+    columns = starts[:, None, None] + ids
+    valid = (columns < ends[:, None, None]) & (columns < width)
+    values = x.gather(1, columns.clamp(max=width - 1).reshape(rows, -1)).reshape(
+        rows, nblocks, 8
+    )
+    scores = values.masked_fill(~valid, -float("inf")).amax(-1)
+    newest = (ends - starts - 1) // 8
+    scores.scatter_(1, newest[:, None].long(), float("inf"))
+    top = scores.topk(min(k, nblocks), -1)
+    out.fill_(-1)
+    out[:, : top.values.shape[1]].copy_(
+        torch.where(top.values > -float("inf"), top.indices.int(), -1)
+    )
+    return out
+
+
+def _mask(x, starts, ends, selected, block, repeat):
+    rows, width = x.shape
+    nblocks = (width + 7) // 8
+    flags = torch.zeros((rows, nblocks + 2), device=x.device, dtype=torch.uint8)
+    ids = torch.where(
+        starts[:, None] + selected.long() * 8 >= width, nblocks, selected.long()
+    )
+    ids = torch.where(selected < 0, nblocks + 1, ids)
+    flags.scatter_(1, ids, 1)
+    columns = torch.arange(width, device=x.device)[None, :]
+    local = (columns - starts[:, None]) // 8
+    valid = (columns >= starts[:, None]) & (columns < ends[:, None])
+    keep = flags.gather(1, local.clamp(min=0, max=nblocks).long()).bool()
+    keep |= (columns == width - 1) & flags[:, nblocks : nblocks + 1].bool()
+    return x.masked_fill_(~(valid & keep), -float("inf"))
+
+
+class CandidateBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "rows, packed width, selected blocks"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [
+            (1, 4096, 512),
+            (1, 50000, 2048),
+            (8, 50000, 2048),
+            (128, 50000, 2048),
+        ]
+
+    def get_input_iter(self, dtype):
+        for rows, width, k in self.shapes:
+            x = torch.randn((rows, width), device=self.device)
+            starts = torch.zeros(rows, device=self.device, dtype=torch.int32)
+            ends = torch.full((rows,), width, device=self.device, dtype=torch.int32)
+            out = torch.empty((rows, k), device=self.device, dtype=torch.int32)
+            yield x, starts, ends, k, 8, out, 1
+
+
+class MaskBenchmark(CandidateBenchmark):
+    def get_input_iter(self, dtype):
+        for x, starts, ends, k, block, out, repeat in super().get_input_iter(dtype):
+            out.copy_(
+                torch.arange(k, device=x.device).int()[None, :].expand(x.shape[0], -1)
+            )
+            yield x, starts, ends, out, block, repeat
+
+
+@pytest.mark.deepseek_v41_select_candidate_blocks
+def test_deepseek_v41_select_candidate_blocks():
+    CandidateBenchmark(
+        op_name="deepseek_v41_select_candidate_blocks",
+        torch_op=_select,
+        gems_op=gems.deepseek_v41_select_candidate_blocks,
+        dtypes=[torch.float32],
+    ).run()
+
+
+@pytest.mark.deepseek_v41_apply_candidate_mask
+def test_deepseek_v41_apply_candidate_mask():
+    MaskBenchmark(
+        op_name="deepseek_v41_apply_candidate_mask",
+        torch_op=_mask,
+        gems_op=gems.deepseek_v41_apply_candidate_mask,
+        dtypes=[torch.float32],
