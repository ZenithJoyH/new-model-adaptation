+# V4.1 uses the projected Q magnitudes: upstream e77 passes apply_q_norm=False.
+def _v41_inputs(n, heads, block):
+    generator = torch.Generator().manual_seed(20261105 + n + heads + block)
+    q = (torch.randn(n, heads, 512, generator=generator) * 3).bfloat16()
+    if n and heads:
+        q[0, 0, :4] = torch.tensor([-0.0, 0.0, -7.0, 11.0]).bfloat16()
+    kv = torch.randn(n, 512, generator=generator).bfloat16()
+    if n:
+        kv[0].zero_()
+    if n > 1:
+        kv[1].zero_()
+    positions = torch.arange(n, dtype=torch.int64) + 7
+    angles = torch.outer(
+        torch.arange(n + 8, dtype=torch.float64),
+        torch.arange(1, 33, dtype=torch.float64) / 257,
+    )
+    cs = torch.cat((angles.cos(), angles.sin()), -1).float()
+    pages = (n + block - 1) // block + 2
+    backing = torch.full((pages, block * 584 + 96), 173, dtype=torch.uint8)
+    slots = torch.arange(n, dtype=torch.int64).flip(0) + block
+    if n > 1:
+        slots[::5] = -1
+    # A shorter insert list also covers DP padding independently of invalid slots.
+    slots = slots[: max(0, n - 2)] if n > 2 else slots
+    return q, kv, backing, slots, positions, cs
+
+
+def _v41_assert(q, kv, backing, original, block, apply_q_norm=False):
+    q0, kv0, initial, slots, positions, cs = original
+    actual = q.detach().cpu()
+    expected = q0.clone()
+    x = q0.double()
+    if apply_q_norm:
+        x = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + 1e-6)
+        expected = x.bfloat16()
+    tail = x[..., 448:].reshape(len(q0), q0.shape[1], 32, 2)
+    c = cs[positions, :32].double()[:, None]
+    s = cs[positions, 32:].double()[:, None]
+    even, odd = tail[..., 0], tail[..., 1]
+    expected[..., 448:] = (
+        torch.stack((even * c - odd * s, odd * c + even * s), -1)
+        .reshape_as(expected[..., 448:])
+        .bfloat16()
+    )
+    if not apply_q_norm:
+        assert torch.equal(
+            actual[..., :448].view(torch.int16),
+            q0[..., :448].contiguous().view(torch.int16),
+        )
+    torch.testing.assert_close(
+        actual, expected, rtol=0.008, atol=0.0002, equal_nan=True
+    )
+    assert torch.equal(kv.cpu(), kv0)
+    got = backing.cpu()
+    wanted = initial.clone()
+    for row, slot in enumerate(slots.tolist()):
+        if slot < 0:
+            continue
+        page, offset = divmod(slot, block)
+        start = 16 + offset * 576
+        groups = kv0[row, :448].double().reshape(7, 64)
+        exponent = (groups.abs().amax(-1).clamp_min(1e-4) / 448).log2().ceil()
+        code = (
+            (groups / torch.exp2(exponent[:, None]))
+            .clamp(-448, 448)
+            .float()
+            .to(torch.float8_e4m3fn)
+            .view(torch.uint8)
+            .reshape(-1)
+        )
+        wanted[page, start : start + 448] = code
+        scale_start = 16 + block * 576 + offset * 8
+        wanted[page, scale_start : scale_start + 7] = (
+            (exponent + 127).clamp(0, 255).byte()
+        )
+        wanted[page, scale_start + 7] = 0
+        rope = kv0[row, 448:].double().reshape(32, 2)
+        c, s = cs[positions[row], :32].double(), cs[positions[row], 32:].double()
+        reference = (
+            torch.stack(
+                (rope[:, 0] * c - rope[:, 1] * s, rope[:, 1] * c + rope[:, 0] * s), -1
+            )
+            .reshape(64)
+            .bfloat16()
+        )
+        actual_rope = (
+            got[page, start + 448 : start + 576].contiguous().view(torch.bfloat16)
+        )
+        torch.testing.assert_close(actual_rope, reference, rtol=0.008, atol=0.0002)
+        # Numerics were checked independently; include exact protection outside writes.
+        wanted[page, start + 448 : start + 576] = got[page, start + 448 : start + 576]
+    assert torch.equal(got, wanted)
+
+
+def _v41_device(original, block):
+    q, kv, backing, slots, positions, cs = [
+        x.to(flaggems_vllm.device) for x in original
+    ]
+    cache = backing[:, 16 : 16 + block * 584]
+    return q, kv, backing, cache, slots, positions, cs
+
+
