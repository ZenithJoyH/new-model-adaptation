@@ -0,0 +1,134 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Compare delayed mHC against an independent FP32 model reference."""
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from . import base
+
+
+def _reference(
+    residual,
+    fn,
+    scale,
+    base,
+    rms_eps,
+    pre_eps,
+    sink_eps,
+    post_mult,
+    repeats,
+    pre_mix=None,
+    x=None,
+    norm_weight=None,
+    norm_eps=1e-6,
+):
+    n, hc, h = residual.shape
+    if x is None:
+        x = residual.reshape(n, hc * h)
+    # Match the upstream FP32 model reference for the timing baseline.
+    projection = x.float() @ fn.t()
+    inv = torch.rsqrt(x.float().square().mean(-1, keepdim=True) + rms_eps)
+    normalized = projection * inv
+    pre = torch.sigmoid(normalized[:, :hc] * scale[0] + base[:hc]) + pre_eps
+    post = (
+        torch.sigmoid(normalized[:, hc : 2 * hc] * scale[1] + base[hc : 2 * hc])
+        * post_mult
+    )
+    comb = (normalized[:, 2 * hc :] * scale[2] + base[2 * hc :]).reshape(n, hc, hc)
+    comb = torch.softmax(comb, -1) + sink_eps
+    comb = comb / (comb.sum(-2, keepdim=True) + sink_eps)
+    for _ in range(repeats - 1):
+        comb = comb / (comb.sum(-1, keepdim=True) + sink_eps)
+        comb = comb / (comb.sum(-2, keepdim=True) + sink_eps)
+    if pre_mix is None:
+        pre_mix = torch.zeros((n, hc), dtype=torch.float32, device=residual.device)
+        pre_mix[:, 0] = 1
+    value = (residual.float() * pre_mix.unsqueeze(-1)).sum(-2).bfloat16()
+    if norm_weight is not None:
+        f = value.float()
+        value = (
+            f
+            * torch.rsqrt(f.square().mean(-1, keepdim=True) + norm_eps)
+            * norm_weight.float()
+        ).bfloat16()
+    return post.unsqueeze(-1), comb, value, pre
+
+
+class MHCDelayedBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "tokens, hidden"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [
+            (1, 127),
+            (1, 5120),
+            (8, 5120),
+            (128, 5120),
+            (512, 5120),
+            (2048, 5120),
+        ]
+
+    def get_input_iter(self, dtype):
+        for n, h in self.shapes:
+            for first in (False, True):
+                residual = torch.randn((n, 4, h), device=self.device, dtype=dtype)
+                k = h if first else 4 * h
+                fn = torch.randn((24, k), device=self.device) * 0.003
+                scale = torch.tensor([0.7, 0.3, 0.2], device=self.device)
+                bias = torch.randn(24, device=self.device) * 0.1
+                pre = None if first else torch.rand((n, 4), device=self.device)
+                x = (
+                    torch.randn((n, h), device=self.device, dtype=dtype)
+                    if first
+                    else None
+                )
+                norm = torch.ones(h, device=self.device, dtype=dtype)
+                yield residual, fn, scale, bias, 1e-20, 1e-20, 1e-20, 2.0, 20, pre, x, norm, 1e-20
+
+
+@pytest.mark.mhc_pre_delayed
+def test_mhc_pre_delayed():
+    bench = MHCDelayedBenchmark(
+        op_name="mhc_pre_delayed",
+        torch_op=_reference,
+        gems_op=gems.mhc_pre_delayed,
+        dtypes=[torch.bfloat16],
+    )
+    bench.run()
+
+
+def _collapse_reference(residual, pre_mix=None):
+    value = residual.float()
+    if pre_mix is None:
+        pre_mix = torch.zeros((len(value), 4), device=value.device)
+        pre_mix[:, 0] = 1
+    result = value[:, 0] * pre_mix[:, 0, None] + value[:, 1] * pre_mix[:, 1, None]
+    result = result + value[:, 2] * pre_mix[:, 2, None]
+    result = result + value[:, 3] * pre_mix[:, 3, None]
+    return result.bfloat16()
+
+
+class MHCCollapseBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "tokens, hidden"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [(1, 5120), (8, 5120), (128, 5120), (2048, 5120)]
+
+    def get_input_iter(self, dtype):
+        for n, h in self.shapes:
+            yield (
+                torch.randn((n, 4, h), device=self.device, dtype=dtype),
+                torch.rand((n, 4), device=self.device),
+            )
+
+
+@pytest.mark.mhc_collapse
+def test_mhc_collapse():
+    MHCCollapseBenchmark(
+        op_name="mhc_collapse",
+        torch_op=_collapse_reference,
+        gems_op=gems.mhc_collapse,
+        dtypes=[torch.bfloat16],
+    ).run()
