+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Fixed W8A8 active cases against independent unfused FP32 compositions."""
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from . import base
+
+
+def _quant_reference(x):
+    values = x.float()
+    maximum = values.abs().amax(-1, keepdim=True)
+    scale = maximum / 127
+    inverse = torch.where(
+        maximum == 0, torch.zeros_like(maximum), torch.div(127.0, maximum)
+    )
+    return torch.round(values * inverse).clamp(-128, 127).to(torch.int8), scale, None
+
+
+def _mm_reference(a, b, sa, sb, out_dtype):
+    integer = a.float() @ b.float()
+    return (sa * integer * sb.reshape(1, -1)).to(out_dtype)
+
+
+class QuantBoundaryBenchmark(base.Benchmark):
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [(1, 64), (7, 5120), (128, 5120), (7, 8193), (7, 32768)]
+
+    def get_input_iter(self, dtype):
+        for n, k in self.shapes:
+            yield (torch.randn((n, k), device=self.device, dtype=dtype),)
+
+
+class MMBoundaryBenchmark(base.Benchmark):
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [
+            (3, 35, 70),
+            (1, 1792, 5120),
+            (8, 1792, 5120),
+            (128, 1792, 5120),
+            (1, 25600, 6144),
+            (8, 25600, 6144),
+            (128, 25600, 6144),
+        ]
+
+    def get_input_iter(self, dtype):
+        for m, n, k in self.shapes:
+            yield (
+                torch.randint(-64, 65, (m, k), device=self.device, dtype=dtype),
+                torch.randint(-64, 65, (k, n), device=self.device, dtype=dtype),
+                torch.ones((m, 1), device=self.device) / 128,
+                torch.ones(n, device=self.device) / 128,
+                torch.bfloat16,
+            )
+
+
+@pytest.mark.scaled_int8_quant
+def test_dynamic_quant_boundaries():
+    bench = QuantBoundaryBenchmark(
+        op_name="scaled_int8_quant",
+        torch_op=_quant_reference,
+        gems_op=gems.scaled_int8_quant,
+        dtypes=[torch.bfloat16, torch.float16],
+    )
+    bench.run()
+
+
+@pytest.mark.triton_scaled_mm
+def test_scaled_mm_boundaries():
+    bench = MMBoundaryBenchmark(
+        op_name="triton_scaled_mm",
+        torch_op=_mm_reference,
+        gems_op=gems.triton_scaled_mm,
+        dtypes=[torch.int8],
+    )
+    bench.run()
diff --git a/src/flaggems_vllm/ops/deepseek_v41_candidates.py b/src/flaggems_vllm/ops/deepseek_v41_candidates.py
new file mode 100644
index 0000000..8caf6a0
--- /dev/null
+++ b/src/flaggems_vllm/ops/deepseek_v41_candidates.py
@@ -0,0 +1,403 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+# Copyright 2026 FlagOS Contributors
+"""V4.1 candidate block scores/mask, ported from vLLM e77daef89e18.
+
+The caller owns packed causal bounds and output buffers. Numerical block
+selection uses packed keys for large bounded inputs and public FlagGems ATen
+topk otherwise, with no native Torch fallback.
+"""
+import logging
+
+import torch
+import triton
+import triton.language as tl
+
+from flaggems_vllm import runtime
+from flaggems_vllm.utils import libentry, libtuner
+
+logger = logging.getLogger(__name__)
+
+
+@triton.jit
+def _max_with_nan(a, b):
+    return tl.maximum(a, b, propagate_nan=tl.PropagateNan.ALL)
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("deepseek_v41_candidate_scores"),
+    key=["width", "HAS_STARTS", "ROW_REPEAT"],
+)
+@triton.jit(do_not_specialize=["width", "nblocks"])
+def _block_scores_kernel(
+    logits,
+    starts,
+    ends,
+    scores,
+    stride_row,
+    stride_col,
+    stride_start,
+    stride_end,
+    width,
+    nblocks,
+    BLOCK_SIZE: tl.constexpr,
+    HAS_STARTS: tl.constexpr,
+    ROW_REPEAT: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    blocks = (tl.program_id(1) * TILE + tl.arange(0, TILE)).to(tl.int64)
+    start = tl.load(starts + row // ROW_REPEAT * stride_start) if HAS_STARTS else 0
+    end = tl.load(ends + row // ROW_REPEAT * stride_end)
+    offsets = tl.arange(0, triton.next_power_of_2(BLOCK_SIZE))
+    cols = start + blocks[:, None] * BLOCK_SIZE + offsets[None, :]
+    values = tl.load(
+        logits + row * stride_row + cols * stride_col,
+        (blocks[:, None] < nblocks)
+        & (offsets[None, :] < BLOCK_SIZE)
+        & (cols >= 0)
+        & (cols < end)
+        & (cols < width),
+        other=-float("inf"),
+    )
+    reduced = tl.reduce(values, 1, _max_with_nan)
+    reduced = tl.where(
+        (end > start) & (blocks == (end - start - 1) // BLOCK_SIZE),
+        float("inf"),
+        reduced,
+    )
+    tl.store(scores + row * nblocks + blocks, reduced, blocks < nblocks)
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("deepseek_v41_candidate_store"),
+    key=["OUT_K"],
+    restore_value=["output"],
+)
+@triton.jit(do_not_specialize=["k"])
+def _store_candidates_kernel(
+    values,
+    indices,
+    output,
+    out_stride_row,
+    out_stride_col,
+    k,
+    OUT_K: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    value = tl.load(values + row * k + cols, cols < k, other=-float("inf"))
+    index = tl.load(indices + row * k + cols, cols < k, other=-1)
+    tl.store(
+        output + row * out_stride_row + cols * out_stride_col,
+        tl.where(value > -float("inf"), index, -1),
+        cols < OUT_K,
+    )
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("deepseek_v41_candidate_flags"),
+    key=["K", "HAS_STARTS", "ROW_REPEAT"],
+)
+@triton.jit(do_not_specialize=["width", "nblocks"])
+def _candidate_flags_kernel(
+    candidates,
+    starts,
+    flags,
+    stride_row,
+    stride_col,
+    stride_start,
+    width,
+    nblocks,
+    BLOCK_SIZE: tl.constexpr,
+    K: tl.constexpr,
+    HAS_STARTS: tl.constexpr,
+    ROW_REPEAT: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    offsets = tl.arange(0, 1024)
+    for tile in range(tl.cdiv(nblocks + 1, 1024)):
+        slots = tile * 1024 + offsets
+        tl.store(flags + row * (nblocks + 1) + slots, 0, slots <= nblocks)
+    start = tl.load(starts + row // ROW_REPEAT * stride_start) if HAS_STARTS else 0
+    cols = tl.arange(0, triton.next_power_of_2(max(K, 1)))
+    block = tl.load(
+        candidates + row * stride_row + cols * stride_col, cols < K, other=-1
+    ).to(tl.int64)
+    # Preserve the packed-column clamp for candidates beyond the logits width.
+    block = tl.where(start + block * BLOCK_SIZE >= width, nblocks, block)
+    tl.debug_barrier()
+    tl.store(
+        flags + row * (nblocks + 1) + block,
+        1,
+        (cols < K) & (block >= 0) & (block <= nblocks),
+    )
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("deepseek_v41_candidate_mask"),
+    key=["width", "HAS_STARTS", "ROW_REPEAT"],
+    restore_value=["logits"],
+)
+@triton.jit(do_not_specialize=["width", "nblocks"])
+def _mask_candidates_kernel(
+    logits,
+    starts,
+    ends,
+    flags,
+    stride_row,
+    stride_col,
+    stride_start,
+    stride_end,
+    width,
+    nblocks,
+    BLOCK_SIZE: tl.constexpr,
+    HAS_STARTS: tl.constexpr,
+    ROW_REPEAT: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    start = tl.load(starts + row // ROW_REPEAT * stride_start) if HAS_STARTS else 0
+    end = tl.load(ends + row // ROW_REPEAT * stride_end)
+    valid = (cols >= start) & (cols < end) & (cols < width)
+    # Bounds are caller metadata; mask defensively before every flags read.
+    valid = valid & (start >= 0) & (end <= width)
+    block = (cols - start) // BLOCK_SIZE
+    keep = tl.load(flags + row * (nblocks + 1) + block, valid, other=0)
+    edge = tl.load(flags + row * (nblocks + 1) + nblocks)
+    keep = (keep != 0) | ((cols == width - 1) & (edge != 0))
+    tl.store(
+        logits + row * stride_row + cols * stride_col,
+        -float("inf"),
+        (cols < width) & ~(valid & keep),
+    )
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("deepseek_v41_candidate_packed"),
+    key=["N", "OUT_K"],
+    restore_value=["OUT"],
+)
+@triton.jit
+def _packed_candidate_topk_kernel(
+    SCORES, OUT, STRIDE, N: tl.constexpr, OUT_K: tl.constexpr, BLOCK: tl.constexpr
+):
+    row = tl.program_id(0).to(tl.int64)
+    col = tl.arange(0, BLOCK)
+    value = tl.load(SCORES + row * N + col, col < N, other=-float("inf"))
+    bits = value.to(tl.uint32, bitcast=True)
+    ordered = tl.where((bits & 0x80000000) != 0, ~bits, bits | 0x80000000)
+    # ATen largest-topk places every NaN above +Inf; tie IDs are unspecified.
+    ordered = tl.where(value != value, 0xFFFFFFFF, ordered).to(tl.uint32)
+    ordered = tl.where(col < N, ordered, 0)
+    tie = (0xFFFFFFFF - col.to(tl.uint32)).to(tl.uint64)
+    packed = (ordered.to(tl.uint64) << 32) | tie
+    sorted_keys = tl.sort(packed, descending=True)
+    index = (0xFFFFFFFF - (sorted_keys & 0xFFFFFFFF).to(tl.uint32)).to(tl.int64)
+    selected = tl.load(
+        SCORES + row * N + index, (col < OUT_K) & (index < N), other=-float("inf")
+    )
+    tl.store(
+        OUT + row * STRIDE + col,
+        tl.where(selected > -float("inf"), index, -1),
+        col < OUT_K,
+    )
+
+
+def _check_common(logits, row_ks, row_ke, block_size, row_repeat):
+    if isinstance(block_size, bool) or not isinstance(block_size, int):
+        raise TypeError("block_size must be an integer")
+    if block_size != 8:
+        raise NotImplementedError("V4.1 candidate blocks require block_size=8")
+    if isinstance(row_repeat, bool) or not isinstance(row_repeat, int):
+        raise TypeError("row_repeat must be an integer")
+    if row_repeat <= 0:
+        raise ValueError("row_repeat must be positive")
+    if not isinstance(logits, torch.Tensor) or logits.ndim != 2:
+        raise ValueError("logits must be a matrix")
+    if logits.dtype != torch.float32:
+        raise TypeError("logits must be FP32")
+    if logits.device.type != "cuda":
+        raise NotImplementedError("candidate blocks require accelerator Triton")
+    rows, width = logits.shape
+    if logits.stride(1) != 1 or logits.stride(0) < width:
+        raise ValueError("logits must have contiguous columns and nonoverlapping rows")
+    if triton.cdiv(width, 8) >= 2**31:
+        raise ValueError("block IDs must fit INT32")
+    count = triton.cdiv(rows, row_repeat)
+    for name, value in [("row_ks", row_ks), ("row_ke", row_ke)]:
+        if name == "row_ks" and value is None:
+            continue
+        if not isinstance(value, torch.Tensor) or value.shape != (count,):
+            raise ValueError(f"{name} must have ceil(rows/row_repeat) entries")
+        if value.dtype not in (torch.int32, torch.int64):
+            raise TypeError(f"{name} must be INT32 or INT64")
+        if value.device != logits.device or (count > 1 and value.stride(0) <= 0):
+            raise ValueError(f"{name} must have positive stride on the logits device")
+    return rows, width
+
+
+def _check_matrix(value, shape, logits, name):
+    if not isinstance(value, torch.Tensor) or value.shape != shape:
+        raise ValueError(f"{name} must have shape {shape}")
+    if value.dtype != torch.int32:
+        raise TypeError(f"{name} must be INT32")
+    if (
+        value.device != logits.device
+        or value.stride(1) != 1
+        or value.stride(0) < shape[1]
+    ):
+        raise ValueError(f"{name} must be inner-contiguous on the logits device")
+
+
+def _reject_alias(mutated, inputs):
+    if mutated.numel() and any(
+        tensor is not None
+        and tensor.numel()
+        and tensor.untyped_storage().data_ptr() == mutated.untyped_storage().data_ptr()
+        for tensor in inputs
+    ):
+        raise ValueError("mutated output must not alias inputs")
+
+
+def deepseek_v41_select_candidate_blocks(
+    logits, row_ks, row_ke, topk_blocks, block_size, out, row_repeat=1
+):
+    """Write top block IDs to INT32 [rows,topk_blocks] caller output.
+
+    FP32 logits have contiguous columns and may have padded row stride/offset.
+    Bounds are INT32/64 [ceil(rows/row_repeat)], optionally strided, on the same
+    accelerator. Caller-provided packed bounds satisfy 0 <= start <= end <=
+    width; absent starts mean zero. Select block_size=8 maxima with NaN
+    propagation, pin the newest block to +Inf, and preserve ATen topk's
+    unspecified tie order. Selected NaN/-Inf scores and unused output entries
+    become -1. Empty width fills -1. Inputs are unchanged; out aliases no input.
+    No persistent state, CPU synchronization, or global registration required.
+    """
+    logger.debug("GEMS DEEPSEEK_V41_SELECT_CANDIDATE_BLOCKS")
+    rows, width = _check_common(logits, row_ks, row_ke, block_size, row_repeat)
+    if isinstance(topk_blocks, bool) or not isinstance(topk_blocks, int):
+        raise TypeError("topk_blocks must be an integer")
+    if topk_blocks < 0:
+        raise ValueError("topk_blocks must be nonnegative")
+    _check_matrix(out, (rows, topk_blocks), logits, "out")
+    _reject_alias(out, [logits, row_ks, row_ke])
+    if not rows or not topk_blocks:
+        return out
+    # Resolve the public numerical dependency before any output write.
+    from flag_gems import topk
+
+    nblocks = triton.cdiv(width, block_size)
+    k = min(topk_blocks, nblocks)
+    starts = row_ke if row_ks is None else row_ks
+    with runtime.torch_device_fn.device(logits.device):
+        scores = torch.empty((rows, nblocks), device=logits.device, dtype=torch.float32)
+        if nblocks:
+            _block_scores_kernel[
+                lambda meta: (rows, triton.cdiv(nblocks, meta["TILE"]))
+            ](
+                logits,
+                starts,
+                row_ke,
+                scores,
+                *logits.stride(),
+                row_ks.stride(0) if row_ks is not None else 0,
+                row_ke.stride(0),
+                width,
+                nblocks,
+                block_size,
+                row_ks is not None,
+                row_repeat,
+            )
+        if 1024 < k and nblocks <= 8192 and topk_blocks <= 8192:
+            _packed_candidate_topk_kernel[(rows,)](
+                scores,
+                out,
+                out.stride(0),
+                nblocks,
+                topk_blocks,
+                triton.next_power_of_2(max(nblocks, topk_blocks)),
+            )
+            return out
+        if k:
+            values, indices = topk(scores, k, dim=-1)
+        else:
+            values = scores
+            indices = torch.empty((rows, 0), device=logits.device, dtype=torch.int64)
+        _store_candidates_kernel[
+            lambda meta: (rows, triton.cdiv(topk_blocks, meta["TILE"]))
+        ](
+            values,
+            indices,
+            out,
+            *out.stride(),
+            k,
+            topk_blocks,
+        )
+    return out
+
+
+def deepseek_v41_apply_candidate_mask(
+    logits, row_ks, row_ke, candidate_blocks, block_size, row_repeat=1
+):
+    """Set noncandidate or noncausal FP32 logits to -Inf in place; return logits.
+
+    Bounds/layout/device match select_candidate_blocks. Candidates are INT32
+    [rows,K] local block IDs with contiguous columns, padded row stride allowed.
+    Negative IDs are ignored. Positive IDs beyond width retain the upstream
+    packed-column edge clamp: the last column is retained if causally valid.
+    Duplicates are allowed. No input aliases logits. Autotune restores logits;
+    per-call flags are fully initialized, with no cross-call/stream state.
+    """
+    logger.debug("GEMS DEEPSEEK_V41_APPLY_CANDIDATE_MASK")
+    rows, width = _check_common(logits, row_ks, row_ke, block_size, row_repeat)
+    if not isinstance(candidate_blocks, torch.Tensor) or candidate_blocks.ndim != 2:
+        raise ValueError("candidate_blocks must be a matrix")
+    _check_matrix(
+        candidate_blocks, (rows, candidate_blocks.shape[1]), logits, "candidate_blocks"
+    )
+    _reject_alias(logits, [row_ks, row_ke, candidate_blocks])
+    if not rows or not width:
+        return logits
+    nblocks = triton.cdiv(width, block_size)
+    starts = row_ke if row_ks is None else row_ks
+    with runtime.torch_device_fn.device(logits.device):
+        flags = torch.empty(
+            (rows, nblocks + 1), device=logits.device, dtype=torch.uint8
+        )
+        _candidate_flags_kernel[(rows,)](
+            candidate_blocks,
+            starts,
+            flags,
+            *candidate_blocks.stride(),
+            row_ks.stride(0) if row_ks is not None else 0,
+            width,
+            nblocks,
+            block_size,
+            candidate_blocks.shape[1],
+            row_ks is not None,
+            row_repeat,
+        )
+        _mask_candidates_kernel[lambda meta: (rows, triton.cdiv(width, meta["TILE"]))](
+            logits,
+            starts,
+            row_ke,
+            flags,
+            *logits.stride(),
+            row_ks.stride(0) if row_ks is not None else 0,
+            row_ke.stride(0),
+            width,
+            nblocks,
+            block_size,
+            row_ks is not None,
+            row_repeat,
+        )
+    return logits
