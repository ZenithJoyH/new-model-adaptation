+++ b/src/flaggems_vllm/ops/engram.py
@@ -0,0 +1,331 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Copyright 2026 FlagOS Contributors
+"""V4.1 n-gram hashes, INT8 table lookup and FP32 Engram gating.
+
+Hash/gate mathematics follows vLLM e77daef89e18 (unchanged at 43067f6df60e).
+Request-history construction belongs to the caller. Table storage stays INT8
+with one FP32 scale per row, as in the target W8A8 checkpoint.
+"""
+
+import logging
+import math
+
+import torch
+import triton
+import triton.language as tl
+
+from flaggems_vllm import runtime
+from flaggems_vllm.utils import libentry, libtuner
+
+logger = logging.getLogger(__name__)
+
+
+def _validate(tensor, shape, dtype, device, name, contiguous=True):
+    if tensor.shape != shape:
+        raise ValueError(f"{name} must have shape {shape}")
+    if tensor.dtype not in dtype:
+        raise TypeError(f"{name} has an unsupported dtype")
+    if tensor.device != device:
+        raise ValueError(f"{name} must share the input device")
+    if contiguous and not tensor.is_contiguous():
+        raise ValueError(f"{name} must be contiguous")
+
+
+def _require_gpu(tensor):
+    if tensor.device.type != "cuda":
+        raise NotImplementedError("Engram currently requires CUDA-compatible tensors")
+
+
+@libentry()
+@libtuner(configs=runtime.get_tuned_config("engram_ngram_hash"), key=["N", "LAYERS"])
+@triton.jit
+def _hash_kernel(
+    HISTORY,
+    MAP,
+    MULT,
+    PRIME,
+    OFFSET,
+    OUT,
+    N,
+    LAYERS: tl.constexpr,
+    VOCAB: tl.constexpr,
+    PAD: tl.constexpr,
+    BLOCK_T: tl.constexpr,
+):
+    token = (tl.program_id(0) * BLOCK_T + tl.arange(0, BLOCK_T)).to(tl.int64)
+    layer = tl.program_id(1)
+    head = tl.arange(0, 8)
+    valid = token < N
+    blocked = tl.full((BLOCK_T,), False, tl.int1)
+    rolling = tl.full((BLOCK_T,), 0, tl.int64)
+    for shift in tl.static_range(4):
+        raw = tl.load(HISTORY + token * 4 + shift, valid, other=-1).to(tl.int64)
+        known = valid & (raw >= 0) & (raw < VOCAB)
+        compressed = tl.load(MAP + raw, known, other=PAD).to(tl.int64)
+        blocked |= ~known
+        value = tl.where(blocked, PAD, compressed)
+        multiplier = tl.load(MULT + layer * 4 + shift)
+        rolling ^= value * multiplier
+        if shift > 0:
+            column = (shift - 1) * 8 + head
+            prime = tl.load(PRIME + layer * 24 + column)
+            offset = tl.load(OFFSET + layer * 24 + column)
+            hashed = rolling[:, None] % prime[None, :] + offset[None, :]
+            address = ((token * LAYERS + layer) * 24)[:, None] + column[None, :]
+            tl.store(OUT + address, hashed, valid[:, None])
+
+
+def engram_ngram_hash(history_ids, token_map, multipliers, primes, offsets, pad_id):
+    """Return INT32 [N,L,24] hashes from raw current-to-past history [N,4].
+
+    Negative/out-of-vocabulary raw ids terminate the n-gram: that position
+    and all older positions use pad_id. Primes are positive; multipliers
+    and compressed ids are nonnegative and their products must fit INT64.
+    The caller validates this fixed model layout before device transfer.
+    No inputs are modified; no history/cache is retained between calls.
+    """
+    logger.debug("GEMS ENGRAM_NGRAM_HASH")
+    _require_gpu(history_ids)
+    if history_ids.ndim != 2 or history_ids.shape[1] != 4:
+        raise ValueError("history_ids must be [N,4]")
+    n = history_ids.shape[0]
+    if token_map.ndim != 1 or token_map.numel() == 0:
+        raise ValueError("token_map must be a nonempty vector")
+    if multipliers.ndim != 2 or multipliers.shape[1] != 4 or multipliers.shape[0] == 0:
+        raise ValueError("multipliers must be [positive layers,4]")
+    layers = multipliers.shape[0]
+    device = history_ids.device
+    for tensor, shape, dtype, name in [
+        (history_ids, (n, 4), (torch.int32, torch.int64), "history_ids"),
+        (token_map, (token_map.numel(),), (torch.int32,), "token_map"),
+        (multipliers, (layers, 4), (torch.int64,), "multipliers"),
+        (primes, (layers, 3, 8), (torch.int64,), "primes"),
+        (offsets, (layers, 24), (torch.int64,), "offsets"),
+    ]:
+        _validate(tensor, shape, dtype, device, name)
+    if (
+        not isinstance(pad_id, int)
+        or isinstance(pad_id, bool)
+        or not 0 <= pad_id < 2**31
+    ):
+        raise ValueError("pad_id must be a nonnegative INT32 compressed id")
+    with runtime.torch_device_fn.device(device):
+        output = torch.empty((n, layers, 24), device=device, dtype=torch.int32)
+        if n:
+            _hash_kernel[lambda meta: (triton.cdiv(n, meta["BLOCK_T"]), layers)](
+                history_ids,
+                token_map,
+                multipliers,
+                primes,
+                offsets,
+                output,
+                n,
+                layers,
+                token_map.numel(),
+                pad_id,
+            )
+    return output
+
+
+@libentry()
+@libtuner(
+    configs=runtime.get_tuned_config("engram_embedding_int8"), key=["D", "LOCAL_HEADS"]
+)
+@triton.jit
+def _lookup_kernel(
+    W,
+    SCALE,
+    IDS,
+    OUT,
+    N,
+    ROWS,
+    STRIDE_T,
+    STRIDE_H,
+    D: tl.constexpr,
+    LOCAL_HEADS: tl.constexpr,
+    HEAD_START: tl.constexpr,
+    VOCAB_START: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+):
+    row = (tl.program_id(0) * BLOCK_R + tl.arange(0, BLOCK_R)).to(tl.int64)
+    token = row // LOCAL_HEADS
+    head = HEAD_START + row % LOCAL_HEADS
+    valid = token < N
+    index = tl.load(IDS + token * STRIDE_T + head * STRIDE_H, valid, other=-1).to(
+        tl.int64
+    )
+    owned = valid & (index >= VOCAB_START) & (index < VOCAB_START + ROWS)
+    local = tl.where(owned, index - VOCAB_START, 0)
+    extent: tl.constexpr = triton.next_power_of_2(D)
+    col = tl.arange(0, extent)
+    value = tl.load(
+        W + local[:, None] * D + col[None, :],
+        owned[:, None] & (col[None, :] < D),
+        other=0,
+    ).to(tl.float32)
+    scale = tl.load(SCALE + local, owned, other=0)
+    tl.store(
+        OUT + row[:, None] * D + col[None, :],
+        value * scale[:, None],
+        valid[:, None] & (col[None, :] < D),
+    )
+
+
+def engram_embedding_int8(
+    weight, weight_scale, hash_ids, head_start, local_heads, vocab_start
+):
+    """Return fresh BF16 [N,local_heads,D] rows from this rank's INT8 table.
+
+    weight is [rows,D], scale FP32 [rows,1], hash_ids INT32/INT64 [N,heads]
+    (positive strides permitted). A hash outside this shard writes zero.
+    Head indices name consecutive complete buckets; table offsets use
+    INT64 even when the local table has more than 2**31 elements.
+    No inputs are modified; the caller owns any persistent staging copy.
+    """
+    logger.debug("GEMS ENGRAM_EMBEDDING_INT8")
+    _require_gpu(weight)
+    if weight.ndim != 2 or weight.shape[1] <= 0:
+        raise ValueError("weight must be [rows,positive head_dim]")
+    if hash_ids.ndim != 2:
+        raise ValueError("hash_ids must be [N,heads]")
+    if any(
+        not isinstance(v, int) or isinstance(v, bool)
+        for v in (head_start, local_heads, vocab_start)
+    ):
+        raise TypeError("Engram shard coordinates must be integers")
+    if (
+        head_start < 0
+        or local_heads <= 0
+        or head_start + local_heads > hash_ids.shape[1]
+        or vocab_start < 0
+    ):
+        raise ValueError("Invalid Engram head or vocabulary shard")
+    rows, dim = weight.shape
+    n = hash_ids.shape[0]
+    device = weight.device
+    _validate(weight, (rows, dim), (torch.int8,), device, "weight")
+    _validate(weight_scale, (rows, 1), (torch.float32,), device, "weight_scale")
+    _validate(
+        hash_ids, hash_ids.shape, (torch.int32, torch.int64), device, "hash_ids", False
+    )
+    if any(s <= 0 for s in hash_ids.stride()) and n:
+        raise ValueError("hash_ids must have positive strides")
+    with runtime.torch_device_fn.device(device):
+        output = torch.empty((n, local_heads, dim), device=device, dtype=torch.bfloat16)
+        if n:
+            _lookup_kernel[
+                lambda meta: (triton.cdiv(n * local_heads, meta["BLOCK_R"]),)
+            ](
+                weight,
+                weight_scale,
+                hash_ids,
+                output,
+                n,
+                rows,
+                *hash_ids.stride(),
+                dim,
+                local_heads,
+                head_start,
+                vocab_start,
+            )
+    return output
+
+
+@libentry()
+@libtuner(configs=runtime.get_tuned_config("engram_gated_add"), key=["H"])
+@triton.jit
+def _gate_kernel(
+    HIDDEN,
+    KV,
+    QW,
+    KW,
+    MASK,
+    OUT,
+    H: tl.constexpr,
+    EPS: tl.constexpr,
+    MINIMUM: tl.constexpr,
+    HAS_MASK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    token = row // 4
+    stream = row % 4
+    extent: tl.constexpr = triton.next_power_of_2(H)
+    d = tl.arange(0, extent)
+    valid = d < H
+    hidden = tl.load(HIDDEN + row * H + d, valid, other=0).to(tl.float32)
+    key = tl.load(KV + token * 5 * H + stream * H + d, valid, other=0).to(tl.float32)
+    q = tl.load(QW + stream * H + d, valid, other=0).to(tl.float32)
+    k = tl.load(KW + stream * H + d, valid, other=0).to(tl.float32)
+    hidden_rms = tl.rsqrt(tl.sum(hidden * hidden, 0) / H + EPS)
+    key_rms = tl.rsqrt(tl.sum(key * key, 0) / H + EPS)
+    dot = tl.sum(hidden * (q * k) * key, 0) * hidden_rms * key_rms * tl.rsqrt(H * 1.0)
+    magnitude = tl.sqrt(
+        tl.maximum(tl.abs(dot), MINIMUM, propagate_nan=tl.PropagateNan.ALL)
+    )
+    # Torch sum starts from +0 even for a singleton -0 product; match
+    # that reduction boundary before applying the signed square root.
+    negative = dot < 0
+    gate = tl.sigmoid(tl.where(negative, -magnitude, magnitude))
+    if HAS_MASK:
+        active = tl.load(MASK + token)
+        gate = tl.where(active, gate, 0.0)
+    value = tl.load(KV + token * 5 * H + 4 * H + d, valid, other=0).to(tl.float32)
+    tl.store(OUT + row * H + d, hidden + gate * value, valid)
+
+
+def engram_gated_add(
+    hidden_states, kv, q_weight, k_weight, eps=1e-20, clamp_value=1e-6, token_mask=None
+):
+    """Return fresh BF16 residuals using per-HC FP32 normalized gate scores.
+
+    hidden=[N,4,H], kv=[N,5H], q/k_weight=[4,H] are contiguous BF16.
+    Optional BOOL [N] token_mask zeros the gate; ordinary IEEE nonfinite
+    propagation still applies to value multiplication. Scalars are finite,
+    eps positive and clamp_value nonnegative. No input/state is modified.
+    """
+    logger.debug("GEMS ENGRAM_GATED_ADD")
+    _require_gpu(hidden_states)
+    if (
+        hidden_states.ndim != 3
+        or hidden_states.shape[1] != 4
+        or hidden_states.shape[2] <= 0
+    ):
+        raise ValueError("hidden_states must be [N,4,positive hidden]")
+    n, _, hidden = hidden_states.shape
+    device = hidden_states.device
+    for tensor, shape, name in [
+        (hidden_states, (n, 4, hidden), "hidden_states"),
+        (kv, (n, 5 * hidden), "kv"),
+        (q_weight, (4, hidden), "q_weight"),
+        (k_weight, (4, hidden), "k_weight"),
+    ]:
+        _validate(tensor, shape, (torch.bfloat16,), device, name)
+    if token_mask is not None:
+        _validate(token_mask, (n,), (torch.bool,), device, "token_mask")
+    for value, name in [(eps, "eps"), (clamp_value, "clamp_value")]:
+        if (
+            isinstance(value, bool)
+            or not isinstance(value, (int, float))
+            or not math.isfinite(value)
+        ):
+            raise ValueError(f"{name} must be a finite real scalar")
+    if eps <= 0 or clamp_value < 0:
+        raise ValueError("Engram requires positive eps and nonnegative clamp_value")
+    with runtime.torch_device_fn.device(device):
+        output = torch.empty_like(hidden_states)
+        if n:
+            _gate_kernel[(n * 4,)](
+                hidden_states,
+                kv,
+                q_weight,
+                k_weight,
+                token_mask if token_mask is not None else hidden_states,
+                output,
+                hidden,
+                eps,
+                clamp_value,
+                token_mask is not None,
+                enable_fp_fusion=False,
+            )
+    return output
diff --git a/src/flaggems_vllm/ops/mhc_pre_delayed.py b/src/flaggems_vllm/ops/mhc_pre_delayed.py
new file mode 100644
index 0000000..b1562e5
--- /dev/null
+++ b/src/flaggems_vllm/ops/mhc_pre_delayed.py
@@ -0,0 +1,241 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""DeepSeek V4.1 delayed mHC, aligned with vLLM e77daef89e18.
+
+The projection stays FP32. The previous sublayer's pre-mix collapses the
+residual, with a BF16 materialization boundary before optional RMSNorm.
+"""
+
+import logging
+
+import flag_gems
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+from flaggems_vllm import runtime
+from flaggems_vllm.ops.data_movement import contiguous_copy
+from flaggems_vllm.ops.mhc_with_norm import mhc_rms_norm
+from flaggems_vllm.utils import libentry, libtuner
+
+logger = logging.getLogger(__name__)
+
+
+@libentry()
+@libtuner(configs=runtime.get_tuned_config("mhc_pre_delayed_coeff"), key=["K"])
+@triton.jit
+def _coeff_kernel(
+    X,
+    MIX,
+    SCALE,
+    BASE,
+    POST,
+    COMB,
+    NEXT,
+    K: tl.constexpr,
+    RMS_EPS: tl.constexpr,
+    PRE_EPS: tl.constexpr,
+    SINK_EPS: tl.constexpr,
+    POST_MULT: tl.constexpr,
+    REPEATS: tl.constexpr,
+):
+    row = tl.program_id(0)
+    extent: tl.constexpr = triton.next_power_of_2(K)
+    k = tl.arange(0, extent)
+    x = tl.load(X + row * K + k, k < K, other=0).to(tl.float32)
+    inv = tl.rsqrt(tl.sum(x * x, 0) / K + RMS_EPS)
+    h = tl.arange(0, 4)
+    pre = tl.load(MIX + row * 24 + h) * inv * tl.load(SCALE) + tl.load(BASE + h)
+    post = tl.load(MIX + row * 24 + 4 + h) * inv * tl.load(SCALE + 1) + tl.load(
+        BASE + 4 + h
+    )
+    tl.store(NEXT + row * 4 + h, tl.sigmoid(pre) + PRE_EPS)
+    tl.store(POST + row * 4 + h, tl.sigmoid(post) * POST_MULT)
+    r = h[:, None]
+    c = h[None, :]
+    idx = 8 + r * 4 + c
+    comb = tl.load(MIX + row * 24 + idx) * inv * tl.load(SCALE + 2) + tl.load(
+        BASE + idx
+    )
+    comb = tl.exp(comb - tl.max(comb, 1)[:, None])
+    comb = comb / tl.sum(comb, 1)[:, None] + SINK_EPS
+    comb = comb / (tl.sum(comb, 0)[None, :] + SINK_EPS)
+    for _ in range(REPEATS - 1):
+        comb = comb / (tl.sum(comb, 1)[:, None] + SINK_EPS)
+        comb = comb / (tl.sum(comb, 0)[None, :] + SINK_EPS)
+    tl.store(COMB + row * 16 + r * 4 + c, comb)
+
+
+@libentry()
+@libtuner(configs=runtime.get_tuned_config("mhc_pre_delayed_collapse"), key=["H"])
+@triton.jit
+def _collapse_kernel(
+    R,
+    PRE,
+    OUT,
+    H: tl.constexpr,
+    HAS_PRE: tl.constexpr,
+    BLOCK: tl.constexpr,
+    METAX_RN: tl.constexpr = False,
+):
+    row = tl.program_id(0)
+    d = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = d < H
+    a = tl.load(R + row * 4 * H + d, mask, other=0).to(tl.float32)
+    b = tl.load(R + row * 4 * H + H + d, mask, other=0).to(tl.float32)
+    c = tl.load(R + row * 4 * H + 2 * H + d, mask, other=0).to(tl.float32)
+    e = tl.load(R + row * 4 * H + 3 * H + d, mask, other=0).to(tl.float32)
+    if HAS_PRE:
+        p0 = tl.load(PRE + row * 4)
+        p1 = tl.load(PRE + row * 4 + 1)
+        p2 = tl.load(PRE + row * 4 + 2)
+        p3 = tl.load(PRE + row * 4 + 3)
+    else:
+        p0, p1, p2, p3 = 1.0, 0.0, 0.0, 0.0
+    if METAX_RN:
+        # The current MetaX compilation path contracts ordinary mul/add even
+        # with enable_fp_fusion=False. RN intrinsics preserve each FP32 step.
+        value = libdevice.add_rn(libdevice.mul_rn(a, p0), libdevice.mul_rn(b, p1))
+        value = libdevice.add_rn(value, libdevice.mul_rn(c, p2))
+        value = libdevice.add_rn(value, libdevice.mul_rn(e, p3))
+    else:
+        value = ((a * p0 + b * p1) + c * p2) + e * p3
+    tl.store(OUT + row * H + d, value, mask)
+
+
+def mhc_pre_delayed(
+    residual,
+    fn,
+    hc_scale,
+    hc_base,
+    rms_eps,
+    hc_pre_eps,
+    hc_sinkhorn_eps,
+    hc_post_mult_value,
+    sinkhorn_repeat,
+    pre_mix=None,
+    x=None,
+    norm_weight=None,
+    norm_eps=1e-6,
+):
+    """Return post, residual mix, BF16 layer input and next FP32 pre-mix.
+
+    This forward-only API supports four BF16 residual streams. It does not
+    mutate inputs or retain workspace. Caller-owned input lifetimes and stream
+    dependencies must extend through consumption of all returned tensors.
+    """
+    logger.debug("GEMS MHC_PRE_DELAYED")
+    if residual.ndim != 3 or residual.dtype != torch.bfloat16:
+        raise ValueError("residual must be BF16 [tokens, 4, hidden]")
+    n, hc, hidden = residual.shape
+    if hc != 4 or residual.device.type != "cuda":
+        raise NotImplementedError("delayed mHC requires four streams on a GPU")
+    if hidden <= 0 or not residual.is_contiguous():
+        raise ValueError("residual must be contiguous with positive hidden size")
+    if not isinstance(sinkhorn_repeat, int) or sinkhorn_repeat < 1:
+        raise ValueError("sinkhorn_repeat must be a positive integer")
+    if x is None:
+        x = residual.view(n, hc * hidden)
+    if x.ndim != 2 or x.shape[0] != n or x.shape[1] <= 0:
+        raise ValueError("x must have shape [tokens, positive input_size]")
+    k = x.shape[1]
+    tensors = [
+        (x, (n, k), torch.bfloat16, "x"),
+        (fn, (24, k), torch.float32, "fn"),
+        (hc_scale, (3,), torch.float32, "hc_scale"),
+        (hc_base, (24,), torch.float32, "hc_base"),
+    ]
+    if pre_mix is not None:
+        tensors.append((pre_mix, (n, 4), torch.float32, "pre_mix"))
+    if norm_weight is not None:
+        tensors.append((norm_weight, (hidden,), torch.bfloat16, "norm_weight"))
+    for tensor, shape, dtype, name in tensors:
+        if (
+            tensor.shape != shape
+            or tensor.dtype != dtype
+            or tensor.device != residual.device
+        ):
+            raise ValueError(f"{name} shape, dtype or device mismatch")
+    for tensor, name in [(x, "x"), (pre_mix, "pre_mix"), (norm_weight, "norm_weight")]:
+        if tensor is not None and not tensor.is_contiguous():
+            raise ValueError(f"{name} must be contiguous")
+    with runtime.torch_device_fn.device(residual.device):
+        post = torch.empty((n, 4, 1), device=residual.device, dtype=torch.float32)
+        comb = torch.empty((n, 4, 4), device=residual.device, dtype=torch.float32)
+        next_pre = torch.empty((n, 4), device=residual.device, dtype=torch.float32)
+        value = torch.empty((n, hidden), device=residual.device, dtype=torch.bfloat16)
+        if n == 0:
+            return post, comb, value, next_pre
+        projection_input = contiguous_copy(x, torch.float32)
+        fn = contiguous_copy(fn)
+        mixes = flag_gems.mm(projection_input, fn.transpose(0, 1))
+        scales, base = map(contiguous_copy, (hc_scale, hc_base))
+        _coeff_kernel[(n,)](
+            x,
+            mixes,
+            scales,
+            base,
+            post,
+            comb,
+            next_pre,
+            k,
+            rms_eps,
+            hc_pre_eps,
+            hc_sinkhorn_eps,
+            hc_post_mult_value,
+            sinkhorn_repeat,
+            enable_fp_fusion=False,
+        )
+        _collapse_kernel[lambda meta: (n, triton.cdiv(hidden, meta["BLOCK"]))](
+            residual,
+            pre_mix if pre_mix is not None else next_pre,
+            value,
+            hidden,
+            pre_mix is not None,
+            METAX_RN=runtime.device.vendor_name == "metax",
+            enable_fp_fusion=False,
+        )
+        value = mhc_rms_norm(value, norm_weight, norm_eps)
+    return post, comb, value, next_pre
+
+
+def mhc_collapse(residual, pre_mix=None):
+    """Return fresh BF16 [N,H] from four BF16 streams and FP32 [N,4] mix.
+
+    Both inputs are contiguous and share one CUDA-compatible device; H is
+    positive and N may be zero. None uses coefficients (1,0,0,0), preserving
+    ordinary IEEE multiplication/addition even for nonfinite residuals.
+    Four products accumulate sequentially in FP32 before BF16 output. No
+    inputs are modified; no buffers, streams or cross-call state are retained.
+    """
+    logger.debug("GEMS MHC_COLLAPSE")
+    if residual.ndim != 3 or residual.dtype != torch.bfloat16:
+        raise ValueError("residual must be BF16 [tokens,4,hidden]")
+    n, hc, hidden = residual.shape
+    if hc != 4 or hidden <= 0 or not residual.is_contiguous():
+        raise ValueError("residual must be contiguous [tokens,4,positive hidden]")
+    if residual.device.type != "cuda":
+        raise NotImplementedError("mHC collapse requires a CUDA-compatible device")
+    if pre_mix is not None and (
+        pre_mix.shape != (n, 4)
+        or pre_mix.dtype != torch.float32
+        or pre_mix.device != residual.device
+        or not pre_mix.is_contiguous()
+    ):
+        raise ValueError(
+            "pre_mix must be contiguous FP32 [tokens,4] on the same device"
+        )
+    with runtime.torch_device_fn.device(residual.device):
+        output = torch.empty((n, hidden), device=residual.device, dtype=torch.bfloat16)
+        if n:
+            _collapse_kernel[lambda meta: (n, triton.cdiv(hidden, meta["BLOCK"]))](
+                residual,
+                pre_mix if pre_mix is not None else residual,
+                output,
+                hidden,
+                pre_mix is not None,
+                METAX_RN=runtime.device.vendor_name == "metax",
+                enable_fp_fusion=False,
+            )
+    return output
