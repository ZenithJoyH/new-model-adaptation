+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Independent CPU reference, public dispatch, boundary and graph tests."""
+import math
+
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = [
+    pytest.mark.deepseek_v41_select_candidate_blocks,
+    pytest.mark.deepseek_v41_apply_candidate_mask,
+]
+
+
+def _reference(raw, starts, ends, k, repeat):
+    rows, width = raw.shape
+    scores = torch.full((rows, math.ceil(width / 8)), -float("inf"))
+    for r in range(rows):
+        a = int(starts[r // repeat]) if starts is not None else 0
+        b = int(ends[r // repeat])
+        for j in range(scores.shape[1]):
+            lo, hi = a + j * 8, min(a + (j + 1) * 8, b, width)
+            if lo < hi:
+                scores[r, j] = raw[r, lo:hi].max()
+        if b > a:
+            scores[r, (b - a - 1) // 8] = float("inf")
+    out = torch.full((rows, k), -1, dtype=torch.int32)
+    n = min(k, scores.shape[1])
+    if n:
+        values, indices = scores.topk(n, -1)
+        out[:, :n] = torch.where(values > -float("inf"), indices.int(), -1)
+    return out
+
+
+def _mask(raw, starts, ends, selected, repeat):
+    out = raw.clone()
+    for r in range(raw.shape[0]):
+        a = int(starts[r // repeat]) if starts is not None else 0
+        b = int(ends[r // repeat])
+        chosen = set(int(j) for j in selected[r] if j >= 0)
+        edge = any(a + j * 8 >= raw.shape[1] for j in chosen)
+        for c in range(raw.shape[1]):
+            if not (
+                a <= c < b
+                and ((c - a) // 8 in chosen or (c == raw.shape[1] - 1 and edge))
+            ):
+                out[r, c] = -float("inf")
+    return out
+
+
+def _padded(value):
+    rows, width = value.shape
+    storage = torch.full(
+        (rows + 1, width + 7), -19, device=value.device, dtype=value.dtype
+    )
+    out = storage[1:, 1 : width + 1]
+    out.copy_(value)
+    return out, storage
+
+
+@pytest.mark.parametrize(
+    "width,k,repeat", [(1, 4, 1), (17, 4, 2), (513, 12, 1), (50000, 2048, 2)]
+)
+@pytest.mark.parametrize("has_starts", [False, True])
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+def test_public_reference_nonzero_offsets_padded_rows_and_strided_bounds(
+    width, k, repeat, has_starts, dtype
+):
+    rows, n = 3, math.ceil(3 / repeat)
+    gen = torch.Generator().manual_seed(992 + width)
+    raw = torch.stack(
+        [torch.randperm(width, generator=gen).float() for _ in range(rows)]
+    )
+    starts = (
+        torch.tensor([min(3 * r, width) for r in range(n)], dtype=dtype)
+        if has_starts
+        else None
+    )
+    ends = torch.tensor(
+        [max(int(starts[r]) if starts is not None else 0, width - r) for r in range(n)],
+        dtype=dtype,
+    )
+    x, storage = _padded(raw.cuda())
+    before = storage.clone()
+    out, backing = _padded(
+        torch.full((rows, k), -777, device="cuda", dtype=torch.int32)
+    )
+    output_before = backing.clone()
+    s = starts.cuda() if starts is not None else None
+    if s is not None:
+        ss = torch.empty(n * 2, device="cuda", dtype=dtype)
+        ss[::2] = s
+        s = ss[::2]
+    e = ends.cuda()
+    assert gems.deepseek_v41_select_candidate_blocks(x, s, e, k, 8, out, repeat) is out
+    expected = _reference(raw, starts, ends, k, repeat)
+    torch.testing.assert_close(out.cpu(), expected, rtol=0, atol=0)
+    torch.testing.assert_close(storage, before, rtol=0, atol=0)
+    output_before[1:, 1 : k + 1] = out
+    torch.testing.assert_close(backing, output_before, rtol=0, atol=0)
+    assert gems.deepseek_v41_apply_candidate_mask(x, s, e, out, 8, repeat) is x
+    torch.testing.assert_close(
+        x.cpu(), _mask(raw, starts, ends, expected, repeat), rtol=0, atol=0
+    )
+    before[1:, 1 : width + 1] = x
+    torch.testing.assert_close(storage, before, rtol=0, atol=0)
+
+
+def test_actual_public_flaggems_topk_and_nonfinite_behavior(monkeypatch):
+    import flag_gems
+
+    original, calls = flag_gems.topk, []
+
+    def observed(*args, **kwargs):
+        calls.append((args[0].shape, args[1]))
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(flag_gems, "topk", observed)
+    raw = torch.full((1, 48), -float("inf"))
+    raw[:, 8:16], raw[:, 24:32], raw[:, 32:40] = float("nan"), float("inf"), 2
+    ends = torch.tensor([48], dtype=torch.int32)
+    out = torch.empty((1, 4), device="cuda", dtype=torch.int32)
+    gems.deepseek_v41_select_candidate_blocks(raw.cuda(), None, ends.cuda(), 4, 8, out)
+    expected = _reference(raw, None, ends, 4, 1)
+    torch.testing.assert_close(
+        out.cpu().sort(-1).values, expected.sort(-1).values, rtol=0, atol=0
+    )
+    assert calls == [(torch.Size([1, 6]), 4)]
+
+
+@pytest.mark.parametrize("k", [0, 1, 7])
+def test_tie_order_unspecified_but_pin_latest_and_no_duplicate_selection(k):
+    x = torch.ones((2, 80), device="cuda")
+    e = torch.tensor([80, 0], device="cuda", dtype=torch.int32)
+    out = torch.empty((2, k), device="cuda", dtype=torch.int32)
+    gems.deepseek_v41_select_candidate_blocks(x, None, e, k, 8, out)
+    got = out.cpu()
+    if k:
+        assert 9 in got[0].tolist()
+        assert len(set(got[0].tolist())) == k
+        assert all(0 <= b < 10 for b in got[0].tolist())
+        assert (got[1] == -1).all()
+
+
+@pytest.mark.parametrize("width,rows,k", [(0, 2, 4), (17, 0, 4), (17, 2, 0)])
+def test_empty_rows_width_or_candidates(width, rows, k):
+    x = torch.empty((rows, width), device="cuda")
+    e = torch.full((rows,), width, device="cuda", dtype=torch.int32)
+    out = torch.full((rows, k), -777, device="cuda", dtype=torch.int32)
