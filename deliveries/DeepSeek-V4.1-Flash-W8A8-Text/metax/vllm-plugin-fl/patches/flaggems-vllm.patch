+def _activation_reference(x, alpha, beta, limit):
+    gate, up = x.cpu().double().chunk(2, -1)
+    gate = gate.clamp(max=limit)
+    up = up.clamp(-limit, limit)
+    return (gate * torch.sigmoid(alpha * gate) * (up + beta)).to(x.dtype)
