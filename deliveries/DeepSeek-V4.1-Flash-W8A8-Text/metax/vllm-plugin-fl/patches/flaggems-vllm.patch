+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Native Benchmark: matched BF16 roundtrips and caller-owned paged cache."""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+from . import base
+
+
+def _reference(k, positions, rope, weight, eps, cache, slots):
+    value = k.float()
+    value = (
+        (
+            value
+            * torch.rsqrt(value.square().mean(-1, keepdim=True) + eps)
+            * weight.float()
+        )
+        .bfloat16()
+        .float()
+    )
+    selected = rope[positions.long()].float()
+    even, odd = value[:, 64::2].clone(), value[:, 65::2].clone()
+    value[:, 64::2] = even * selected[:, :32] - odd * selected[:, 32:]
+    value[:, 65::2] = odd * selected[:, :32] + even * selected[:, 32:]
+    value = value.bfloat16().float()
+    scale = torch.exp2(
+        torch.ceil(torch.log2(value.abs().amax(-1, keepdim=True).clamp(min=1e-4) / 448))
+    )
+    quant = (value / scale).to(torch.float8_e4m3fn).view(torch.uint8)
+    page, row = slots // cache.shape[1], slots % cache.shape[1]
+    flat = cache.view(cache.shape[0], -1)
+    flat[
+        page[:, None], row[:, None] * 128 + torch.arange(128, device=k.device)[None]
+    ] = quant
+    flat[
+        page[:, None],
+        cache.shape[1] * 128
+        + row[:, None] * 4
+        + torch.arange(4, device=k.device)[None],
+    ] = scale.view(torch.uint8)
+    return None
+
+
+class IndexStoreBenchmark(base.Benchmark):
+    DEFAULT_SHAPE_DESC = "rows, physical block size"
+
+    def set_shapes(self, shape_file_path=None):
+        self.shapes = [(1, 32), (8, 32), (128, 64), (2048, 32)]
+
+    def get_input_iter(self, dtype):
+        for rows, block in self.shapes:
+            x = torch.randn((rows, 128), device=self.device, dtype=dtype)
+            positions = torch.arange(rows, device=self.device, dtype=torch.int64) * 2
+            angles = torch.arange(rows * 2, device=self.device).float()[:, None] / (
+                torch.arange(32, device=self.device).float()[None] + 7
+            )
+            rope = torch.cat((angles.cos(), angles.sin()), -1)
+            weight = torch.randn(128, device=self.device, dtype=dtype)
+            cache = torch.empty(
+                ((rows + block - 1) // block, block, 132),
+                device=self.device,
+                dtype=torch.uint8,
+            )
+            slots = torch.arange(rows, device=self.device, dtype=torch.int64)
+            yield x, positions, rope, weight, 1e-6, cache, slots
+
+
+@pytest.mark.deepseek_v41_indexer_k_store
+def test_deepseek_v41_indexer_k_store():
+    IndexStoreBenchmark(
+        op_name="deepseek_v41_indexer_k_store",
+        torch_op=_reference,
+        gems_op=gems.deepseek_v41_indexer_k_store,
+        dtypes=[torch.bfloat16],
+    ).run()
