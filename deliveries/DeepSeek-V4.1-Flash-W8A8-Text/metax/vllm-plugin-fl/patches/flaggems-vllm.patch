+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""CPU FP64 references for portable MODEL1; no native CUDA library required."""
+import math
+from pathlib import Path
+
+import pytest
+import torch
+import yaml
+
+import flaggems_vllm as gems
+from flaggems_vllm.ops.flash_mla_with_kvcache import get_mla_metadata
+
+pytestmark = [
+    pytest.mark.flash_mla_with_kvcache,
+    pytest.mark.skipif(
+        not torch.cuda.is_available(), reason="CUDA-compatible accelerator required"
+    ),
+]
+
+
+def _encode(values, block_size, padded):
+    pages = values.shape[0] // block_size
+    width = block_size * 584
+    if padded:
+        width = math.ceil(width / 576) * 576
+    encoded = torch.full((pages, width), 171, dtype=torch.uint8)
+    groups = values[:, :448].float().reshape(pages, block_size, 7, 64)
+    exponent = (groups.abs().amax(-1).clamp(min=1e-4) / 448).log2().ceil()
+    codes = (
+        (groups / torch.exp2(exponent)[:, :, :, None])
+        .clamp(-448, 448)
+        .to(torch.float8_e4m3fn)
+        .view(torch.uint8)
+    )
+    data = torch.cat(
+        [
+            codes.reshape(pages, block_size, 448),
+            values[:, 448:]
+            .contiguous()
+            .view(torch.uint8)
+            .reshape(pages, block_size, 128),
+        ],
+        -1,
+    )
+    encoded[:, : block_size * 576] = data.flatten(1)
+    scales = torch.zeros((pages, block_size, 8), dtype=torch.uint8)
+    scales[:, :, :7] = (exponent + 127).clamp(0, 255).byte()
+    encoded[:, block_size * 576 : block_size * 584] = scales.flatten(1)
+    # Independently decode the actual FP8 bytes/scales used by production.
+    decoded = (
+        codes.view(torch.float8_e4m3fn).float() * torch.exp2(exponent)[:, :, :, None]
+    ).reshape(pages * block_size, 448)
+    decoded = torch.cat([decoded, values[:, 448:].float()], -1)
+    storage = encoded.cuda()
+    cache = storage.as_strided((pages, block_size, 1, 584), (width, 584, 584, 1))
+    return cache, decoded
+
+
+def _case(batch, heads, block_size, extra, padded, topk=64):
+    gen = torch.Generator().manual_seed(388 + batch + heads + block_size)
+    total = max(128, topk)
+    main, values = _encode(
+        torch.randn((total, 512), generator=gen).bfloat16(), block_size, padded
+    )
+    extra_cache, extra_values = _encode(
+        torch.randn((total, 512), generator=gen).bfloat16(), block_size, padded
+    )
+    q = torch.randn((batch, 1, heads, 512), generator=gen).bfloat16()
+    ids = torch.arange(topk).expand(batch, 1, topk).clone().int() % total
+    other = (torch.arange(64) + 17).expand(batch, 1, 64).clone().int() % total
+    ids[:, 0, 7] = -1
+    other[:, 0, 9] = -1
+    lengths = torch.full((batch,), topk, dtype=torch.int32)
+    lengths[0] = topk - 7
+    other_lengths = torch.full((batch,), 64, dtype=torch.int32)
+    other_lengths[-1] = 51
+    sink = torch.randn(heads, generator=gen)
+    return dict(
+        q=q,
+        main=main,
+        values=values,
+        extra_cache=extra_cache if extra else None,
+        extra_values=extra_values,
+        ids=ids,
+        other=other,
+        lengths=lengths,
+        other_lengths=other_lengths,
+        sink=sink,
+    )
+
+
+def _reference(c):
+    outputs = []
+    lses = []
+    for row in range(c["q"].shape[0]):
+        main = c["ids"][row, 0, : c["lengths"][row]].long()
+        pieces = [c["values"][main[main >= 0]]]
+        if c["extra_cache"] is not None:
+            other = c["other"][row, 0, : c["other_lengths"][row]].long()
+            pieces.append(c["extra_values"][other[other >= 0]])
+        values = torch.cat(pieces).double()
+        if not values.shape[0]:
+            outputs.append(torch.zeros_like(c["q"][row, 0]))
+            lses.append(torch.full((c["q"].shape[2],), float("inf")))
+            continue
+        scores = c["q"][row, 0].double() @ values.T * (512**-0.5)
+        probabilities = torch.softmax(
+            torch.cat([scores, c["sink"].double()[:, None]], -1), -1
+        )[:, :-1]
+        outputs.append((probabilities @ values).bfloat16())
+        lses.append(scores.logsumexp(-1).float())
+    return torch.stack(outputs)[:, None], torch.stack(lses)[:, :, None]
+
+
+def _arguments(c):
+    metadata, _ = get_mla_metadata()
+    return dict(
+        q=c["q"].cuda(),
+        k_cache=c["main"],
+        block_table=None,
+        cache_seqlens=None,
+        head_dim_v=512,
+        tile_scheduler_metadata=metadata,
+        softmax_scale=512**-0.5,
+        is_fp8_kvcache=True,
+        indices=c["ids"].cuda(),
+        attn_sink=c["sink"].cuda(),
+        topk_length=c["lengths"].cuda(),
+        extra_k_cache=c["extra_cache"],
+        extra_indices_in_kvcache=(
+            c["other"].cuda() if c["extra_cache"] is not None else None
+        ),
+        extra_topk_length=(
+            c["other_lengths"].cuda() if c["extra_cache"] is not None else None
+        ),
+    )
+
