+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""CPU FP32/BF16/FP8 reference, actual public reuse and protected cache bytes."""
+import pytest
+import torch
+
+import flaggems_vllm as gems
+
+pytestmark = [
+    pytest.mark.deepseek_v41_indexer_k_store,
+    pytest.mark.indexer_k_quant_and_cache,
+]
+
+
+def _reference(raw, weight, positions, rope, slots, backing, block):
+    result = backing.clone()
+    fp = raw.float()
+    normalized = (
+        fp * torch.rsqrt(fp.square().mean(-1, keepdim=True) + 1e-6) * weight.float()
+    ).bfloat16()
+    for row, slot in enumerate(slots.tolist()):
+        if slot < 0:
+            continue
+        value = normalized[row].float()
+        even, odd = value[64::2].clone(), value[65::2].clone()
+        cos, sin = (
+            rope[int(positions[row]), :32].float(),
+            rope[int(positions[row]), 32:].float(),
+        )
+        value[64::2] = even * cos - odd * sin
+        value[65::2] = odd * cos + even * sin
+        value = value.bfloat16().float()
+        scale = torch.exp2(
+            torch.ceil(torch.log2(value.abs().max().clamp(min=1e-4) / 448))
+        )
+        quantized = (value / scale).to(torch.float8_e4m3fn).view(torch.uint8)
+        page, offset = divmod(slot, block)
+        result[page, offset * 128 : (offset + 1) * 128] = quantized
+        result[page, block * 128 + offset * 4 : block * 128 + (offset + 1) * 4] = (
+            scale.reshape(1).view(torch.uint8)
+        )
+    return result
+
+
+def _setup(rows, block, rope_dtype, device="cuda"):
+    gen = torch.Generator().manual_seed(6033 + rows)
+    raw = torch.randn((rows, 128), generator=gen).bfloat16()
+    weight = torch.randn(128, generator=gen).bfloat16()
+    angles = torch.arange(257)[:, None].float() / (torch.arange(32).float()[None] + 7)
+    rope = torch.cat((angles.cos(), angles.sin()), -1).to(rope_dtype)
+    positions = (torch.arange(rows) * 2) % 256
+    slots = torch.randperm(4 * block, generator=gen)[:rows].long()
+    slots[::3] = -1
+    # Native allocator padding, plus guard bytes before the first page.
+    storage = torch.full((5, block * 132 + 256), 71, dtype=torch.uint8, device=device)
+    cache = storage[1:, : block * 132].view(4, block, 132)
+    return raw, weight, rope, positions, slots, storage, cache
+
+
+@pytest.mark.parametrize("rows", [0, 1, 7, 33])
+@pytest.mark.parametrize("block", [32, 64])
+@pytest.mark.parametrize("rope_dtype", [torch.float32, torch.bfloat16])
+def test_composition_reference_and_page_padding(rows, block, rope_dtype):
+    raw, weight, rope, pos, slots, storage, cache = _setup(rows, block, rope_dtype)
+    before = storage.cpu()
+    x, w, r, p, s = [t.cuda() for t in (raw, weight, rope, pos, slots)]
+    gems.deepseek_v41_indexer_k_store(x, p, r, w, 1e-6, cache, s)
+    expected = before.clone()
+    expected[1:] = _reference(raw, weight, pos, rope, slots, before[1:], block)
+    torch.testing.assert_close(storage.cpu(), expected, rtol=0, atol=0)
+    for actual, old in zip((x, w, r, p, s), (raw, weight, rope, pos, slots)):
+        torch.testing.assert_close(actual.cpu(), old, rtol=0, atol=0)
+
+
+def test_public_reuse_real_entries(monkeypatch):
+
+    calls = {"norm": 0, "rotary": 0, "cache": 0}
+    for owner, name, key in [
+        (gems, "mhc_rms_norm", "norm"),
+        (gems, "apply_rotary_pos_emb", "rotary"),
+        (gems, "indexer_k_quant_and_cache", "cache"),
+    ]:
+        old = getattr(owner, name)
+
+        def observed(*args, _old=old, _key=key, **kwargs):
+            calls[_key] += 1
+            return _old(*args, **kwargs)
+
+        monkeypatch.setattr(owner, name, observed)
+    raw, weight, rope, pos, slots, storage, cache = _setup(7, 32, torch.float32)
+    before = storage.cpu()
+    gems.deepseek_v41_indexer_k_store(
+        raw.cuda(), pos.cuda(), rope.cuda(), weight.cuda(), 1e-6, cache, slots.cuda()
+    )
+    assert calls == {"norm": 1, "rotary": 1, "cache": 1}
+    expected = before.clone()
+    expected[1:] = _reference(raw, weight, pos, rope, slots, before[1:], 32)
+    torch.testing.assert_close(storage.cpu(), expected, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("block", [32, 64])
+def test_graph_changes_input_positions_and_slots(block):
+    raw, weight, rope, pos, slots, storage, cache = _setup(7, block, torch.bfloat16)
+    x, w, r, p, s = [t.cuda() for t in (raw, weight, rope, pos, slots)]
+
+    def call():
+        gems.deepseek_v41_indexer_k_store(x, p, r, w, 1e-6, cache, s)
+
+    call()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        call()
+    raw2 = (-raw.float() * 0.75).bfloat16()
+    pos2 = (pos + 17) % 257
+    slots2 = torch.tensor([3, 9, -1, 17, 31, 32, -1])
+    x.copy_(raw2)
+    p.copy_(pos2)
+    s.copy_(slots2)
+    storage.fill_(43)
+    before = storage.cpu()
+    graph.replay()
+    expected = before.clone()
+    expected[1:] = _reference(raw2, weight, pos2, rope, slots2, before[1:], block)
+    torch.testing.assert_close(storage.cpu(), expected, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "dtype",
+        "rows",
+        "position_dtype",
+        "rope_width",
+        "weight",
+        "eps",
+        "cache_rows",
+        "cache_pitch",
+        "slot_dtype",
+        "device",
+    ],
+)
+def test_invalid_before_cache_write(bad):
+    raw, weight, rope, pos, slots, storage, cache = _setup(7, 32, torch.float32)
+    x, w, r, p, s = [t.cuda() for t in (raw, weight, rope, pos, slots)]
+    args = [x, p, r, w, 1e-6, cache, s]
+    if bad == "dtype":
+        args[0] = x.float()
+    elif bad == "rows":
+        args[1] = p[:1]
+    elif bad == "position_dtype":
+        args[1] = p.float()
+    elif bad == "rope_width":
+        args[2] = r[:, :32]
+    elif bad == "weight":
+        args[3] = w.float()
+    elif bad == "eps":
+        args[4] = float("nan")
+    elif bad == "cache_rows":
+        args[5] = cache[:, :16]
+    elif bad == "cache_pitch":
+        args[5] = torch.empty((4, 32, 133), device="cuda", dtype=torch.uint8)[
+            :, :, :132
+        ]
+    elif bad == "slot_dtype":
+        args[6] = s.float()
+    elif bad == "device":
+        args[2] = rope
+    before = storage.clone()
+    with pytest.raises((TypeError, ValueError)):
+        gems.deepseek_v41_indexer_k_store(*args)
+    torch.testing.assert_close(storage, before, rtol=0, atol=0)
