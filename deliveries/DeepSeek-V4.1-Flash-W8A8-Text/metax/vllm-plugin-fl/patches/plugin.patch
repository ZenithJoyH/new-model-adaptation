+def test_real_metadata_graph_new_positions_requests_tables_slots_and_output_sentinels():
+    c = _case(1)
+    gpu, out, window, tables, call = _run(c, swa=True)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        call()
+    c["positions"][:6] = torch.tensor([64, 65, 125, 126, 127, 128])
+    c["query"] = torch.tensor([0, 2, 6, 8], dtype=torch.int32)
+    c["requests"][:8] = torch.tensor([0, 0, 1, 1, 1, 1, 2, 2], dtype=torch.int32)
+    c["table"][0] = torch.tensor([5, 3, 6, -1], dtype=torch.int32)
+    c["raw_slots"][1] = -1
+    for name in ["positions", "query", "requests", "table", "raw_slots"]:
+        gpu[name].copy_(c[name])
+    for value in out + [window, tables]:
+        value.fill_(-777)
+    graph.replay()
+    expected = _oracle(c, True)
+    for value, want in zip(out + [window, tables], expected):
+        torch.testing.assert_close(value.cpu(), want, rtol=0, atol=0)
