+    expected = (
+        raw[rank * 4 : (rank + 1) * 4].float() * scale[rank * 4 : (rank + 1) * 4]
+    ).bfloat16()
+    torch.testing.assert_close(layer.weight.cpu(), expected, rtol=0, atol=0)
+    # Processing is idempotent, preserving the accepted materialization.
+    pointer = layer.weight.data_ptr()
