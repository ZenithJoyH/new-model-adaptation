+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Compression capability/forwarding use the existing optional dispatcher."""
+
+import sys
+from types import ModuleType
+
+import pytest
+
+from vllm_fl.dispatch.backends.flaggems.impl import deepseek_v41_compressor as provider
+
+
+@pytest.fixture
+def public(monkeypatch):
+    module = ModuleType("flaggems_vllm")
+    calls = []
+    result = object()
+
+    def implementation(
+        kv_score,
+        positions,
+        state_cache,
+        slot_mapping,
+        query_start_loc,
+        token_to_req_indices,
+        rms_norm_weight,
+        rms_norm_eps,
+        compress_ratio,
+        latent_out,
+    ):
+        calls.append(
+            (
+                kv_score,
+                positions,
+                state_cache,
+                slot_mapping,
+                query_start_loc,
+                token_to_req_indices,
+                rms_norm_weight,
+                rms_norm_eps,
+                compress_ratio,
+                latent_out,
+            )
+        )
+        return result
+
+    module.deepseek_v41_compress_norm = implementation
+    monkeypatch.setitem(sys.modules, "flaggems_vllm", module)
+    return module, calls, result
+
+
+def test_exact_public_signature_is_required(public):
+    module, _, _ = public
+    assert provider.is_compressor_available()
+    module.deepseek_v41_compress_norm = lambda **kw: None
+    assert not provider.is_compressor_available()
+    module.deepseek_v41_compress_norm = None
+    assert not provider.is_compressor_available()
+    del module.deepseek_v41_compress_norm
+    assert not provider.is_compressor_available()
+
+
+def test_forwarding_preserves_all_ten_parameters_and_alias_return(public):
+    _, calls, result = public
+    values = [object() for _ in range(10)]
+    assert provider.deepseek_v41_compress_norm(*values) is result
+    assert calls == [tuple(values)]
+
+
+def test_computation_error_is_not_retried(public):
+    module, calls, _ = public
+
+    def fail(*args):
+        calls.append(args)
+        raise RuntimeError("state write started")
+
+    module.deepseek_v41_compress_norm = fail
+    with pytest.raises(RuntimeError, match="state write started"):
+        provider.deepseek_v41_compress_norm(*[object() for _ in range(10)])
+    assert len(calls) == 1
+
+
+def test_registry_uses_existing_default_contract(monkeypatch):
+    from vllm_fl.dispatch.backends.flaggems import register_ops
+
+    registered = []
+
+    class Registry:
+        def register_many(self, values):
+            registered.extend(values)
+
+    monkeypatch.setattr(
+        register_ops,
+        "use_flaggems_op",
+        lambda name: name == "deepseek_v41_compress_norm",
+    )
+    register_ops.register_builtins(Registry())
+    assert len(registered) == 1
+    impl = registered[0]
+    assert (
+        impl.op_name == "deepseek_v41_compress_norm"
+        and impl.impl_id == "default.flagos"
+    )
+    assert impl.fn.__wrapped__ is provider.deepseek_v41_compress_norm
