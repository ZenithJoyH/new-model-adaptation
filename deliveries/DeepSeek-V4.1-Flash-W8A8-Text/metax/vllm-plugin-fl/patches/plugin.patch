+@pytest.mark.parametrize("storage", [32, 64])
+def test_physical_indices_padded_stride_offset_and_real_graph(storage):
+    logical = torch.tensor(
+        [[0, 31, 32, 63, 64, -1], [0, 65, 129, 1000, -1, 4]], dtype=torch.int32
+    )
+    req = torch.tensor([1, 0], dtype=torch.int32)
+    length = torch.tensor([100, 130], dtype=torch.int32)
+    table = torch.tensor([[2, 3, -1, 7], [5, 1, 4, -1]], dtype=torch.int32)
+    wide = torch.empty((3, 13), device="cuda", dtype=torch.int32)
+    indices = wide[1:, 1:7]
+    indices.copy_(logical)
+    backing = torch.full((3, 17), -777, device="cuda", dtype=torch.int32)
+    out = backing[1:, 2:8]
+    args = [indices, req.cuda(), length.cuda(), table.cuda(), 8, storage, out]
+
+    def reference():
+        expected = torch.full_like(logical, -1)
+        for row in range(2):
+            for col, value in enumerate(logical[row].tolist()):
+                if 0 <= value < length[row] and value // storage < table.shape[1]:
+                    page = int(table[int(req[row]), value // storage])
+                    if 0 <= page < 8:
+                        expected[row, col] = page * storage + value % storage
+        return expected
+
+    logical_to_physical_indices(*args)
+    torch.testing.assert_close(out.cpu(), reference(), rtol=0, atol=0)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        logical_to_physical_indices(*args)
+    logical[:, 0] = 7
+    indices.copy_(logical)
+    out.fill_(-777)
+    graph.replay()
+    torch.testing.assert_close(out.cpu(), reference(), rtol=0, atol=0)
+    expected_backing = torch.full_like(backing, -777)
+    expected_backing[1:, 2:8] = out
+    torch.testing.assert_close(backing, expected_backing, rtol=0, atol=0)
+
