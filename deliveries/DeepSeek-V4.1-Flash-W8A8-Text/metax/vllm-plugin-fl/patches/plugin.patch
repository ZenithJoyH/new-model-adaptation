+@pytest.mark.parametrize(
+    "failure_stage", ["dynamic_per_token_quant_int8", "w8a8_scaled_mm"]
+)
+def test_linear_execution_error_is_not_retried(monkeypatch, failure_stage):
+    calls = []
+    x = torch.ones((2, 4), dtype=torch.bfloat16)
+    layer = SimpleNamespace(
+        weight=torch.ones((4, 3), dtype=torch.int8),
+        weight_scale=torch.ones(3),
+        input_scale=None,
+        input_zero_point=None,
+        azp_adj=None,
+    )
+    kernel = object.__new__(linear.FLW8A8DynamicLinearKernel)
+    kernel.layer_param_names = [
+        "weight",
+        "weight_scale",
+        "input_scale",
+        "input_zero_point",
+        "azp_adj",
+    ]
+
+    def resolve(name):
+        def execute(*args, **kwargs):
+            calls.append(name)
+            if name == failure_stage:
+                raise RuntimeError("execution already started")
+            return torch.ones_like(x, dtype=torch.int8), torch.ones((2, 1))
+
+        return execute
+
+    monkeypatch.setattr(linear, "resolve_op", resolve)
+    with pytest.raises(RuntimeError, match="already started"):
+        kernel.apply_weights(layer, x)
+    assert calls.count(failure_stage) == 1
+    assert calls == (
+        ["dynamic_per_token_quant_int8"]
+        if failure_stage == "dynamic_per_token_quant_int8"
+        else ["dynamic_per_token_quant_int8", "w8a8_scaled_mm"]
+    )
+
