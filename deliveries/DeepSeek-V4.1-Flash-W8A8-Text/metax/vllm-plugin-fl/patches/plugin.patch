+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Real V2 metadata buffers, lifecycle hooks, dispatch and FP32 ring composition."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm_fl.models.deepseek_v41 import model_state as module
+from vllm_fl.models.deepseek_v41.compressor_metadata import prepare_compressor_metadata
+
+pytestmark = [pytest.mark.gpu, pytest.mark.functional]
+
+
+def _inputs(mapping=(3, 1), empty=False):
+    n = 10
+    return dict(
+        positions=torch.tensor([10, 11, 12, 20, 21, 22, 23, 24, 0, 0], device="cuda"),
+        is_padding=torch.tensor([False] * 8 + [True] * 2, device="cuda"),
+        query_start_loc=torch.tensor(
+            [0] if empty else [0, 3, 8], device="cuda", dtype=torch.int32
+        ),
+        idx_mapping=torch.tensor(
+            [] if empty else mapping, device="cuda", dtype=torch.int64
+        ),
+        num_reqs=0 if empty else 2,
+        capacity=8,
+        state_slots=torch.full((n,), 91, device="cuda", dtype=torch.int64),
+        token_to_req=torch.full((n,), 91, device="cuda", dtype=torch.int32),
+        query_output=torch.full((6,), 91, device="cuda", dtype=torch.int32),
+    )
+
+
+def _reference(args):
+    n = args["positions"].numel()
+    slots = torch.full((n,), -1, dtype=torch.int64)
+    requests = torch.full((n,), -1, dtype=torch.int32)
+    queries = torch.zeros_like(args["query_output"], device="cpu")
+    nr = args["num_reqs"]
+    maximum = queries.numel() - 1
+    source = args["query_start_loc"].cpu()
+    mapping = args["idx_mapping"].cpu()
+    positions = args["positions"].cpu()
+    pad = args["is_padding"].cpu()
+    if nr:
+        queries[: nr + 1] = source[: nr + 1]
+        queries[nr + 1 :] = source[nr]
+        for req in range(nr):
+            for token in range(int(source[req]), int(source[req + 1])):
+                if (
+                    pad[token]
+                    or not 0 <= mapping[req] < maximum
+                    or positions[token] < 0
+                ):
+                    continue
+                slots[token] = (
+                    mapping[req] * args["capacity"]
+                    + positions[token] % args["capacity"]
+                )
+                requests[token] = req
+    return slots, requests, queries
+
+
+@pytest.mark.parametrize("mapping", [(3, 1), (1, 3), (-1, 2), (7, 0)])
