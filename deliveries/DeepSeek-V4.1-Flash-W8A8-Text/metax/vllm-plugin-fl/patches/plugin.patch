+def _inputs(n):
+    generator = torch.Generator().manual_seed(19)
+    hidden = torch.randn((n, 4, 7), generator=generator).bfloat16().cuda()
+    ids = torch.randint(-1, 602, (n, 24), generator=generator, dtype=torch.int32).cuda()
+    mask = torch.arange(n, device="cuda") % 2 == 0
+    return hidden, ids, mask
+
+
+def _reference(hidden, ids, mask, weights):
+    table, scale, matrix, matrix_scale, qw, kw = weights
+    ids = ids.cpu().long()
+    valid = (ids >= 0) & (ids < len(table))
+    values = (
+        table[ids.clamp(0, len(table) - 1)].float()
+        * scale[ids.clamp(0, len(table) - 1)]
+    )
+    values = torch.where(valid[:, :, None], values, 0).bfloat16()
+    n = len(ids)
+    if n == 0:
+        return torch.empty((0, 4, 7), dtype=torch.bfloat16)
+    flat = values.reshape(n, -1).float()
+    maximum = flat.abs().amax(-1, keepdim=True)
+    inverse = torch.where(
+        maximum == 0, torch.zeros_like(maximum), torch.div(127.0, maximum)
+    )
+    q = (flat * inverse).round().clamp(-128, 127).to(torch.int64)
+    kv = (
+        ((q @ matrix.long().T).float() * (maximum / 127) * matrix_scale.reshape(1, -1))
+        .bfloat16()
+        .double()
+    )
+    h = hidden.cpu().double()
+    key = kv[:, :28].reshape(n, 4, 7)
+    dot = (h * (qw.double() * kw.double()) * key).sum(-1)
+    dot = (
+        dot
+        * torch.rsqrt(h.square().mean(-1) + 1e-20)
+        * torch.rsqrt(key.square().mean(-1) + 1e-20)
+        * 7**-0.5
+    )
+    gate = torch.sigmoid(torch.copysign(dot.abs().clamp_min(1e-6).sqrt(), dot))
+    gate = gate.masked_fill(~mask.cpu()[:, None], 0)
+    return (h + gate[:, :, None] * kv[:, None, 28:]).bfloat16()
