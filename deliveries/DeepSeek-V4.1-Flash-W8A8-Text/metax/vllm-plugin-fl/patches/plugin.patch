+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Optional clamp capability is checked before calling public FGV computation."""
+
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from vllm_fl.dispatch.backends.flaggems.impl.w8a8_moe import w8a8_moe_experts
+from vllm_fl.quantization.w8a8 import moe_experts
+
+
+def _arguments(limit):
+    return dict(
+        hidden_states=None,
+        w1=None,
+        w2=None,
+        topk_weights=None,
+        topk_ids=None,
+        w1_scale=None,
+        w2_scale=None,
+        w1_bias=None,
+        w2_bias=None,
+        expert_map=None,
+        apply_router_weight_on_input=False,
+        activation="silu",
+        global_num_experts=384,
+        clamp_limit=limit,
+    )
+
+
+@pytest.mark.parametrize("limit", [None, 0, -1, 10.0])
+def test_scalar_mapping_preserves_unclamped_api(monkeypatch, limit):
+    calls = []
+
+    def public(*, gemm1_alpha=None, gemm1_beta=None, gemm1_clamp_limit=None, **kwargs):
+        return None
+
+    monkeypatch.setitem(
+        sys.modules, "flaggems_vllm", SimpleNamespace(fused_experts_impl=public)
+    )
+    monkeypatch.setattr(
+        moe_experts, "_flaggems_fused_experts_impl", lambda **kw: calls.append(kw)
+    )
+    w8a8_moe_experts(**_arguments(limit))
+    assert len(calls) == 1
+    kw = calls[0]
+    assert kw["activation"] == (
+        "swigluoai_uninterleave" if limit and limit > 0 else "silu"
+    )
+    if limit and limit > 0:
+        assert (kw["gemm1_alpha"], kw["gemm1_beta"], kw["gemm1_clamp_limit"]) == (
+            1,
+            0,
+            limit,
+        )
+    else:
+        assert not any(k.startswith("gemm1_") for k in kw)
+    assert kw["a1_scale"] is None and kw["a2_scale"] is None
+    assert kw["use_int8_w8a8"] and kw["per_channel_quant"]
+
+
+@pytest.mark.parametrize(
+    "limit", [True, "10", float("nan"), float("inf"), -float("inf")]
+)
+def test_invalid_scalar_fails_before_execution(monkeypatch, limit):
+    monkeypatch.setattr(
+        moe_experts,
+        "_flaggems_fused_experts_impl",
+        lambda **kw: pytest.fail("executed"),
+    )
+    with pytest.raises(ValueError, match="finite real"):
+        w8a8_moe_experts(**_arguments(limit))
+
+
+def test_missing_public_scalar_api_fails_before_execution(monkeypatch):
+    monkeypatch.setitem(
+        sys.modules,
+        "flaggems_vllm",
+        SimpleNamespace(fused_experts_impl=lambda **kw: None),
+    )
+    monkeypatch.setattr(
+        moe_experts,
+        "_flaggems_fused_experts_impl",
+        lambda **kw: pytest.fail("executed"),
+    )
+    with pytest.raises(NotImplementedError, match="scalar API"):
+        w8a8_moe_experts(**_arguments(10))
+
+
+def test_execution_failure_propagates_without_retry(monkeypatch):
+    def public(*, gemm1_alpha=None, gemm1_beta=None, gemm1_clamp_limit=None, **kwargs):
+        return None
+
+    monkeypatch.setitem(
+        sys.modules, "flaggems_vllm", SimpleNamespace(fused_experts_impl=public)
+    )
+    calls = []
+
+    def failure(**kw):
+        calls.append(kw)
+        raise RuntimeError("kernel sentinel")
+
+    monkeypatch.setattr(moe_experts, "_flaggems_fused_experts_impl", failure)
+    with pytest.raises(RuntimeError, match="kernel sentinel"):
+        w8a8_moe_experts(**_arguments(10))
+    assert len(calls) == 1
