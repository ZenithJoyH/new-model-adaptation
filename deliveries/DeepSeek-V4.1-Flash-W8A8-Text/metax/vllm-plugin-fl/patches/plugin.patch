+++ b/tests/functional_tests/models/test_deepseek_v41_attention_chain.py
@@ -0,0 +1,327 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Real attention cache/dispatch wiring, independent FlashMLA stage oracle.
+
+Only rank metadata is isolated; no TP collective claim. Numerical operators
+also have independent library tests. This integration checks their live public
+path, protected page bytes, shared ownership and new-input graph mutation.
+"""
+
+import functools
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.config import VllmConfig, set_current_vllm_config
+from vllm.forward_context import ForwardContext, override_forward_context
+from vllm.plugins import load_general_plugins
+
+from vllm_fl.models.deepseek_v41.cache import DeepseekV41CacheMetadata
+from vllm_fl.models.deepseek_v41.config import DeepseekV41Config
+from vllm_fl.quantization.w8a8_int8 import DynamicW8A8Int8Config
+
+pytestmark = [pytest.mark.gpu, pytest.mark.functional]
+
+
+def _decode(cache):
+    pages, block = cache.shape[:2]
+    raw = cache.detach().cpu().reshape(pages, block * 584)
+    data = raw[:, : block * 576].reshape(pages, block, 576)
+    code = (
+        data[:, :, :448]
+        .contiguous()
+        .view(torch.float8_e4m3fn)
+        .float()
+        .reshape(pages, block, 7, 64)
+    )
+    exponent = (
+        raw[:, block * 576 : block * 584].reshape(pages, block, 8)[:, :, :7].float()
+        - 127
+    )
+    nope = (code * torch.exp2(exponent)[:, :, :, None]).reshape(pages, block, 448)
+    rope = (
+        data[:, :, 448:]
+        .contiguous()
+        .view(torch.bfloat16)
+        .reshape(pages, block, 64)
+        .float()
+    )
+    return torch.cat((nope, rope), -1).reshape(pages * block, 512)
+
+
+def _flash_reference(q, cache, indices, sink, extra_cache, extra_indices):
+    main = _decode(cache)
+    extra = _decode(extra_cache) if extra_cache is not None else None
+    query = q.detach().cpu().double()
+    ids = indices.cpu()
+    other = extra_indices.cpu() if extra_indices is not None else None
+    sink = sink.detach().cpu().double()[:8]
+    result = []
+    for row in range(len(query)):
+        selected = ids[row, 0]
+        values = [main[selected[selected >= 0].long()]]
+        if extra is not None:
+            selected = other[row, 0]
+            values.append(extra[selected[selected >= 0].long()])
+        value = torch.cat(values).double()
+        scores = query[row, 0, :8] @ value.T * (512**-0.5)
+        prob = torch.softmax(torch.cat((scores, sink[:, None]), -1), -1)[:, :-1]
+        result.append((prob @ value).bfloat16())
+    return torch.stack(result)
+
+
+@pytest.fixture
+def setup(monkeypatch):
+    model_path = os.environ.get("DEEPSEEK_V41_MODEL_PATH")
+    assert model_path, "Set DEEPSEEK_V41_MODEL_PATH to the frozen text checkpoint"
+    load_general_plugins()
+    from vllm.model_executor import parameter
+    from vllm.model_executor.layers import linear
+
+    from vllm_fl.models.deepseek_v41 import attention
+
+    for owner in (parameter, linear, attention):
+        if hasattr(owner, "get_tensor_model_parallel_rank"):
+            monkeypatch.setattr(owner, "get_tensor_model_parallel_rank", lambda: 0)
+        monkeypatch.setattr(owner, "get_tensor_model_parallel_world_size", lambda: 8)
+    monkeypatch.setattr(
+        linear,
+        "tensor_model_parallel_all_reduce",
+        lambda *args: pytest.fail(
+            "rank-isolated attention unexpectedly invoked a collective"
+        ),
+    )
+    raw = json.loads((Path(model_path) / "config.json").read_text())
+    config = DeepseekV41Config(**raw)
+    config.max_position_embeddings = 512
+    config.rope_parameters = dict(
+        config.rope_parameters, original_max_position_embeddings=32, factor=16
+    )
+    cfg = SimpleNamespace(
+        model_config=SimpleNamespace(hf_config=config, max_model_len=512),
+        cache_config=SimpleNamespace(block_size=64, cache_dtype="fp8_ds_mla"),
+        parallel_config=SimpleNamespace(
+            decode_context_parallel_size=1, prefill_context_parallel_size=1
+        ),
+        scheduler_config=SimpleNamespace(max_num_batched_tokens=256, max_num_seqs=2),
+        compilation_config=SimpleNamespace(static_forward_context={}),
+        quant_config=DynamicW8A8Int8Config.from_config(
+            {"quant_method": "w8a8_int8", "is_dynamic": True, "ignore": []}
+        ),
+    )
+    with (
+        torch.random.fork_rng(devices=[torch.cuda.current_device()]),
+        set_current_vllm_config(VllmConfig()),
+    ):
+        yield attention, cfg
+
+
+def _load_linear(layer, gen, *, sizes=None):
+    n, k = layer.output_size, layer.input_size
+    quantized = layer.weight.dtype == torch.int8
+    chunks = sizes or [n]
+    for shard, size in enumerate(chunks):
+        value = (
+            torch.randint(-128, 128, (size, k), generator=gen, dtype=torch.int8)
+            if quantized
+            else (torch.randn((size, k), generator=gen) * 0.01).bfloat16()
+        )
+        args = (shard,) if sizes is not None else ()
+        layer.weight.weight_loader(layer.weight, value.cuda(), *args)
+        if quantized:
+            scale = torch.rand((size, 1), generator=gen) * 0.002 + 0.0005
+            layer.weight_scale.weight_loader(layer.weight_scale, scale.cuda(), *args)
+    layer.quant_method.process_weights_after_loading(layer)
+
+
+def _load(layer, gen):
+    c = layer.q_norm.weight.numel()
+    _load_linear(layer.fused_wqa_wkv, gen, sizes=[c, 512])
+    _load_linear(layer.wq_b, gen)
+    _load_linear(layer.wo_a, gen)
+    _load_linear(layer.wo_b, gen)
+    layer.q_norm.weight.data.fill_(1)
+    layer.kv_norm.weight.data.fill_(1)
+    layer.attn_sink.data[:8].copy_(torch.linspace(-2, 2, 8, device="cuda"))
+    layer.wo_b.reduce_results = False
+    if layer.compressor is not None:
+        _load_linear(layer.compressor.fused_wkv_wgate, gen, sizes=[512] * layer.ratio)
+        layer.compressor.norm.weight.data.fill_(1)
+    if layer.indexer is not None:
+        _load_linear(layer.indexer.wq_b, gen)
+        _load_linear(layer.indexer.weights_proj, gen)
+        if layer.indexer.owns_k:
+            _load_linear(layer.indexer.wk, gen)
+            layer.indexer.k_norm.weight.data.fill_(1)
+
+
+def _bind_and_metadata(cfg, n):
+    storages = {}
+    metadata = {}
+    p = torch.arange(n, device="cuda", dtype=torch.int64)
+    for name, cache in cfg.compilation_config.static_forward_context.items():
+        block = 64 // cache.compress_ratio
+        row = 132 if cache.kind == "index" else 584
+        pages = 8
+        pitch = ((block * row + 575) // 576 + 1) * 576
+        storage = torch.full((pages, pitch), 73, device="cuda", dtype=torch.uint8)
+        cache.bind_kv_cache(storage.as_strided((pages, block, row), (pitch, row, 1)))
+        storages[name] = (storage, block * row)
+        ratio = cache.compress_ratio
+        slots = torch.where((p + 1) % ratio == 0, p // ratio, -1)
+        lengths = ((p + 1) // ratio).int()
+        tables = torch.arange(8, device="cuda", dtype=torch.int32)[None, :]
+        swa = None
+        if cache.kind == "swa":
+            cpu = torch.full((n, 1, 128), -1, dtype=torch.int32)
+            for r in range(n):
+                values = torch.arange(max(0, r - 127), r + 1, dtype=torch.int32)
+                cpu[r, 0, : len(values)] = values
+            swa = cpu.cuda()
+        metadata[name] = DeepseekV41CacheMetadata(
+            slots,
+            (p // ratio) * ratio,
+            lengths,
+            torch.zeros(n, device="cuda", dtype=torch.int32),
+            tables,
+            swa,
+            tables.expand(n, -1).contiguous() if cache.kind == "index" else None,
+            ratio,
+            block,
+        )
+    return storages, metadata, p
+
+
+@pytest.mark.parametrize(
+    "layer_id,n", [(2, 4), (2, 69), (2, 256), (20, 4), (20, 69), (20, 256)]
+)
+@torch.inference_mode()
+def test_live_owner_cache_public_chain_and_graph_new_inputs(
+    setup, monkeypatch, layer_id, n
+):
+    module, cfg = setup
+    import flaggems_vllm as gems
+
+    calls = []
+    oracle = []
+    query_oracle = []
+    names = [
+        "fused_q_kv_rmsnorm",
+        "fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert",
+        "deepseek_v41_compress_norm",
+        "deepseek_v41_indexer_k_store",
+        "fused_indexer_q_rope_quant",
+        "paged_mqa_logits",
+        "persistent_topk",
+        "flash_mla_with_kvcache",
+        "apply_rotary_pos_emb",
+    ]
+    if layer_id == 20:
+        names.append("deepseek_v41_select_candidate_blocks")
+    for name in names:
+        original = getattr(gems, name)
+
+        @functools.wraps(original)
+        def observed(*args, _name=name, _original=original, **kwargs):
+            calls.append(_name)
+            projected = None
+            if _name == "fused_deepseek_v4_qnorm_rope_kv_rope_quant_insert":
+                assert kwargs["apply_q_norm"] is False
+                if not torch.cuda.is_current_stream_capturing() and args[0].numel():
+                    projected = args[0].detach().cpu().clone()
+                    positions_cpu = args[4].cpu()
+                    cs_cpu = args[5].cpu()[positions_cpu].double()
+            result = _original(*args, **kwargs)
+            if projected is not None:
+                expected_q = projected.clone()
+                tail = projected[..., 448:].double().reshape(n, 8, 32, 2)
+                cosine, sine = cs_cpu[:, None, :32], cs_cpu[:, None, 32:]
+                even, odd = tail[..., 0], tail[..., 1]
+                expected_q[..., 448:] = (
+                    torch.stack(
+                        (even * cosine - odd * sine, odd * cosine + even * sine), -1
+                    )
+                    .reshape(n, 8, 64)
+                    .bfloat16()
+                )
+                observed_q = args[0].detach().cpu()
+                assert torch.equal(observed_q[..., :448], projected[..., :448])
+                torch.testing.assert_close(
+                    observed_q, expected_q, rtol=0.008, atol=0.0002
+                )
+                query_oracle.append(True)
+            if (
+                _name == "flash_mla_with_kvcache"
+                and not torch.cuda.is_current_stream_capturing()
+            ):
+                expected = _flash_reference(
+                    args[0],
+                    args[1],
+                    kwargs["indices"],
+                    kwargs["attn_sink"],
+                    kwargs.get("extra_k_cache"),
+                    kwargs.get("extra_indices_in_kvcache"),
+                )
+                torch.testing.assert_close(
+                    result[0][:, 0, :8].cpu(), expected, rtol=0.016, atol=0.02
+                )
+                oracle.append(True)
+            return result
+
+        monkeypatch.setattr(gems, name, observed)
+    with torch.device("cuda"):
+        indices = torch.empty((256, 512), dtype=torch.int32)
+        candidates = torch.empty((256, 2048), dtype=torch.int32)
+        rotary = torch.nn.ModuleDict()
+        layer = module.DeepseekV41Attention(
+            cfg,
+            prefix=f"model.layers.{layer_id}.attn",
+            indices=indices,
+            candidate_blocks=candidates,
+            rotary_tables=rotary,
+        )
+    gen = torch.Generator().manual_seed(7711 + layer_id)
+    _load(layer, gen)
+    storages, metadata, positions = _bind_and_metadata(cfg, n)
+    context = ForwardContext(
+        no_compile_layers=cfg.compilation_config.static_forward_context,
+        attn_metadata=metadata,
+        slot_mapping={},
+    )
+    raw = torch.randn((n, 5120), generator=gen).bfloat16()
+    hidden = raw.cuda()
+    state = dict(
+        compressor_state_slots=(positions % 8).clone(),
+        compressor_token_to_req=torch.zeros(n, device="cuda", dtype=torch.int32),
+        compressor_query_start_loc=torch.tensor(
+            [0, n], device="cuda", dtype=torch.int32
+        ),
+    )
+    with override_forward_context(context):
+        actual = layer(positions, hidden, **state)
+    assert actual.shape == (n, 5120) and torch.isfinite(actual).all()
+    assert set(names) <= set(calls) and oracle and query_oracle
+    before = actual.clone()
+    graph = torch.cuda.CUDAGraph()
+    with override_forward_context(context), torch.cuda.graph(graph):
+        actual = layer(positions, hidden, **state)
+    hidden.copy_((-raw.float() * 0.75).bfloat16())
+    for storage, _ in storages.values():
+        storage.fill_(73)
+    if layer.compressor.state_cache is not None:
+        layer.compressor.state_cache.zero_()
+    actual.fill_(float("nan"))
+    graph.replay()
+    assert torch.isfinite(actual).all() and not torch.equal(actual, before)
+    for storage, content in storages.values():
+        assert (storage[:, content:] == 73).all()
+    # For short contexts every causal compressed position is selected. Compare
+    # the full caller buffer, including -1 padding, to an integer CPU oracle.
+    expected = torch.full((n, 512), -1, dtype=torch.int32)
+    for row in range(n):
+        count = (row + 1) // layer.ratio
+        expected[row, :count] = torch.arange(count, dtype=torch.int32)
+    torch.testing.assert_close(indices[:n].cpu(), expected, rtol=0, atol=0)
