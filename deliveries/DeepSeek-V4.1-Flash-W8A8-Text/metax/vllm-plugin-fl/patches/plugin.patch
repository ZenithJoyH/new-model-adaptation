+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Independent CPU integer/cache-layout oracles, and real metadata graph replay."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.attention.backend import CommonAttentionMetadata
+
+from vllm_fl.models.deepseek_v41.attention_metadata import (
+    logical_to_physical_indices,
+    prepare_cache_metadata,
+)
+from vllm_fl.models.deepseek_v41.cache import (
+    DeepseekV41Cache,
+    DeepseekV41CacheMetadataBuilder,
+)
+
+
+def _config():
+    return SimpleNamespace(
+        cache_config=SimpleNamespace(block_size=64, cache_dtype="fp8_ds_mla"),
+        compilation_config=SimpleNamespace(static_forward_context={}),
+        parallel_config=SimpleNamespace(
+            decode_context_parallel_size=1, prefill_context_parallel_size=1
+        ),
+        model_config=SimpleNamespace(max_model_len=512),
+        scheduler_config=SimpleNamespace(max_num_batched_tokens=256, max_num_seqs=8),
+        speculative_config=None,
+    )
+
+
+def _case(ratio, padding=3):
+    positions = torch.tensor([62, 63, 64, 65, 127, 128, 9, 10] + [0] * padding).long()
+    query = torch.tensor([0, 4, 6, 8], dtype=torch.int32)
+    seq = torch.tensor([66, 129, 11], dtype=torch.int32)
+    requests = torch.tensor(
+        [0] * 4 + [1] * 2 + [2] * 2 + [0] * padding, dtype=torch.int32
+    )
+    table = torch.tensor(
+        [[2, 4, 3, -1], [5, 1, 6, -1], [7, 0, 3, -1]], dtype=torch.int32
+    )
+    raw_slots = torch.tensor([777] * 8 + [-1] * padding, dtype=torch.int64)
+    return dict(
+        positions=positions,
+        query=query,
+        seq=seq,
+        requests=requests,
+        table=table,
+        raw_slots=raw_slots,
+        ratio=ratio,
+        blocks=8,
+    )
+
+
+def _oracle(c, swa=False):
+    n, ratio = c["positions"].numel(), c["ratio"]
+    slots = torch.full((n,), -1, dtype=torch.int64)
+    groups = torch.zeros(n, dtype=torch.int64)
+    lengths = torch.zeros(n, dtype=torch.int32)
+    windows = torch.full((n, 1, 128), -1, dtype=torch.int32)
+    tables = torch.full((n, c["table"].shape[1]), -1, dtype=torch.int32)
+    for t in range(n):
+        r, p = int(c["requests"][t]), int(c["positions"][t])
+        if c["raw_slots"][t] < 0 or not 0 <= r < c["seq"].numel():
+            continue
+        if (
+            not int(c["query"][r]) <= t < int(c["query"][r + 1])
+            or not 0 <= p < c["table"].shape[1] * 64
+        ):
+            continue
+        block = int(c["table"][r, p // 64])
+        if not 0 <= block < c["blocks"]:
+            continue
+        if (p + 1) % ratio == 0:
+            slots[t] = block * (64 // ratio) + (p % 64) // ratio
+        groups[t], lengths[t] = p // ratio * ratio, (p + 1) // ratio
+        for col, page in enumerate(c["table"][r].tolist()):
+            if 0 <= page < c["blocks"]:
+                tables[t, col] = page
+        if swa:
+            for col, logical in enumerate(range(max(0, p - 127), p + 1)):
+                page = int(c["table"][r, logical // 64])
+                if 0 <= page < c["blocks"]:
+                    windows[t, 0, col] = page * 64 + logical % 64
+    return slots, groups, lengths, windows, tables
+
+
+def _run(c, has_positions=True, swa=False, tables=True):
+    gpu = {k: v.cuda() if isinstance(v, torch.Tensor) else v for k, v in c.items()}
+    n = c["positions"].numel()
+    out = [
+        torch.full((n,), -777, device="cuda", dtype=dtype)
+        for dtype in (torch.int64, torch.int64, torch.int32)
+    ]
+    window = (
+        torch.full((n, 1, 128), -777, device="cuda", dtype=torch.int32) if swa else None
+    )
+    per_token = (
+        torch.full((n, c["table"].shape[1]), -777, device="cuda", dtype=torch.int32)
+        if tables
+        else None
+    )
+
+    def call():
+        return prepare_cache_metadata(
+            gpu["positions"] if has_positions else None,
+            gpu["query"],
+            gpu["seq"],
+            gpu["requests"],
+            gpu["table"],
+            gpu["raw_slots"],
+            n,
+            c["seq"].numel(),
+            c["blocks"],
+            c["ratio"],
+            64,
+            *out,
+            swa_indices_out=window,
+            token_tables_out=per_token,
+        )
+
+    before = {
+        name: value.clone()
+        for name, value in gpu.items()
+        if isinstance(value, torch.Tensor)
+    }
+    call()
+    for name, expected_input in before.items():
+        torch.testing.assert_close(gpu[name], expected_input, rtol=0, atol=0)
+    expected = _oracle(c, swa)
+    for actual, want in zip(out + [window, per_token], expected):
+        if actual is not None:
+            torch.testing.assert_close(actual.cpu(), want, rtol=0, atol=0)
+    return gpu, out, window, per_token, call
+
