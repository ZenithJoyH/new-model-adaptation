+    cpu_state = model.ring.cpu()
+    generator = torch.Generator().manual_seed(511)
+    weight = torch.randn(512, generator=generator).bfloat16()
+    for counts, starts, mapping in [((1, 3), (0, 0), (3, 1)), ((1, 2), (3, 1), (1, 3))]:
+        n = sum(counts)
+        query = torch.tensor([0, counts[0], n], dtype=torch.int32)
+        positions = torch.cat(
+            [torch.arange(p, p + c) for p, c in zip(starts, counts)]
+        ).long()
+        raw = torch.randn((n, 1024), generator=generator)
+        expected = torch.full((n, 512), -123.0, dtype=torch.bfloat16)
+        for req, (count, start, index) in enumerate(zip(counts, starts, mapping)):
+            begin = int(query[req])
+            end = int(query[req + 1])
+            for token in range(begin, end):
+                pos = int(positions[token])
+                if pos % 2 != 1:
+                    continue
+                prev = (
+                    cpu_state[index, (pos - 1) % 8]
+                    if token == begin
+                    else raw[token - 1]
+                )
+                pair = torch.stack([prev, raw[token]]).double()
+                value = (pair[:, :512] * torch.softmax(pair[:, 512:], dim=0)).sum(0)
