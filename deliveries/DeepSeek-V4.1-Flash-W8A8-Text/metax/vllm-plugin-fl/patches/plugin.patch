+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Thin adapter for the public vLLM-specific INT8 scaled matrix multiply."""
+
+import inspect
+
+import torch
+
+
+def is_w8a8_scaled_mm_available() -> bool:
+    try:
+        import flaggems_vllm
+    except ModuleNotFoundError as error:
+        if error.name != "flaggems_vllm":
+            raise
+        return False
+
+    implementation = getattr(flaggems_vllm, "triton_scaled_mm", None)
+    return callable(implementation) and {
+        "input",
+        "weight",
+        "scale_a",
+        "scale_b",
+        "out_dtype",
+        "bias",
+    }.issubset(inspect.signature(implementation).parameters)
+
+
+def w8a8_scaled_mm(a, b, scale_a, scale_b, *, out_dtype, bias=None):
+    """Return scaled INT32 accumulation, rounded before optional bias addition.
+
+    A[M,K] and B[K,N] are contiguous INT8; scales are FP32 [M,1] / [N].
+    Inputs share a device and are not modified. Output is a fresh [M,N]
+    tensor of out_dtype. Empty M is supported; K and N must be positive.
+    Bias, when present, is contiguous [N] of out_dtype. Unsupported metadata
+    fails before the public kernel is launched; execution errors propagate.
+    """
+    from flaggems_vllm import triton_scaled_mm
+
+    if a.ndim != 2 or b.ndim != 2:
+        raise ValueError("W8A8 inputs must be two-dimensional")
+    m, k = a.shape
+    n = b.shape[1]
+    if k <= 0 or n <= 0 or b.shape[0] != k:
+        raise ValueError("W8A8 requires compatible positive K and N")
+    if a.dtype != torch.int8 or b.dtype != torch.int8:
+        raise TypeError("W8A8 operands must be INT8")
+    if out_dtype not in (torch.bfloat16, torch.float16, torch.float32):
+        raise TypeError("W8A8 output must be BF16, FP16 or FP32")
+    if scale_a.dtype != torch.float32 or scale_b.dtype != torch.float32:
+        raise TypeError("W8A8 scales must be FP32")
+    if scale_a.shape != (m, 1) or scale_b.shape != (n,):
+        raise ValueError("W8A8 scale shapes must be [M,1] and [N]")
+    tensors = [a, b, scale_a, scale_b]
+    if bias is not None:
+        if bias.shape != (n,) or bias.dtype != out_dtype:
+            raise ValueError("W8A8 bias must be [N] with the output dtype")
+        tensors.append(bias)
+    if any(t.device != a.device for t in tensors):
+        raise ValueError("W8A8 inputs must share a device")
+    if any(not t.is_contiguous() for t in tensors):
+        raise ValueError("W8A8 inputs must be contiguous")
+    if m == 0:
+        return torch.empty((0, n), device=a.device, dtype=out_dtype)
+    return triton_scaled_mm(a, b, scale_a, scale_b, out_dtype=out_dtype, bias=bias)
