+# Copyright (c) 2026 BAAI. All rights reserved.
+
+"""DeepSeek V4.1 model metadata and runtime integration."""
+
+
+def register_deepseek_v41_model():
+    """Register a lazy text model entry while preserving native support."""
+    from vllm.model_executor.models import ModelRegistry
+
+    if "DeepseekV41ForCausalLM" not in ModelRegistry.get_supported_archs():
+        ModelRegistry.register_model(
+            "DeepseekV41ForCausalLM",
+            "vllm_fl.models.deepseek_v41.model:DeepseekV41ForCausalLM",
+        )
+
+
+def register_deepseek_v41_text_processing():
+    """Add the missing tokenizer/renderer pair without replacing native support."""
+    from vllm.renderers.registry import RENDERER_REGISTRY
+    from vllm.tokenizers.registry import TokenizerRegistry
+
+    mode = "deepseek_v41"
+    added = []
+    try:
+        if mode not in TokenizerRegistry.tokenizers:
+            added.append(TokenizerRegistry.tokenizers)
+            TokenizerRegistry.register(
+                mode,
+                "vllm_fl.models.deepseek_v41.tokenizer",
+                "DeepseekV41Tokenizer",
+            )
+        if mode not in RENDERER_REGISTRY.renderers:
+            added.append(RENDERER_REGISTRY.renderers)
+            RENDERER_REGISTRY.register(
+                mode, "vllm.renderers.deepseek_v4", "DeepseekV4Renderer"
+            )
+    except BaseException:
+        for registry in reversed(added):
+            registry.pop(mode, None)
+        raise
