@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Real native allocator views and kernel block-size selection on CPU storage."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.attn_utils import _reshape_attention_kv_cache
+from vllm.v1.worker.utils import prepare_kernel_block_sizes
+
+from vllm_fl.models.deepseek_v41.cache import DeepseekV41Cache, DeepseekV41CacheBackend
+
+
+def _config():
+    return SimpleNamespace(
+        cache_config=SimpleNamespace(block_size=64, cache_dtype="fp8_ds_mla"),
+        compilation_config=SimpleNamespace(static_forward_context={}),
+        parallel_config=SimpleNamespace(
+            decode_context_parallel_size=1, prefill_context_parallel_size=1
+        ),
+    )
+
+
+@pytest.mark.parametrize(
+    "kind,ratio",
+    [("swa", 1), ("compressed", 1), ("compressed", 2), ("index", 1), ("index", 2)],
+)
+def test_real_spec_allocator_padding_binding_and_kernel_blocks(kind, ratio):
+    config = _config()
+    layer = DeepseekV41Cache(
+        config, "model.test.cache", kind=kind, compress_ratio=ratio
+    )
+    spec = layer.get_kv_cache_spec(config)
+    cache_config = SimpleNamespace(
+        kv_cache_groups=[SimpleNamespace(kv_cache_spec=spec)]
+    )
+    groups = [[SimpleNamespace(backend=DeepseekV41CacheBackend)]]
+    # The runner's request block table remains in logical 64-token blocks.
+    assert prepare_kernel_block_sizes(cache_config, groups) == [64]
+    assert spec.storage_block_size == 64 // ratio
+    assert spec.page_size_bytes % 576 == 0
+    shape = DeepseekV41CacheBackend.get_kv_cache_shape(
+        3, spec.storage_block_size, 1, spec.head_size, "fp8_ds_mla"
+    )
+    width = 132 if kind == "index" else 584
+    assert shape == (3, 64 // ratio, width)
+    raw = torch.full((3 * spec.page_size_bytes,), 85, dtype=torch.int8)
+    view = _reshape_attention_kv_cache(raw, spec, shape, (0, 1, 2), 3, None)
+    assert view.dtype == torch.uint8
+    assert view.stride() == (spec.page_size_bytes, width, 1)
+    layer.bind_kv_cache(view)
+    bytes_view = layer.as_page_bytes()
+    assert bytes_view.shape == (3, 64 // ratio * width)
+    assert bytes_view.stride() == (spec.page_size_bytes, 1)
+    assert bytes_view.untyped_storage().data_ptr() == raw.untyped_storage().data_ptr()
+    assert layer.as_attention_cache().shape == (3, 64 // ratio, 1, width)
+    # Changes to content-only views cannot expose or touch another page's pad.
+    bytes_view.fill_(3)
+    pages = raw.view(3, spec.page_size_bytes)
+    assert (pages[:, : 64 // ratio * width] == 3).all()
+    assert (pages[:, 64 // ratio * width :] == 85).all()
+
+
+@pytest.mark.parametrize("bad", ["block", "dtype", "ratio", "kind", "context_parallel"])
+def test_cache_rejects_unsupported_configs_before_context_registration(bad):
+    config = _config()
+    kwargs = dict(kind="compressed", compress_ratio=2)
+    if bad == "block":
+        config.cache_config.block_size = 128
+    elif bad == "dtype":
+        config.cache_config.cache_dtype = "auto"
+    elif bad == "ratio":
+        kwargs["compress_ratio"] = True
+    elif bad == "kind":
+        kwargs["kind"] = "other"
+    else:
+        config.parallel_config.decode_context_parallel_size = 2
+    with pytest.raises((ValueError, NotImplementedError)):
+        DeepseekV41Cache(config, "model.test.cache", **kwargs)
+    assert not config.compilation_config.static_forward_context
+
+
+def test_duplicate_owner_and_binding_shape_rejected():
+    config = _config()
+    layer = DeepseekV41Cache(config, "model.test.cache", kind="index", compress_ratio=2)
+    with pytest.raises(ValueError, match="duplicate"):
+        DeepseekV41Cache(config, "model.test.cache", kind="index", compress_ratio=2)
+    with pytest.raises(ValueError, match="shape"):
+        layer.bind_kv_cache(torch.empty((3, 64, 132), dtype=torch.uint8))
+    assert layer.kv_cache.numel() == 0
