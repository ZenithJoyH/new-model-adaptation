+    assert actual.data_ptr() == output.data_ptr()
+    torch.testing.assert_close(actual.cpu(), _reference(*args), rtol=0, atol=0)
+    for tensor, original in zip(args, before):
+        torch.testing.assert_close(tensor, original, rtol=0, atol=0)
+
