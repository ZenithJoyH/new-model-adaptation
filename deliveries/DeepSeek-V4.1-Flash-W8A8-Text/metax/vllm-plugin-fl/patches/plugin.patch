index 0000000..a3c3217
--- /dev/null
+++ b/vllm_fl/quantization/w8a8_int8.py
@@ -0,0 +1,167 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Symmetric dynamic INT8 checkpoints with per-channel FP32 weight scales."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import torch
+
+from vllm.model_executor.layers.quantization.base_config import QuantizationConfig
+
+if TYPE_CHECKING:
+    from vllm.model_executor.layers.quantization.base_config import QuantizeMethodBase
+    from vllm.model_executor.models.utils import WeightsMapper
+
+_NAME = "fl_w8a8_int8"
+
+
+class DynamicW8A8Int8Config(QuantizationConfig):
+    """Use vLLM's standard W8A8 schemes without ModelSlim offset parameters.
+
+    Metadata lives in the HF config. Layer names are transformed through the
+    model's public weight mapper before construction, as for native configs.
+    """
+
+    def __init__(self, config: dict[str, Any]):
+        if config.get("quant_method") != "w8a8_int8":
+            raise ValueError("Expected quant_method='w8a8_int8'")
+        if config.get("is_dynamic") is not True:
+            raise NotImplementedError("Only dynamic symmetric W8A8 is supported")
+        extra = set(config) - {"quant_method", "is_dynamic", "ignore"}
+        if extra:
+            raise ValueError(f"Unsupported W8A8 metadata fields: {sorted(extra)}")
+        ignored = config.get("ignore", [])
+        if not isinstance(ignored, list) or any(
+            not isinstance(n, str) for n in ignored
+        ):
+            raise ValueError("ignore must be a list of module names")
+        self.ignore = list(ignored)
+        self.packed_modules_mapping = {}
+
+        from compressed_tensors.quantization import (
+            QuantizationArgs,
+            QuantizationStrategy,
+            QuantizationType,
+        )
+
+        self.weight_quant = QuantizationArgs(
+            num_bits=8,
+            type=QuantizationType.INT,
+            strategy=QuantizationStrategy.CHANNEL,
+            symmetric=True,
+            dynamic=False,
+        )
+        self.input_quant = QuantizationArgs(
+            num_bits=8,
+            type=QuantizationType.INT,
+            strategy=QuantizationStrategy.TOKEN,
+            symmetric=True,
+            dynamic=True,
+        )
+
+    @classmethod
+    def get_name(cls) -> str:
+        return _NAME
+
+    @classmethod
+    def get_supported_act_dtypes(cls) -> list[torch.dtype]:
+        return [torch.bfloat16, torch.float16]
+
+    @classmethod
+    def get_min_capability(cls) -> int:
+        return 0
+
+    @classmethod
+    def get_config_filenames(cls) -> list[str]:
+        return []
+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> DynamicW8A8Int8Config:
+        return cls(config)
+
+    @classmethod
+    def override_quantization_method(
+        cls,
+        hf_quant_cfg: dict[str, Any],
+        user_quant: str | None,
+        *,
+        hf_config=None,
+    ) -> str | None:
+        if hf_quant_cfg.get("quant_method") != "w8a8_int8":
+            return None
+        if user_quant not in {None, "w8a8_int8", _NAME}:
+            return None
+        from vllm.model_executor.layers.quantization import QUANTIZATION_METHODS
+
+        # Preserve a future native implementation unless the user selects FL.
+        if "w8a8_int8" in QUANTIZATION_METHODS and user_quant != _NAME:
+            return None
+        return _NAME
+
+    def apply_vllm_mapper(self, hf_to_vllm_mapper: WeightsMapper):
+        self.ignore = hf_to_vllm_mapper.apply_list(self.ignore)
+
+    def get_quant_method(
+        self, layer: torch.nn.Module, prefix: str
+    ) -> QuantizeMethodBase | None:
+        from compressed_tensors.quantization import QuantizationStrategy
+
+        from vllm.model_executor.layers.fused_moe import (
+            RoutedExperts,
+            UnquantizedFusedMoEMethod,
+        )
+        from vllm.model_executor.layers.linear import (
+            LinearBase,
+            UnquantizedLinearMethod,
+        )
+        from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (
+            CompressedTensorsLinearMethod,
+        )
+        from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe.compressed_tensors_moe_w8a8_int8 import (
+            CompressedTensorsW8A8Int8MoEMethod,
+        )
+        from vllm.model_executor.layers.quantization.compressed_tensors.schemes import (
+            CompressedTensorsW8A8Int8,
+        )
+        from vllm.model_executor.layers.quantization.utils.quant_utils import (
+            is_layer_skipped,
+        )
+
+        if isinstance(layer, LinearBase):
+            if is_layer_skipped(prefix, self.ignore, self.packed_modules_mapping):
+                return UnquantizedLinearMethod()
+            layer.scheme = CompressedTensorsW8A8Int8(
+                strategy=QuantizationStrategy.CHANNEL,
+                is_static_input_scheme=False,
+                input_symmetric=True,
+            )
+            return CompressedTensorsLinearMethod(self)  # type: ignore[arg-type]
+        if isinstance(layer, RoutedExperts):
+            if prefix not in self.ignore and any(
+                n.startswith(prefix + ".") for n in self.ignore
+            ):
+                raise NotImplementedError("Per-expert mixed precision is unsupported")
+            if is_layer_skipped(prefix, self.ignore, self.packed_modules_mapping):
+                return UnquantizedFusedMoEMethod(layer.moe_config)
+            return CompressedTensorsW8A8Int8MoEMethod(
+                self.weight_quant,
+                self.input_quant,
+                layer.moe_config,
+                layer_name=prefix,
+            )
+        return None
+
+
+def register_dynamic_w8a8_int8_config() -> None:
+    """Register once, preserving any previously registered implementation."""
+    from vllm.model_executor.layers.quantization import (
+        QUANTIZATION_METHODS,
+        register_quantization_config,
+    )
+
+    if _NAME not in QUANTIZATION_METHODS:
+        register_quantization_config(_NAME)(DynamicW8A8Int8Config)
+
+
+__all__ = ["DynamicW8A8Int8Config", "register_dynamic_w8a8_int8_config"]
