@@ -0,0 +1,199 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Framework weight loading and Linear orchestration for V4.1 projections."""
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.linear import (
+    ColumnParallelLinear,
+    MergedColumnParallelLinear,
+    ReplicatedLinear,
+    UnquantizedLinearMethod,
+)
+from vllm.model_executor.parameter import ModelWeightParameter
+
+from vllm_fl.dispatch import resolve_op
+
+
+def _tracked_loader(layer, name, expected_dtype, original):
+    def load(param, value, *args, **kwargs):
+        if value.dtype != expected_dtype:
+            raise TypeError(f"{name} checkpoint dtype must be {expected_dtype}")
+        expected_shape = (
+            layer.output_size,
+            layer.input_size if name == "weight" else 1,
+        )
+        if tuple(value.shape) != expected_shape:
+            raise ValueError(f"{name} checkpoint shape must be {expected_shape}")
+        original(param, value, *args, **kwargs)
+        layer._loaded.add(name)
+
+    return load
+
+
+class _DequantizedOutputMethod(UnquantizedLinearMethod):
+    def __init__(self):
+        self.dequantize = resolve_op("dequantize_int8_weight")
+
+    def process_weights_after_loading(self, layer):
+        if layer._dequantized:
+            return
+        if layer._loaded != {"weight", "weight_scale"}:
+            raise ValueError("wo_a requires both INT8 weight and FP32 row scales")
+        value = self.dequantize(layer.weight, layer.weight_scale)
+        layer.weight = nn.Parameter(value, requires_grad=False)
+        layer._dequantized = True
+
+    def apply(self, layer, x, bias=None):
+        if not layer._dequantized:
+            raise RuntimeError("wo_a loading has not completed")
+        return super().apply(layer, x, bias)
+
+
+class V41OutputProjection(ColumnParallelLinear):
+    """INT8 checkpoint shard, dequantized once to BF16 before runtime GEMM.
+
+    Native ColumnParallelLinear/ModelWeightParameter retain TP ownership and
+    loading. No activation quantization is applied to this grouped WO_A stage.
+    """
+
+    def __init__(self, input_size, output_size, *, prefix):
+        super().__init__(
+            input_size,
+            output_size,
+            bias=False,
+            params_dtype=torch.bfloat16,
+            quant_config=None,
+            return_bias=False,
+            prefix=prefix,
+        )
+        self._loaded = set()
+        self._dequantized = False
+        self.weight.data = torch.empty(
+            self.weight.shape, dtype=torch.int8, device=self.weight.device
+        )
+        original = self.weight.weight_loader
+        self.weight.weight_loader = _tracked_loader(
+            self, "weight", torch.int8, original
+        )
+        scale = ModelWeightParameter(
+            data=torch.empty(
+                (self.weight.shape[0], 1),
+                dtype=torch.float32,
+                device=self.weight.device,
+            ),
+            input_dim=1,
+            output_dim=0,
+            weight_loader=original,
+        )
+        scale.weight_loader = _tracked_loader(
+            self, "weight_scale", torch.float32, original
+        )
+        self.register_parameter("weight_scale", scale)
+        self.quant_method = _DequantizedOutputMethod()
+
+
+class _FP32ProjectionMethod(UnquantizedLinearMethod):
+    def __init__(self):
+        self.project = resolve_op("bf16_linear_fp32")
+
+    def apply(self, layer, x, bias=None):
+        if bias is not None:
+            raise ValueError("V4.1 FP32 projection does not have bias")
+        original = x.shape
+        result = self.project(
+            x.reshape(-1, original[-1]).contiguous(), layer.weight, layer.unit_scale
+        )
+        return result.reshape(*original[:-1], layer.weight.shape[0])
+
+
+class V41FP32Projection(ReplicatedLinear):
+    """Replicated BF16 weights with an FP32 result for compressor/router scores."""
+
+    def __init__(self, input_size, output_size, *, prefix):
+        super().__init__(
+            input_size,
+            output_size,
+            bias=False,
+            params_dtype=torch.bfloat16,
+            quant_config=None,
+            return_bias=False,
+            prefix=prefix,
+        )
+        self.register_buffer(
+            "unit_scale",
+            torch.ones((1,), dtype=torch.float32, device=self.weight.device),
+            persistent=False,
+        )
+        self.quant_method = _FP32ProjectionMethod()
+
+
+class V41FP32MergedProjection(MergedColumnParallelLinear):
+    """Replicated fused checkpoint slices with FP32 output for KV/score."""
+
+    def __init__(self, input_size, output_sizes, *, prefix):
+        super().__init__(
+            input_size,
+            output_sizes,
+            bias=False,
+            params_dtype=torch.bfloat16,
+            quant_config=None,
+            return_bias=False,
+            disable_tp=True,
+            prefix=prefix,
+        )
+        self.register_buffer(
+            "unit_scale",
+            torch.ones((1,), dtype=torch.float32, device=self.weight.device),
+            persistent=False,
+        )
+        self.quant_method = _FP32ProjectionMethod()
+
+
+class V41ClampedSiluAndMul(nn.Module):
+    """Shared-expert activation on native gate/up halves via uniform dispatch."""
+
+    def __init__(self, limit):
+        super().__init__()
+        self.limit = limit
+        self.activation = resolve_op("silu_and_mul_with_clamp")
+
+    def forward(self, inputs):
+        if inputs.shape[-1] % 2:
+            raise ValueError("shared-expert input must contain equal gate/up halves")
+        half = inputs.shape[-1] // 2
+        return self.activation(inputs[..., :half], inputs[..., half:], self.limit)
+
+
+def enable_v41_fp32_gate(layer):
+    """Retain the native gate object shared by FusedMoEFactory, fix its GEMM.
+
+    MetaX's native GateLinear tier6 otherwise materializes BF16 logits before
+    converting them to FP32. Existing native routing consumes the same module
+    and bias parameters; only its LinearMethod is replaced through the public
+    projection provider before execution.
+    """
+    if (
+        layer.weight.dtype != torch.bfloat16
+        or layer.bias is not None
+        or layer.out_dtype != torch.float32
+    ):
+        raise ValueError("V4.1 gate requires BF16 weight, no bias and FP32 output")
+    specialized = (
+        "allow_ll_bf16_gemm",
+        "allow_dsv3_router_gemm",
+        "allow_fp32_router_gemm",
+        "allow_bf16x3_router_gemm",
+        "allow_cublas_router_gemm",
+    )
+    if any(getattr(layer, flag, False) for flag in specialized):
+        raise NotImplementedError(
+            "V4.1 FP32 gate requires the native general Linear path"
+        )
+    project = _FP32ProjectionMethod()
+    layer.register_buffer(
+        "unit_scale",
+        torch.ones((1,), dtype=torch.float32, device=layer.weight.device),
+        persistent=False,
+    )
+    layer.quant_method = project
