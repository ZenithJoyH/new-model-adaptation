+        monkeypatch.setattr(owner, "get_tensor_model_parallel_world_size", lambda: 8)
+    gen = torch.Generator().manual_seed(6619)
+    k = 64 if sizes == (7, 9) else 5120
+    first = torch.randn((sizes[0], k), generator=gen).bfloat16()
+    second = torch.randn((sizes[1], k), generator=gen).bfloat16()
+    with torch.device("cuda"):
+        layer = module.V41FP32MergedProjection(
+            k, list(sizes), prefix="model.layers.2.attn.compressor.fused_wkv_wgate"
+        )
+    layer.weight.weight_loader(layer.weight, first.cuda(), 0)
+    layer.weight.weight_loader(layer.weight, second.cuda(), 1)
+    expected_weight = torch.cat((first, second))
+    torch.testing.assert_close(layer.weight.cpu(), expected_weight, rtol=0, atol=0)
+    raw = torch.randn((1, k), generator=gen).bfloat16()
+    x = raw.cuda()
+    layer(x)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = layer(x)
+    raw2 = (-raw.float() * 0.75).bfloat16()
+    x.copy_(raw2)
+    actual.fill_(float("nan"))
+    graph.replay()
+    expected = (raw2.double() @ expected_weight.double().T).float()
+    torch.testing.assert_close(actual.cpu(), expected, rtol=3e-4, atol=1e-3)
+    assert actual.dtype == torch.float32 and layer.tp_size == 1
+
