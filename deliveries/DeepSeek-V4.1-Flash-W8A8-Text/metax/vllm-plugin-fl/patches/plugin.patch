+def is_compressor_available():
+    try:
+        import flaggems_vllm
+    except ModuleNotFoundError as error:
+        if error.name != "flaggems_vllm":
+            raise
+        return False
+    implementation = getattr(flaggems_vllm, "deepseek_v41_compress_norm", None)
+    if not callable(implementation):
+        return False
+    try:
+        return _REQUIRED.issubset(inspect.signature(implementation).parameters)
+    except (TypeError, ValueError):
+        return False
+
+
+def deepseek_v41_compress_norm(
+    kv_score,
+    positions,
+    state_cache,
+    slot_mapping,
+    query_start_loc,
+    token_to_req_indices,
+    rms_norm_weight,
+    rms_norm_eps,
+    compress_ratio,
+    latent_out,
+):
+    """FP32 ratio-1/2 raw -> caller BF16 latent, saving caller-owned FP32 ring.
+
+    Ring ownership/reset and request metadata belong to the model. FGV validates
+    numerical storage and performs pooling/norm/state writes. Errors propagate.
+    """
+    from flaggems_vllm import deepseek_v41_compress_norm as implementation
+
+    return implementation(
+        kv_score,
+        positions,
+        state_cache,
+        slot_mapping,
+        query_start_loc,
+        token_to_req_indices,
+        rms_norm_weight,
+        rms_norm_eps,
+        compress_ratio,
+        latent_out,
+    )
