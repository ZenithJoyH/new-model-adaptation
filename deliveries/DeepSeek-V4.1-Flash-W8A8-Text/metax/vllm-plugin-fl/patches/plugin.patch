+def _inputs(kind="chunks", dtype=torch.int32):
+    ids = torch.tensor([2, 9, 3, 10, 20, 4, 99, 99], dtype=dtype)
+    padding = torch.tensor([False] * 6 + [True] * 2)
+    starts = torch.tensor([0, 3, 6], dtype=torch.int32)
+    mapping = torch.tensor([2, 0], dtype=torch.int64)
+    computed = torch.tensor([5, 0, 8], dtype=torch.int32)
+    history = torch.arange(48, dtype=dtype).reshape(3, 16) + 100
+    if kind == "reordered":
+        mapping = mapping.flip(0)
+    elif kind == "initial":
+        computed.zero_()
+    elif kind == "invalid_request":
+        mapping = torch.tensor([-1, 9], dtype=torch.int64)
+    elif kind == "padding_hole":
+        padding[1] = True
+    elif kind == "capacity":
+        computed = torch.tensor([17, 0, 16], dtype=torch.int32)
+    elif kind == "repeated_boundaries":
+        starts = torch.tensor([0, 0, 3, 3, 6], dtype=torch.int32)
+        mapping = torch.tensor([1, 2, 1, 0], dtype=torch.int64)
+    elif kind == "no_requests":
+        starts = torch.tensor([0], dtype=torch.int32)
+        mapping = torch.empty(0, dtype=torch.int64)
+    elif kind == "empty":
+        ids = ids[:0]
+        padding = padding[:0]
+        starts = torch.tensor([0], dtype=torch.int32)
+        mapping = torch.empty(0, dtype=torch.int64)
+    return [x.cuda() for x in (ids, padding, starts, mapping, computed, history)]
+
+
+def _reference(ids, padding, starts, mapping, computed, all_ids):
+    ids, padding, starts, mapping, computed, all_ids = [
+        x.cpu() for x in (ids, padding, starts, mapping, computed, all_ids)
+    ]
+    output = torch.full((len(ids), 4), -1, dtype=torch.int32)
+    for t in range(len(ids)):
+        if padding[t] or t >= starts[-1]:
+            continue
+        req = next(r for r in range(len(mapping)) if starts[r] <= t < starts[r + 1])
+        state = int(mapping[req])
+        if not 0 <= state < len(all_ids):
+            continue
+        relative = t - int(starts[req])
+        for shift in range(4):
+            if relative >= shift:
+                if not padding[t - shift]:
+                    output[t, shift] = ids[t - shift]
+            else:
+                pos = int(computed[state]) + relative - shift
+                if 0 <= pos < all_ids.shape[1]:
+                    output[t, shift] = all_ids[state, pos]
+    return output
+
+
+@pytest.mark.parametrize(
