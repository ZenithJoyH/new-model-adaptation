+# Copyright (c) 2026 BAAI. All rights reserved.
+"""CPU processor/layout tests bound to the verified V4.1 text checkpoint."""
+
+import copy
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from vllm_fl.models.deepseek_v41.engram_metadata import (
+    EngramLayout,
+    build_compressed_token_map,
+)
+
+
+def _config(**updates):
+    values = dict(
+        engram_layer_ids=[1, 14],
+        engram_num_embeddings=[384006168, 384016682],
+        engram_max_ngram_size=4,
+        engram_n_heads=8,
+        engram_head_dim=256,
+        engram_compressed_vocab_size=99092,
+        engram_pad_token_id=2,
+        engram_vocab_size=16000000,
+        num_hidden_layers=40,
+        vocab_size=129280,
+    )
+    values.update(updates)
+    return SimpleNamespace(**values)
+
+
+def test_bucket_counts_match_actual_checkpoint_and_tp8_partitions():
+    config = _config()
+    before = copy.deepcopy(vars(config))
+    layout = EngramLayout(config)
+    assert vars(config) == before
+    all_primes = []
+    for index, expected in enumerate(config.engram_num_embeddings):
+        sizes = [value for order in layout.primes[index] for value in order]
+        assert sum(sizes) == expected
+        assert layout.offsets[index][0] == 0
+        assert [
+            layout.offsets[index][j + 1] - layout.offsets[index][j] for j in range(23)
+        ] == sizes[:-1]
+        shards = [layout.shard(index, 8, rank) for rank in range(8)]
+        assert shards[0].vocab_start == 0 and shards[-1].vocab_end == expected
+        assert all(shard.num_heads == 3 and shard.rows > 0 for shard in shards)
+        assert all(a.vocab_end == b.vocab_start for a, b in zip(shards, shards[1:]))
+        all_primes.extend(sizes)
+    assert len(set(all_primes)) == 48
+
+
+def test_multiplier_bound_and_global_rng_are_preserved():
+    state = np.random.get_state()
+    first = EngramLayout(_config())
+    second = EngramLayout(_config())
+    after = np.random.get_state()
+    assert first.multipliers == second.multipliers
+    assert first.multipliers[0] != first.multipliers[1]
+    assert all(
+        value > 0 and value % 2 and value * 99091 < 2**63
+        for row in first.multipliers
+        for value in row
+    )
+    assert state[0] == after[0] and np.array_equal(state[1], after[1])
+    assert state[2:] == after[2:]
+
+
+def test_token_normalization_and_partial_utf8_tokens():
+    texts = [" The", "THE", "téxt", "text", " ", "", "\ufffd", "\ufffd"]
+
+    class Backend:
+        def decode(self, ids, skip_special_tokens):
+            assert skip_special_tokens is False
+            return texts[ids[0]]
+
+        def id_to_token(self, token):
+            return f"raw-byte-{token}"
+
+    class Tokenizer:
+        backend_tokenizer = Backend()
+
+        def __len__(self):
+            return len(texts)
+
+    mapping, size = build_compressed_token_map(Tokenizer())
+    assert mapping == [0, 0, 1, 1, 2, 3, 4, 5] and size == 6
+
+
+@pytest.mark.parametrize(
+    "updates,error",
+    [
+        ({"engram_max_ngram_size": 3}, NotImplementedError),
+        ({"engram_layer_ids": [1, 1]}, ValueError),
+        ({"engram_layer_ids": [1, 40]}, ValueError),
+        ({"engram_num_embeddings": [1, 2]}, ValueError),
+        ({"engram_compressed_vocab_size": 0}, ValueError),
+    ],
+)
+def test_invalid_layout_fails_before_device_allocation(updates, error):
+    with pytest.raises(error):
+        EngramLayout(_config(**updates))
+
+
+def test_invalid_tp_or_layer_boundary_is_explicit():
+    layout = EngramLayout(_config())
+    for arguments in [(0, 8, 8), (2, 8, 0), (0, 0, 0)]:
+        with pytest.raises(ValueError):
+            layout.shard(*arguments)
+    with pytest.raises(NotImplementedError):
+        layout.shard(0, 16, 0)
