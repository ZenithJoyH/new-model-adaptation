+            target = owner
+            parts = name.split(".")
+            if len(parts) == 2:
+                if not hasattr(target, parts[0]):
+                    target.add_module(parts[0], torch.nn.Module())
+                target = getattr(target, parts[0])
+            param = torch.nn.Parameter(torch.zeros(1), requires_grad=False)
+            target.register_parameter(parts[-1], param)
+            raw = name.replace("embed_tokens.", "embed.").replace(
+                "weight_scale", "scale"
+            )
+            trailing.append((f"layers.{layer}.engram.{raw}", torch.ones(1)))
