@@ -0,0 +1,191 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Real expert adapter -> dispatch -> public FGV, independent CPU INT64 oracle."""
+
+import functools
+from types import SimpleNamespace
+
+import flaggems_vllm as gems
+import pytest
+import torch
+
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.plugins import load_general_plugins
+
+from vllm_fl.quantization.w8a8.moe_experts import FlagGemsW8A8Experts
+
+pytestmark = [pytest.mark.gpu, pytest.mark.functional]
+
+
+def _case(t=3, h=64, i=64, e=4, k=2, bias=False):
+    g = torch.Generator().manual_seed(721)
+    x = torch.randn((t, h), generator=g).bfloat16()
+    if t:
+        x[0].fill_(0.5)
+    w1 = torch.randint(-32, 33, (e, 2 * i, h), generator=g, dtype=torch.int8)
+    w2 = torch.randint(-16, 17, (e, h, i), generator=g, dtype=torch.int8)
+    w1[0].fill_(32)
+    s1 = torch.rand((e, 2 * i, 1), generator=g) / 128 + 1 / 64
+    s1[0].fill_(0.02)
+    s2 = torch.rand((e, h, 1), generator=g) / 256 + 1 / 256
+    ids = (torch.arange(t * k).reshape(t, k) % e).int()
+    routes = torch.rand((t, k), generator=g)
+    routes /= routes.sum(-1, keepdim=True)
+    return dict(
+        x=x,
+        w1=w1,
+        w2=w2,
+        s1=s1,
+        s2=s2,
+        ids=ids,
+        routes=routes,
+        global_e=e,
+        expert_map=None,
+        b1=torch.randn((e, 2 * i), generator=g).bfloat16() if bias else None,
+        b2=torch.randn((e, h), generator=g).bfloat16() if bias else None,
+    )
+
+
+def _quant_cpu(x):
+    x = x.float()
+    maximum = x.abs().amax(-1, keepdim=True)
+    inverse = torch.where(
+        maximum == 0, torch.zeros_like(maximum), torch.div(127.0, maximum)
+    )
+    return (x * inverse).round().clamp(-128, 127).long(), maximum / 127
+
+
+def _reference(c, alpha=1.0, beta=0.0, limit=10.0, input_route=False):
+    x = c["x"]
+    t, h = x.shape
+    if t == 0:
+        return torch.empty((0, h), dtype=torch.bfloat16)
+    q, scale = _quant_cpu(x)
+    w1, w2 = c["w1"].long(), c["w2"].long()
+    outputs = []
+    for token in range(t):
+        parts = []
+        for slot in range(c["ids"].shape[1]):
+            expert = int(c["ids"][token, slot])
+            if c["expert_map"] is not None:
+                expert = int(c["expert_map"][expert])
+            if expert < 0:
+                continue
+            linear = (
+                (q[token : token + 1] @ w1[expert].T).float()
+                * scale[token]
+                * c["s1"][expert, :, 0]
+            )
+            if c["b1"] is not None:
+                linear = linear + c["b1"][expert].float()
+            if input_route:
+                linear = linear * c["routes"][token, slot]
+            gate, up = linear.bfloat16().float().chunk(2, -1)
+            gate = gate.clamp(max=limit)
+            up = up.clamp(-limit, limit)
+            act = (gate * torch.sigmoid(alpha * gate) * (up + beta)).bfloat16()
+            aq, as_ = _quant_cpu(act)
+            down = (aq @ w2[expert].T).float() * as_ * c["s2"][expert, :, 0]
+            if c["b2"] is not None:
+                down = down + c["b2"][expert].float()
+            if not input_route:
+                down = down * c["routes"][token, slot]
+            parts.append(down.bfloat16().float())
+        outputs.append(
+            torch.stack(parts).sum(0).bfloat16()
+            if parts
+            else torch.zeros((1, h), dtype=torch.bfloat16)
+        )
+    return torch.cat(outputs)
+
+
+def _arguments(c):
+    quant = SimpleNamespace(
+        use_int8_w8a8=True,
+        per_act_token_quant=True,
+        block_shape=None,
+        w1_scale=c["s1"].cuda(),
+        w2_scale=c["s2"].cuda(),
+        w1_bias=None,
+        w2_bias=None,
+    )
+    state = SimpleNamespace(
+        quant_config=quant,
+        activation_config=SimpleNamespace(clamp_limit=10.0),
+        _lora_context=None,
+    )
+    args = dict(
+        hidden_states=c["x"].cuda(),
+        w1=c["w1"].cuda(),
+        w2=c["w2"].cuda(),
+        topk_weights=c["routes"].cuda(),
+        topk_ids=c["ids"].cuda(),
+        activation=MoEActivation.SILU,
+        global_num_experts=c["global_e"],
+        expert_map=None,
+        a1q_scale=None,
+        a2_scale=None,
+        workspace13=torch.empty(0, device="cuda"),
+        workspace2=torch.empty(0, device="cuda"),
+        expert_tokens_meta=None,
+        apply_router_weight_on_input=False,
+    )
+    args["output"] = torch.empty_like(args["hidden_states"])
+    return state, args
+
+
+@pytest.mark.parametrize(
+    "shape",
+    [(0, 64, 64, 4, 2), (1, 64, 64, 4, 2), (7, 64, 64, 4, 2), (1, 5120, 288, 8, 6)],
+)
+def test_actual_expert_apply_honors_clamp_and_two_public_quantizations(
+    shape, monkeypatch
+):
+    load_general_plugins()
+    c = _case(*shape)
+    state, args = _arguments(c)
+    hits = []
+    original = gems.scaled_int8_quant
+
+    @functools.wraps(original)
+    def quant(value, *a, **kw):
+        hits.append(value.dtype)
+        return original(value, *a, **kw)
+
+    monkeypatch.setattr(gems, "scaled_int8_quant", quant)
+    FlagGemsW8A8Experts.apply(state, **args)
+    torch.testing.assert_close(
+        args["output"].cpu(), _reference(c), rtol=0.016, atol=0.004
+    )
+    if shape[0]:
+        assert hits == [torch.bfloat16, torch.bfloat16]
+        # Deliberately large gate values must distinguish the old ignored-clamp path.
+        assert not torch.allclose(
+            _reference(c).float(),
+            _reference(c, limit=1e10).float(),
+            rtol=0.016,
+            atol=0.004,
+        )
+
+
+def test_real_adapter_graph_replay_uses_new_inputs_scales_and_routes():
+    load_general_plugins()
+    c = _case(t=7)
+    state, args = _arguments(c)
+    for _ in range(3):
+        FlagGemsW8A8Experts.apply(state, **args)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        FlagGemsW8A8Experts.apply(state, **args)
+    c["x"] = (-c["x"] * 0.75).bfloat16()
+    c["s1"] *= 0.9
+    c["s2"] *= 1.1
+    c["ids"] = c["ids"].roll(1, 1)
+    args["hidden_states"].copy_(c["x"])
+    state.quant_config.w1_scale.copy_(c["s1"])
+    state.quant_config.w2_scale.copy_(c["s2"])
+    args["topk_ids"].copy_(c["ids"])
+    args["output"].fill_(float("nan"))
+    graph.replay()
+    torch.testing.assert_close(
+        args["output"].cpu(), _reference(c), rtol=0.016, atol=0.004
+    )
