+        if isinstance(v, torch.Tensor)
+        and k not in ("state_slots", "token_to_req", "query_output")
+    }
+    prepare_compressor_metadata(**args)
+    for actual, wanted in zip(
+        [args["state_slots"], args["token_to_req"], args["query_output"]], expected
+    ):
+        torch.testing.assert_close(actual.cpu(), wanted, rtol=0, atol=0)
+    for key, value in original.items():
+        torch.testing.assert_close(args[key], value, rtol=0, atol=0)
+
