@@ -0,0 +1,172 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Checkpoint-metadata and factory tests; GPU numerics live in functional tests."""
+
+import copy
+import json
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.linear import ReplicatedLinear, UnquantizedLinearMethod
+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (
+    CompressedTensorsLinearMethod,
+)
+from vllm.model_executor.model_loader.utils import configure_quant_config
+from vllm.model_executor.models.utils import WeightsMapper
+
+from vllm_fl.quantization.w8a8_int8 import DynamicW8A8Int8Config
+
+
+def _config(ignore=()):
+    return DynamicW8A8Int8Config.from_config(
+        {"quant_method": "w8a8_int8", "is_dynamic": True, "ignore": list(ignore)}
+    )
+
+
+def _linear():
+    layer = ReplicatedLinear.__new__(ReplicatedLinear)
+    torch.nn.Module.__init__(layer)
+    return layer
+
+
+def test_metadata_is_dynamic_symmetric_without_input_mutation():
+    raw = {"quant_method": "w8a8_int8", "is_dynamic": True, "ignore": ["model.norm"]}
+    before = copy.deepcopy(raw)
+    config = DynamicW8A8Int8Config.from_config(raw)
+    assert raw == before
+    assert config.weight_quant.num_bits == config.input_quant.num_bits == 8
+    assert config.weight_quant.strategy == "channel"
+    assert config.input_quant.strategy == "token"
+    assert config.weight_quant.symmetric and config.input_quant.symmetric
+    assert config.weight_quant.dynamic is False
+    assert config.input_quant.dynamic is True
+    raw["ignore"].append("changed.after.construction")
+    assert config.ignore == ["model.norm"]
+    assert config.get_config_filenames() == []
+
+
+@pytest.mark.parametrize(
+    "updates,error",
+    [
+        ({"quant_method": "fp8"}, ValueError),
+        ({"is_dynamic": False}, NotImplementedError),
+        ({"is_dynamic": 1}, NotImplementedError),
+        ({"ignore": None}, ValueError),
+        ({"ignore": [1]}, ValueError),
+        ({"zero_point": 1}, ValueError),
+    ],
+)
+def test_rejects_unverified_formats(updates, error):
+    raw = {"quant_method": "w8a8_int8", "is_dynamic": True, "ignore": []}
+    raw.update(updates)
+    with pytest.raises(error):
+        DynamicW8A8Int8Config.from_config(raw)
+
+
+def test_real_mapper_is_applied_before_packed_layer_selection():
+    ignored = [
+        "model.layers.2.self_attn.compressor.wkv",
+        "model.layers.2.self_attn.compressor.wgate",
+    ]
+    config = _config(ignored)
+
+    class Model(torch.nn.Module):
+        hf_to_vllm_mapper = WeightsMapper(
+            orig_to_new_substr={".self_attn.": ".attn."},
+            orig_to_new_stacked={".compressor.wkv": (".compressor.fused_wkv_wgate", 0)},
+        )
+        packed_modules_mapping = {"fused_wkv_wgate": ["wkv", "wgate"]}
+
+    configure_quant_config(config, Model)
+    assert config.packed_modules_mapping is Model.packed_modules_mapping
+    assert config.ignore == [s.replace(".self_attn.", ".attn.") for s in ignored]
+    prefix = "model.layers.2.attn.compressor.fused_wkv_wgate"
+    assert isinstance(
+        config.get_quant_method(_linear(), prefix), UnquantizedLinearMethod
+    )
+    config.ignore.pop()
+    with pytest.raises(ValueError, match="some but not all shards"):
+        config.get_quant_method(_linear(), prefix)
+
+
+def test_linear_scheme_and_exact_name_boundary():
+    config = _config(["model.layers.2.attn.wq_a"])
+    assert isinstance(
+        config.get_quant_method(_linear(), "model.layers.2.attn.wq_a"),
+        UnquantizedLinearMethod,
+    )
+    layer = _linear()
+    method = config.get_quant_method(layer, "model.layers.2.attn.wq_a_extra")
+    assert isinstance(method, CompressedTensorsLinearMethod)
+    assert layer.scheme.strategy == "channel"
+    assert layer.scheme.input_symmetric is True
+    assert layer.scheme.is_static_input_scheme is False
+    assert config.get_quant_method(torch.nn.Identity(), "model.norm") is None
+
+
+def test_moe_factory_receives_standard_quant_args(monkeypatch):
+    from vllm.model_executor.layers.fused_moe import RoutedExperts
+    from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe import (
+        compressed_tensors_moe_w8a8_int8 as native,
+    )
+
+    layer = RoutedExperts.__new__(RoutedExperts)
+    torch.nn.Module.__init__(layer)
+    layer.moe_config = SimpleNamespace(marker="metadata-only")
+    seen = []
+    sentinel = object()
+
+    def construct(*args, **kwargs):
+        seen.append((args, kwargs))
+        return sentinel
+
+    monkeypatch.setattr(native, "CompressedTensorsW8A8Int8MoEMethod", construct)
+    config = _config()
+    prefix = "model.layers.0.ffn.experts"
+    assert config.get_quant_method(layer, prefix) is sentinel
+    assert seen == [
+        (
+            (config.weight_quant, config.input_quant, layer.moe_config),
+            {"layer_name": prefix},
+        )
+    ]
+    mixed = _config([prefix + ".0.w1"])
+    with pytest.raises(NotImplementedError, match="Per-expert"):
+        mixed.get_quant_method(layer, prefix)
+
+
+def test_override_preserves_other_formats_user_choice_and_native_support(monkeypatch):
+    from vllm.model_executor.layers import quantization as registry
+
+    monkeypatch.setattr(registry, "QUANTIZATION_METHODS", ["compressed-tensors"])
+    target = {"quant_method": "w8a8_int8", "is_dynamic": True}
+    cls = DynamicW8A8Int8Config
+    assert cls.override_quantization_method(target, None) == "fl_w8a8_int8"
+    assert cls.override_quantization_method(target, "gptq") is None
+    assert cls.override_quantization_method({"quant_method": "fp8"}, None) is None
+    registry.QUANTIZATION_METHODS.append("w8a8_int8")
+    assert cls.override_quantization_method(target, None) is None
+    assert cls.override_quantization_method(target, "fl_w8a8_int8") == "fl_w8a8_int8"
+
+
+def test_fresh_general_plugin_registers_alias_once():
+    script = """
+import json
+from vllm.plugins import load_general_plugins
+load_general_plugins()
+from vllm.model_executor.layers.quantization import QUANTIZATION_METHODS, get_quantization_config
+from vllm_fl.quantization.w8a8_int8 import DynamicW8A8Int8Config, register_dynamic_w8a8_int8_config
+register_dynamic_w8a8_int8_config()
+register_dynamic_w8a8_int8_config()
+assert get_quantization_config('fl_w8a8_int8') is DynamicW8A8Int8Config
+assert QUANTIZATION_METHODS.count('fl_w8a8_int8') == 1
+print(json.dumps({'registered': True}))
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True, timeout=90
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert json.loads(result.stdout.strip().splitlines()[-1]) == {"registered": True}
