+def test_metadata_graph_replay_updates_requests_tokens_history_and_padding():
+    args = _inputs("repeated_boundaries")
+    output = torch.empty((len(args[0]), 4), device="cuda", dtype=torch.int32)
+    for _ in range(3):
+        module.prepare_engram_history(*args, len(args[3]), output)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        module.prepare_engram_history(*args, len(args[3]), output)
+    for step in (1, 2):
+        args[0].add_(step)
+        args[3].copy_(torch.tensor([0, 0, 1, 2], device="cuda"))
+        args[4].add_(step)
+        args[5].add_(100)
+        args[1][1] = step == 1
+        output.fill_(-999)
+        graph.replay()
+        torch.cuda.synchronize()
