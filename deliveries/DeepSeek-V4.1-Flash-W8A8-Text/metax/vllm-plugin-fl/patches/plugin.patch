+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Copyright (c) 2026 BAAI. All rights reserved.
+"""V4.1 text prompt contracts, adapted from vLLM e77daef89e18 tests.
+
+Golden effort values follow this checkpoint's reference encoder, rather than
+V4's prose prompts or the older upstream V4.1 budget mapping.
+"""
+
+import copy
+
+import pytest
+
+from vllm_fl.models.deepseek_v41 import register_deepseek_v41_text_processing
+from vllm_fl.models.deepseek_v41.tokenizer import get_deepseek_v41_tokenizer
+
+
+class RecordingTokenizer:
+    def get_added_vocab(self):
+        return {"<｜User｜>": 128803}
+
+    def encode(self, text, add_special_tokens=True, **kwargs):
+        self.last_encode = text, add_special_tokens, kwargs
+        return [0, 128803]
+
+
+def render(messages, **kwargs):
+    return get_deepseek_v41_tokenizer(RecordingTokenizer()).apply_chat_template(
+        messages, tokenize=False, **kwargs
+    )
+
+
+@pytest.mark.parametrize(
+    ("effort", "budget"),
+    [(None, 75), ("low", 50), ("high", 75), ("max", 100), (1, 1), (42, 42), (100, 100)],
+)
+def test_reference_numeric_effort(effort, budget):
+    assert render(
+        [{"role": "user", "content": "question"}], reasoning_effort=effort
+    ) == (
+        "<｜begin▁of▁sentence｜><｜System｜>"
+        f"Reasoning Effort: {budget} (range 1-100, the higher the value, "
+        "the more thorough the reasoning)\n\n"
+        "<｜User｜>question<｜Assistant｜><think>"
+    )
+
+
+@pytest.mark.parametrize(
+    "effort", ["medium", "xhigh", "minimal", -1, 0, 101, True, 1.5, []]
+)
+def test_invalid_effort_rejected(effort):
+    with pytest.raises(ValueError, match="reasoning_effort"):
+        render([{"role": "user", "content": "question"}], reasoning_effort=effort)
+
+
+@pytest.mark.parametrize(
+    "controls",
+    [
+        {"thinking": False},
+        {"enable_thinking": False},
+        {"thinking": True, "reasoning_effort": "none"},
+        {"enable_thinking": True, "reasoning_effort": "none"},
+    ],
+)
+def test_chat_prefix(controls):
+    assert render([{"role": "user", "content": "question"}], **controls) == (
+        "<｜begin▁of▁sentence｜><｜User｜>question<｜Assistant｜></think>"
+    )
+
+
+def test_original_text_parts_and_input_immutability():
+    messages = [
+        {
+            "role": "user",
+            "content": [
+                {"type": "text", "text": "first"},
+                {"type": "text", "text": "second"},
+            ],
+        }
+    ]
+    original = copy.deepcopy(messages)
+    assert render(
+        messages,
+        conversation=[{"role": "user", "content": "first\nsecond"}],
+        thinking=False,
+    ) == ("<｜begin▁of▁sentence｜><｜User｜>first\n\nsecond<｜Assistant｜></think>")
+    assert messages == original
+
+
+def test_mid_system_and_previous_reasoning():
+    messages = [
+        {"role": "user", "content": "old"},
+        {"role": "assistant", "content": "answer", "reasoning": "private-old"},
+        {"role": "system", "content": "brief"},
+    ]
+    text = render(messages, thinking=False)
+    assert (
+        text
+        == "<｜begin▁of▁sentence｜><｜User｜>old<｜Assistant｜></think>answer<｜end▁of▁sentence｜><｜System｜>brief<｜Assistant｜></think>"
+    )
+    assert "private-old" not in render(messages)
+
+
+def test_encode_forwards_truncation_without_adding_bos():
+    tokenizer = get_deepseek_v41_tokenizer(RecordingTokenizer())
+    assert tokenizer.apply_chat_template(
+        [{"role": "user", "content": "question"}],
+        thinking=False,
+        truncation=True,
+        max_length=16,
+    ) == [0, 128803]
+    text, special, kwargs = tokenizer.last_encode
+    assert (
+        text.startswith("<｜begin▁of▁sentence｜>")
+        and text.count("<｜begin▁of▁sentence｜>") == 1
+    )
+    assert special is False and kwargs == {"truncation": True, "max_length": 16}
+    vocab = tokenizer.get_added_vocab()
+    vocab.clear()
+    assert tokenizer.get_added_vocab() == {"<｜User｜>": 128803}
+
+
+@pytest.mark.parametrize(
+    "kind", ["image_url", "input_image", "image_pil", "input_audio"]
+)
+def test_non_text_content_rejected(kind):
+    with pytest.raises(ValueError, match="text content only"):
+        render([{"role": "user", "content": [{"type": kind}]}])
+
+
+@pytest.mark.parametrize(
+    "messages,tools",
+    [
+        ([{"role": "tool", "content": "result"}], None),
+        ([{"role": "assistant", "tool_calls": [{}]}], None),
+        ([{"role": "user", "content": "question"}], [{"type": "function"}]),
+    ],
+)
+def test_tool_calling_boundary(messages, tools):
+    with pytest.raises(ValueError, match="tool calling is not supported"):
+        render(messages, tools=tools)
+
+
+def test_native_request_effort_priority():
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+
+    req = ChatCompletionRequest(
+        model="v41",
+        messages=[{"role": "user", "content": "question"}],
+        reasoning_effort="low",
+        chat_template_kwargs={"reasoning_effort": 100},
+    )
+    kwargs = req.build_chat_params(None, "auto").get_apply_chat_template_kwargs()
+    assert "Reasoning Effort: 50 " in render(req.messages, **kwargs)
+
+
+def test_registration_is_idempotent_and_preserves_native(monkeypatch):
+    from vllm.renderers.registry import RENDERER_REGISTRY
+    from vllm.tokenizers.registry import TokenizerRegistry
+
+    mode = "deepseek_v41"
+    for registry in [TokenizerRegistry.tokenizers, RENDERER_REGISTRY.renderers]:
+        monkeypatch.delitem(registry, mode, raising=False)
+    register_deepseek_v41_text_processing()
+    expected = TokenizerRegistry.tokenizers[mode], RENDERER_REGISTRY.renderers[mode]
+    register_deepseek_v41_text_processing()
+    assert expected == (
+        TokenizerRegistry.tokenizers[mode],
+        RENDERER_REGISTRY.renderers[mode],
+    )
+    native = ("native.tokenizer", "Native")
+    monkeypatch.setitem(TokenizerRegistry.tokenizers, mode, native)
+    register_deepseek_v41_text_processing()
+    assert TokenizerRegistry.tokenizers[mode] == native
+
+
+def test_failed_registration_rolls_back_both_entries(monkeypatch):
+    from vllm.renderers.registry import RENDERER_REGISTRY
+    from vllm.tokenizers.registry import TokenizerRegistry
+
+    mode = "deepseek_v41"
+    for registry in [TokenizerRegistry.tokenizers, RENDERER_REGISTRY.renderers]:
+        monkeypatch.delitem(registry, mode, raising=False)
+    original = RENDERER_REGISTRY.register
+
+    def broken(*args, **kwargs):
+        original(*args, **kwargs)
+        raise RuntimeError("registration failure after mutation")
+
+    monkeypatch.setattr(RENDERER_REGISTRY, "register", broken)
+    with pytest.raises(RuntimeError, match="registration failure"):
+        register_deepseek_v41_text_processing()
+    assert (
+        mode not in TokenizerRegistry.tokenizers
+        and mode not in RENDERER_REGISTRY.renderers
+    )
+
+
+@pytest.mark.parametrize("role", ["developer", "unknown"])
+def test_reference_unsupported_roles_rejected(role):
+    with pytest.raises(ValueError, match="Unsupported V4.1 text role"):
+        render([{"role": role, "content": "question"}])
