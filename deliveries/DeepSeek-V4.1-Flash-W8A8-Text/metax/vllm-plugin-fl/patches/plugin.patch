+def test_scaled_mm_adapter_forwards_public_api_and_empty_batch(monkeypatch):
+    import flaggems_vllm
+
+    from vllm_fl.dispatch.backends.flaggems.impl.w8a8_linear import w8a8_scaled_mm
+
+    a = torch.ones((2, 4), dtype=torch.int8)
+    b = torch.ones((4, 3), dtype=torch.int8)
+    sa = torch.ones((2, 1), dtype=torch.float32)
+    sb = torch.ones(3, dtype=torch.float32)
+    bias = torch.ones(3, dtype=torch.bfloat16)
+    calls = []
+    expected = torch.empty((2, 3), dtype=torch.bfloat16)
+
+    def public_api(*args, **kwargs):
+        calls.append((args, kwargs))
+        return expected
+
+    monkeypatch.setattr(flaggems_vllm, "triton_scaled_mm", public_api)
+    assert w8a8_scaled_mm(a, b, sa, sb, out_dtype=torch.bfloat16, bias=bias) is expected
+    assert len(calls) == 1
+    assert all(actual is wanted for actual, wanted in zip(calls[0][0], (a, b, sa, sb)))
+    assert calls[0][1] == {"out_dtype": torch.bfloat16, "bias": bias}
+    empty = w8a8_scaled_mm(a[:0], b, sa[:0], sb, out_dtype=torch.bfloat16)
+    assert empty.shape == (0, 3) and empty.dtype == torch.bfloat16
+    assert len(calls) == 1
+
