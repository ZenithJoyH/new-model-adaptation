+# Copyright (c) 2026 BAAI. All rights reserved.
+"""Checkpoint namespace/coverage tests independent of GPU allocation."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm_fl.models.deepseek_v41 import weights as module
+
+
+@pytest.mark.parametrize(
+    "original,expected",
+    [
+        ("layers.2.attn.wq_a.scale", "model.layers.2.attn.wq_a.weight_scale"),
+        ("layers.1.engram.embed.weight", "model.layers.1.engram.embed_tokens.weight"),
+        (
+            "layers.1.engram.embed.scale",
+            "model.layers.1.engram.embed_tokens.weight_scale",
+        ),
+        ("layers.1.engram.wkv.scale", "model.layers.1.engram.wkv.weight_scale"),
+        (
+            "layers.0.ffn.shared_experts.w2.scale",
+            "model.layers.0.ffn.shared_experts.down_proj.weight_scale",
+        ),
+        ("layers.0.ffn.gate.bias", "model.layers.0.ffn.gate.e_score_correction_bias"),
+        ("head.weight", "lm_head.weight"),
+        ("embed.weight", "model.embed_tokens.weight"),
+        ("norm.weight", "model.norm.weight"),
+        ("layers.0.ffn.gate.bias_vl", None),
+        ("vision.layers.0.weight", None),
+        ("aligner.weight", None),
+        ("image_norm.weight", None),
+        ("mtp.layers.0.weight", None),
+    ],
+)
+def test_exact_raw_checkpoint_namespace(original, expected):
+    item = torch.empty(0)
+    mapped = list(module.WEIGHTS_MAPPER.apply([(original, item)]))
+    assert mapped == ([] if expected is None else [(expected, item)])
+
+
+@pytest.fixture
+def fixture_model(monkeypatch):
+    params = {}
+
+    def plain(name, shape):
+        p = torch.nn.Parameter(torch.zeros(shape), requires_grad=False)
+        p.weight_loader = lambda target, value: target.data.copy_(value)
+        params[name] = p
+        return p
+
+    p = plain("layers.0.attn.fused_wqa_wkv.weight", (2,))
+
+    def fused(param, value, shard):
+        param.data[shard : shard + 1].copy_(value)
+
+    p.weight_loader = fused
+    plain("layers.0.attn.attn_sink", (64,)).data.fill_(-float("inf"))
+    p = plain("layers.0.ffn.experts.w13_weight", (2, 2))
+
+    def expert13(param, value, name, *, shard_id, expert_id, return_success):
+        assert return_success
+        param.data[expert_id, 0 if shard_id == "w1" else 1] = value[0]
+        return True
+
+    p.weight_loader = expert13
+    p = plain("layers.0.ffn.experts.w2_weight", (2,))
+
+    def expert2(param, value, name, *, shard_id, expert_id, return_success):
+        assert return_success and shard_id == "w2"
+        param.data[expert_id] = value[0]
+        return True
+
+    p.weight_loader = expert2
+    model = SimpleNamespace(
+        config=SimpleNamespace(
+            num_attention_heads=64, n_routed_experts=2, compress_ratios=[2]
+        ),
+        named_parameters=lambda: params.items(),
+    )
+    mapping = []
+    for expert in range(2):
+        for shard in ("w1", "w3", "w2"):
+            target = "ffn.experts.w13_" if shard != "w2" else "ffn.experts.w2_"
+            mapping.append((target, f"ffn.experts.{expert}.{shard}.", expert, shard))
+    monkeypatch.setattr(module, "expert_mapping", lambda model: mapping)
+    monkeypatch.setattr(module, "get_tensor_model_parallel_rank", lambda: 7)
+    monkeypatch.setattr(module, "get_tensor_model_parallel_world_size", lambda: 8)
+    monkeypatch.setattr(
+        module,
+        "is_pp_missing_parameter",
+        lambda name, model: name.startswith("layers.20."),
+    )
+    items = [
+        ("layers.0.attn.wq_a.weight", torch.tensor([1.0])),
+        ("layers.0.attn.wkv.weight", torch.tensor([2.0])),
+        ("layers.0.attn.attn_sink", torch.arange(64).float()),
+    ]
+    for e in range(2):
+        for i, shard in enumerate(("w1", "w3", "w2")):
+            items.append(
+                (
+                    f"layers.0.ffn.experts.{e}.{shard}.weight",
+                    torch.tensor([float(e * 3 + i + 3)]),
+                )
+            )
+    return model, params, items
+
+
+def test_complete_local_fusion_experts_and_sink_shard(fixture_model):
+    model, params, items = fixture_model
+    loaded = module.load_text_model_weights(model, iter(items))
+    assert loaded == set(params)
+    torch.testing.assert_close(
+        params["layers.0.attn.fused_wqa_wkv.weight"], torch.tensor([1.0, 2.0])
+    )
+    torch.testing.assert_close(
+        params["layers.0.ffn.experts.w13_weight"],
+        torch.tensor([[3.0, 4.0], [6.0, 7.0]]),
+    )
+    torch.testing.assert_close(
+        params["layers.0.ffn.experts.w2_weight"], torch.tensor([5.0, 8.0])
+    )
+    sink = params["layers.0.attn.attn_sink"]
+    torch.testing.assert_close(sink[:8], torch.arange(56, 64).float())
+    assert torch.isneginf(sink[8:]).all()
+
+
+@pytest.mark.parametrize(
+    "failure",
+    [
+        "missing_expert",
+        "missing_fused",
+        "missing_param",
+        "duplicate",
+        "unknown",
+        "sink_shape",
+    ],
+)
+def test_incomplete_or_unknown_text_checkpoint_rejected(fixture_model, failure):
+    model, params, items = fixture_model
+    if failure == "missing_expert":
+        items = [x for x in items if x[0] != "layers.0.ffn.experts.1.w3.weight"]
+    elif failure == "missing_fused":
+        items = [x for x in items if x[0] != "layers.0.attn.wkv.weight"]
+    elif failure == "missing_param":
+        items = [x for x in items if x[0] != "layers.0.attn.attn_sink"]
+    elif failure == "duplicate":
+        items.append(items[0])
+    elif failure == "unknown":
+        items.append(("layers.0.unknown.weight", torch.zeros(1)))
+    elif failure == "sink_shape":
+        items = [
+            (k, torch.zeros(8) if k.endswith("attn_sink") else v) for k, v in items
+        ]
+    with pytest.raises((ValueError, KeyError)):
+        module.load_text_model_weights(model, iter(items))
+
+
+def test_other_pp_stage_weights_are_skipped(fixture_model):
+    model, params, items = fixture_model
+    loaded = module.load_text_model_weights(
+        model, iter(items + [("layers.20.unknown.weight", torch.zeros(1))])
+    )
+    assert loaded == set(params)
+
+
+def test_model_class_import_preserves_lightweight_metadata():
+    from vllm_fl.models.deepseek_v41.model import DeepseekV41ForCausalLM
+    from vllm_fl.models.deepseek_v41.model_state import DeepseekV41ModelState
+
+    assert DeepseekV41ForCausalLM.supports_pp
+    assert DeepseekV41ForCausalLM.get_model_state_cls() is DeepseekV41ModelState
+    assert DeepseekV41ForCausalLM.hf_to_vllm_mapper is module.WEIGHTS_MAPPER
+
+
+@pytest.mark.parametrize("native_exists", [False, True])
+def test_lazy_registration_is_idempotent_and_preserves_native(
+    monkeypatch, native_exists
+):
+    import sys
+
+    from vllm.model_executor import models
+
+    from vllm_fl.models.deepseek_v41 import register_deepseek_v41_model
+
